---
import RoadmapPage from '../../components/RoadmapPage.astro';
import {journey} from '../../data/journey';
import Learning from '../../components/Learning.astro';
import {learningPaths,lessons} from '../../data/learning';
import ToolSelection from '../../components/ToolSelection.astro';
import Shell from '../../layouts/Shell.astro';
import PracticeGuide from '../../components/PracticeGuide.astro';
import {practices} from '../../data/practice';
import Terms from '../../components/Terms.astro';
import ActionGuide from '../../components/ActionGuide.astro';
import {guides} from '../../data/action-guides';
import Dictionary from '../../components/Dictionary.astro';
import dictionary from '../../data/dictionary.json';
import StackGuide from '../../components/StackGuide.astro';
import Communication from '../../components/Communication.astro';
import Home from '../../components/Home.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import {locales,projects,t,type Locale} from '../../data/site';
export function getStaticPaths(){return locales.flatMap(locale=>['roadmap',...journey.map(s=>`roadmap/${s.id}`),...learningPaths,'','tools','start','communicate','stacks','components','terms',...practices.map(p=>p.path),...guides.map(g=>g.path),...dictionary.entries.map(e=>`components/${e.id}`),...projects.map(p=>`projects/${p.id}`)].map(path=>({params:{locale,page:path||undefined},props:{locale,path}})));}
const {locale,path}=Astro.props as {locale:Locale;path:string};
const project=projects.find(p=>path===`projects/${p.id}`);
const guide=guides.find(g=>g.path===path);
const practice=practices.find(p=>p.path===path);
const currentLesson=lessons.find(l=>l.id===path.split('/')[1]);
const title=path==='library'?t(['资料库','Resource library'],locale):path.startsWith('roadmap')?t(journey.find(s=>s.id===path.split('/')[1])?.title??['完整路线图','Complete roadmap'],locale):learningPaths.includes(path)?t(currentLesson?.issues.find(i=>i.id===path.split('/')[3])?.title??currentLesson?.title??['学习路线','Learning route'],locale):path==='tools'?t(['选择工具','Choose a tool'],locale):practice?t(practice.title,locale):path==='terms'?t(['白话术语','Plain-language glossary'],locale):guide?t(guide.title,locale):path.startsWith('components')?t(['前端与 UI','Frontend & UI'],locale):path==='stacks'?t(['技术栈选择','Choosing a stack'],locale):path==='communicate'?t(['和 Agent 沟通','Talking to agents'],locale):project?t(project.title,locale):path==='start'?t(['项目分类','Project types'],locale):t(['零基础，也能把想法做出来','Build the idea, no coding experience needed'],locale);
---
<Shell locale={locale} path={path} title={title}>{path.startsWith('roadmap')?<RoadmapPage locale={locale} path={path}/>:learningPaths.includes(path)?<Learning locale={locale} path={path}/>:path==='tools'?<ToolSelection locale={locale}/>:practice?<PracticeGuide locale={locale} practice={practice}/>:path==='terms'?<Terms locale={locale}/>:guide?<ActionGuide locale={locale} guide={guide}/>:path.startsWith('components')?<Dictionary locale={locale} entryId={path.split('/')[1]}/>:path==='stacks'?<StackGuide locale={locale}/>:path==='communicate'?<Communication locale={locale}/>:project?<ProjectDetail locale={locale} project={project}/>:path==='start'?<ProjectIndex locale={locale}/>:<Home locale={locale}/>}</Shell>
