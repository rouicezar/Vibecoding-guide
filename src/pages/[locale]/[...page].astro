---
import Explore from '../../components/Explore.astro';
import {explorePaths,ideas as exploreIdeas,report as exploreReport} from '../../data/explore';
import RoadmapPage from '../../components/RoadmapPage.astro';
import NodePage from '../../components/NodePage.astro';
import {routeNodes,nodeById,nodeForStep,stepUrl} from '../../data/nodes';
import {journey} from '../../data/journey';
import Learning from '../../components/Learning.astro';
import {learningPaths,lessons,legacyLessons} from '../../data/learning';
import ToolSelection from '../../components/ToolSelection.astro';
import Shell from '../../layouts/Shell.astro';
import PracticeGuide from '../../components/PracticeGuide.astro';
import {practices} from '../../data/practice';
import Terms from '../../components/Terms.astro';
import TermDetail from '../../components/TermDetail.astro';
import {glossary,glossaryPaths} from '../../data/glossary';
import ActionGuide from '../../components/ActionGuide.astro';
import {guides} from '../../data/action-guides';
import Dictionary from '../../components/Dictionary.astro';
import dictionary from '../../data/dictionary.json';
import StackGuide from '../../components/StackGuide.astro';
import Communication from '../../components/Communication.astro';
import Home from '../../components/Home.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import {locales,projects,t,url,type Locale} from '../../data/site';
export function getStaticPaths(){return locales.flatMap(locale=>[...explorePaths,'roadmap',...routeNodes.map(n=>`node/${n.id}`),...journey.map(s=>`roadmap/${s.id}`),...learningPaths,'','tools','start','communicate','stacks','components','terms',...glossaryPaths,...practices.map(p=>p.path),...guides.map(g=>g.path),...dictionary.entries.map(e=>`components/${e.id}`),...projects.map(p=>`projects/${p.id}`)].map(path=>({params:{locale,page:path||undefined},props:{locale,path}})));}
const {locale,path}=Astro.props as {locale:Locale;path:string};
const project=projects.find(p=>path===`projects/${p.id}`);
const guide=guides.find(g=>g.path===path);
const practice=practices.find(p=>p.path===path);
const currentTerm=glossary.find(term=>path===`terms/${term.id}`);
const currentLesson=lessons.find(l=>l.id===path.split('/')[1]);
const currentNode=path.startsWith('node/')?nodeById(path.split('/')[1]):undefined;
/* 旧的学习页面不再单独存在：全部跳到对应的节点页锚点。
   /library 是资料库，保留原页面。 */
const learningRedirect=path==='learn'?url(locale,'roadmap'):path.startsWith('learn/stage/')?(()=>{const first=routeNodes.find(n=>n.phaseId===path.split('/')[2]);return first?url(locale,`node/${first.id}`):url(locale,'roadmap');})():path.startsWith('learn/')&&currentLesson?`${url(locale,`node/${nodeForStep(currentLesson.id)}`)}#${currentLesson.id}`:undefined;
if(learningRedirect)return Astro.redirect(learningRedirect,301);
const oldStage=path.startsWith('roadmap/')?legacyLessons[path.split('/')[1]]:undefined;
if(oldStage)return Astro.redirect(stepUrl(locale,oldStage),301);
const title=currentNode?t(currentNode.title,locale):path.startsWith('explore')?(exploreIdeas.find(i=>path===`explore/ideas/${i.id}`)?.title??exploreReport.chapters.find(c=>path===`explore/report/${c.id}`)?.title??t(['大家在做什么','What people are building'],locale)):currentTerm?t(currentTerm.name,locale):path==='library'?t(['资料库','Resource library'],locale):path.startsWith('roadmap')?t(journey.find(s=>s.id===path.split('/')[1])?.title??['完整路线图','Complete roadmap'],locale):learningPaths.includes(path)?t(currentLesson?.issues.find(i=>i.id===path.split('/')[3])?.title??currentLesson?.title??['学习路线','Learning route'],locale):path==='tools'?t(['选择工具','Choose a tool'],locale):practice?t(practice.title,locale):path==='terms'?t(['白话术语','Plain-language glossary'],locale):guide?t(guide.title,locale):path.startsWith('components')?t(['前端与 UI','Frontend & UI'],locale):path==='stacks'?t(['技术栈选择','Choosing a stack'],locale):path==='communicate'?t(['和 Agent 沟通','Talking to agents'],locale):project?t(project.title,locale):path==='start'?t(['项目分类','Project types'],locale):t(['零基础，也能把想法做出来','Build the idea, no coding experience needed'],locale);
---
<Shell locale={locale} path={path} title={title}>{currentNode?<NodePage locale={locale} node={currentNode}/>:path.startsWith('explore')?<Explore locale={locale} path={path}/>:path.startsWith('roadmap')?<RoadmapPage locale={locale}/>:learningPaths.includes(path)?<Learning locale={locale}/>:path==='tools'?<ToolSelection locale={locale}/>:practice?<PracticeGuide locale={locale} practice={practice}/>:currentTerm?<TermDetail locale={locale} id={currentTerm.id}/>:path==='terms'?<Terms locale={locale}/>:guide?<ActionGuide locale={locale} guide={guide}/>:path.startsWith('components')?<Dictionary locale={locale} entryId={path.split('/')[1]}/>:path==='stacks'?<StackGuide locale={locale}/>:path==='communicate'?<Communication locale={locale}/>:project?<ProjectDetail locale={locale} project={project}/>:path==='start'?<ProjectIndex locale={locale}/>:<Home locale={locale}/>}</Shell>
