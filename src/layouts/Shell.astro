---
import '../styles/global.css';
import {lessons,lessonPath} from '../data/learning';
import '../styles/refinement.css';
import '../styles/interaction.css';
import {t,url,projects,type Locale} from '../data/site';
import Icon from '../components/Icon.astro';
import {guides} from '../data/action-guides';
import JourneyContext from '../components/JourneyContext.astro';
import {practices} from '../data/practice';
import Navigation from '../components/Navigation.astro';
interface Props {locale:Locale;path:string;title:string;}
const {locale,path,title}=Astro.props;
const searchEntries=[{path:'roadmap',title:t(['完整路线图 · 从想法到上线','Complete roadmap · idea to release'],locale)},...lessons.flatMap(l=>[{path:lessonPath(l.id),title:t(l.title,locale)},...l.issues.map(i=>({path:`${lessonPath(l.id)}/help/${i.id}`,title:t(i.title,locale)}))]),{path:'tools',title:t(['选择工具 · Codex Claude Cursor Qoder TRAE Kimi 价格','Choose a tool · Codex Claude Cursor Qoder TRAE Kimi pricing'],locale)},{path:'',title:t(['首页','Home'],locale)},{path:'start',title:t(['项目分类','Project types'],locale)},{path:'communicate',title:t(['和 Agent 沟通 · 提示词与排查','Talking to agents · prompts and troubleshooting'],locale)},{path:'stacks',title:t(['技术栈选择','Choosing a stack'],locale)},{path:'components',title:t(['前端与 UI · 组件词典','Frontend & UI · component dictionary'],locale)},{path:'terms',title:t(['白话术语 · 30个常见词','Plain-language glossary · 30 terms'],locale)},...practices.map(p=>({path:p.path,title:t(p.title,locale)})),...guides.map(g=>({path:g.path,title:t(g.title,locale)})),...projects.map(p=>({path:`projects/${p.id}`,title:t(p.title,locale)+' · '+t(p.tagline,locale)}))];
---
<!doctype html><html lang={locale==='zh-cn'?'zh-CN':'en'}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={t(['给零基础创作者的 Vibe Coding 实践指南。','A practical guide to building with AI, for people who don’t code.'],locale)}/><title>{title} · Vibe Guide</title><link rel="icon" type="image/png" href="/brand/vibe-guide-mark.png"/><link rel="alternate" hreflang="zh-CN" href={url('zh-cn',path)}/><link rel="alternate" hreflang="en" href={url('en',path)}/></head>
<body><a class="skip-link" href="#main">{t(['跳到内容','Skip to content'],locale)}</a>
<header class="topbar"><div class="top-inner"><button class="icon-button mobile-toggle" data-open="mobile-menu" aria-label={t(['打开菜单','Open menu'],locale)}><Icon name="menu"/></button><a class="brand" href={url(locale)}><img class="brand-symbol" src="/brand/vibe-guide-mark.png" width="36" height="36" alt="" decoding="async"/>Vibe Guide<span class="beta">BETA</span></a><button class="header-search" data-open="search-dialog" aria-label={t(['搜索学习步骤与问题','Search steps and problems'],locale)}><Icon name="search"/><span>{t(['搜索想做的事…','Search projects and guides…'],locale)}</span><kbd>⌘ K</kbd></button><div class="languages" aria-label={t(['语言','Language'],locale)}><a href={url('zh-cn',path)} aria-current={locale==='zh-cn'?'true':undefined} lang="zh-CN">中文</a><a href={url('en',path)} aria-current={locale==='en'?'true':undefined} lang="en">EN</a></div><button class="icon-button help-button" data-open="about-dialog" aria-label={t(['关于预览','About this preview'],locale)}><Icon name="help"/></button></div></header>
<div class="app-shell"><aside class="sidebar"><Navigation locale={locale} path={path}/></aside><main data-pagefind-body id="main" tabindex="-1">{path&&<JourneyContext locale={locale} path={path}/>}<slot/></main></div>
<dialog id="mobile-menu" class="mobile-dialog"><form method="dialog"><button class="icon-button close" aria-label={t(['关闭菜单','Close menu'],locale)}><Icon name="close"/></button></form><Navigation locale={locale} path={path}/></dialog>
<dialog id="search-dialog"><div class="dialog-heading"><h2>{t(['寻找起点','Find the starting point'],locale)}</h2><form method="dialog"><button class="icon-button" aria-label={t(['关闭','Close'],locale)}><Icon name="close"/></button></form></div><label for="search-input">{t(['搜索全部指南与组件','Search all guides and components'],locale)}</label><input id="search-input" type="search" placeholder={t(['例如：网站、手机、文件','Try: website, mobile, files'],locale)}/><p id="full-search-status" role="status"></p><div id="full-search-results" class="search-results"></div><p class="small muted">{t(['板块快捷入口','Module shortcuts'],locale)}</p><div class="search-results">{searchEntries.map(entry=><a href={url(locale,entry.path)} data-search={entry.title.toLowerCase()}>{entry.title}<Icon name="arrow"/></a>)}</div><p id="search-empty" hidden>{t(['快捷入口没有匹配，可查看上方全文搜索结果。','No matching shortcuts. Check the full-text results above.'],locale)}</p></dialog>

<dialog id="about-dialog"><div class="dialog-heading"><h2>{t(['一个面向零基础的实践指南','A practical guide for beginners'],locale)}</h2><form method="dialog"><button class="icon-button" aria-label={t(['关闭','Close'],locale)}><Icon name="close"/></button></form></div><p>{t(['这是双语设计预览。页面中的应用画面是示意图；流程帮助使用者判断下一步做什么，不代表项目已完成或上线。','This is a bilingual design preview. App illustrations are examples. The guides explain the next step; they do not mean a product has been built or released.'],locale)}</p></dialog>
<script is:inline type="module">
 const searchInput=document.querySelector('#search-input');
 const fullResults=document.querySelector('#full-search-results');
 const fullStatus=document.querySelector('#full-search-status');
 const english=document.documentElement.lang==='en';let generation=0;
 searchInput.addEventListener('input',async()=>{const token=++generation;const query=searchInput.value.trim();fullResults.replaceChildren();fullStatus.textContent='';if(!query)return;fullStatus.textContent=english?'Searching…':'正在搜索…';try{const bundle='/pagefind/pagefind.js';const pagefind=await import(bundle);const result=await pagefind.debouncedSearch(query);if(!result||token!==generation)return;const rows=await Promise.all(result.results.slice(0,10).map(r=>r.data()));if(token!==generation)return;for(const row of rows){const a=document.createElement('a');a.href=row.url;const title=document.createElement('strong');title.textContent=row.meta.title;const summary=document.createElement('span');summary.textContent=row.plain_excerpt;a.append(title,summary);fullResults.append(a);}fullStatus.textContent=result.results.length?(english?`${result.results.length} results; showing up to 10.`:`找到 ${result.results.length} 项，最多显示 10 项。`):(english?'No full-text matches. Try a shorter phrase or use the module shortcuts.':'全文没有匹配。试试较短词语，或使用下方板块入口。');}catch{if(token!==generation)return;fullStatus.textContent=english?'Full-text search is unavailable here. Use the module shortcuts below.':'此处全文搜索暂不可用，可使用下方板块入口。';}});

</script>
<script>
 import {initNavigation} from '../scripts/navigation';
 import {initMotion} from '../scripts/motion';
 initNavigation();initMotion();
 document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach(button=>button.addEventListener('click',()=>{(document.getElementById(button.dataset.open!) as HTMLDialogElement).showModal();}));
 document.addEventListener('keydown',event=>{if((event.metaKey||event.ctrlKey)&&event.key==='k'){event.preventDefault();const dialog=document.getElementById('search-dialog') as HTMLDialogElement;if(!dialog.open)dialog.showModal();document.getElementById('search-input')?.focus();}});
 const filterShortcuts=()=>{const query=(document.getElementById('search-input') as HTMLInputElement).value.trim().toLowerCase();let count=0;document.querySelectorAll<HTMLElement>('[data-search]').forEach(item=>{const match=item.dataset.search!.includes(query);item.hidden=!match||count>=6;if(match)count++;});document.getElementById('search-empty')!.hidden=count>0;};document.getElementById('search-input')?.addEventListener('input',filterShortcuts);filterShortcuts();
</script></body></html>
