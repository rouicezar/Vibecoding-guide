---
import '../styles/global.css';
import '../styles/refinement.css';
import {t,url,projects,type Locale} from '../data/site';
import Icon from '../components/Icon.astro';
import Navigation from '../components/Navigation.astro';
interface Props {locale:Locale;path:string;title:string;}
const {locale,path,title}=Astro.props;
const searchEntries=[{path:'',title:t(['首页','Home'],locale)},{path:'start',title:t(['项目分类','Project types'],locale)},{path:'communicate',title:t(['和 Agent 沟通 · 提示词与排查','Talking to agents · prompts and troubleshooting'],locale)},{path:'stacks',title:t(['技术栈选择','Choosing a stack'],locale)},...projects.map(p=>({path:`projects/${p.id}`,title:t(p.title,locale)+' · '+t(p.tagline,locale)}))];
---
<!doctype html><html lang={locale==='zh-cn'?'zh-CN':'en'}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={t(['给零基础创作者的 Vibe Coding 实践指南。','A practical guide to building with AI, for people who don’t code.'],locale)}/><title>{title} · Vibe Guide</title><link rel="icon" type="image/png" href="/brand/vibe-guide-mark.png"/><link rel="alternate" hreflang="zh-CN" href={url('zh-cn',path)}/><link rel="alternate" hreflang="en" href={url('en',path)}/></head>
<body><a class="skip-link" href="#main">{t(['跳到内容','Skip to content'],locale)}</a>
<header class="topbar"><div class="top-inner"><button class="icon-button mobile-toggle" data-open="mobile-menu" aria-label={t(['打开菜单','Open menu'],locale)}><Icon name="menu"/></button><a class="brand" href={url(locale)}><img class="brand-symbol" src="/brand/vibe-guide-mark.png" width="36" height="36" alt="" decoding="async"/>Vibe Guide<span class="beta">BETA</span></a><button class="header-search" data-open="search-dialog"><Icon name="search"/><span>{t(['搜索想做的事…','Search projects and guides…'],locale)}</span><kbd>⌘ K</kbd></button><div class="languages" aria-label={t(['语言','Language'],locale)}><a href={url('zh-cn',path)} aria-current={locale==='zh-cn'?'true':undefined} lang="zh-CN">中文</a><a href={url('en',path)} aria-current={locale==='en'?'true':undefined} lang="en">EN</a></div><button class="icon-button help-button" data-open="about-dialog" aria-label={t(['关于预览','About this preview'],locale)}><Icon name="help"/></button></div></header>
<div class="app-shell"><aside class="sidebar"><Navigation locale={locale} path={path}/></aside><main id="main" tabindex="-1"><slot/></main></div>
<dialog id="mobile-menu" class="mobile-dialog"><form method="dialog"><button class="icon-button close" aria-label={t(['关闭菜单','Close menu'],locale)}><Icon name="close"/></button></form><Navigation locale={locale} path={path}/></dialog>
<dialog id="search-dialog"><div class="dialog-heading"><h2>{t(['寻找起点','Find the starting point'],locale)}</h2><form method="dialog"><button class="icon-button" aria-label={t(['关闭','Close'],locale)}><Icon name="close"/></button></form></div><label for="search-input">{t(['搜索已开放的预览页面','Search available preview pages'],locale)}</label><input id="search-input" type="search" placeholder={t(['例如：网站、手机、文件','Try: website, mobile, files'],locale)}/><div class="search-results">{searchEntries.map(entry=><a href={url(locale,entry.path)} data-search={entry.title.toLowerCase()}>{entry.title}<Icon name="arrow"/></a>)}</div><p id="search-empty" hidden>{t(['没有找到。试试“网站”“小程序”或“App”。','No matches. Try “website”, “mini”, or “app”.'],locale)}</p></dialog>
<dialog id="planned-dialog"><div class="dialog-heading"><h2 id="planned-title"></h2><form method="dialog"><button class="icon-button" aria-label={t(['关闭','Close'],locale)}><Icon name="close"/></button></form></div><span class="badge">{t(['内容准备中','Content in preparation'],locale)}</span><p id="planned-description"></p><p>{t(['当前可浏览首页、项目分类、四种项目详情与沟通模块。','This preview includes the home page, project types, four project guides, and agent communication.'],locale)}</p><a class="button primary" href={url(locale,'start')}>{t(['浏览项目分类','Explore project types'],locale)}<Icon name="arrow"/></a></dialog>
<dialog id="about-dialog"><div class="dialog-heading"><h2>{t(['一个面向零基础的实践指南','A practical guide for beginners'],locale)}</h2><form method="dialog"><button class="icon-button" aria-label={t(['关闭','Close'],locale)}><Icon name="close"/></button></form></div><p>{t(['这是双语设计预览。页面中的应用画面是示意图；流程帮助使用者判断下一步做什么，不代表项目已完成或上线。','This is a bilingual design preview. App illustrations are examples. The guides explain the next step; they do not mean a product has been built or released.'],locale)}</p></dialog>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach(button=>button.addEventListener('click',()=>{(document.getElementById(button.dataset.open!) as HTMLDialogElement).showModal();}));
 document.querySelectorAll<HTMLButtonElement>('[data-planned]').forEach(button=>button.addEventListener('click',()=>{document.getElementById('planned-title')!.textContent=button.dataset.planned!;document.getElementById('planned-description')!.textContent=button.dataset.description!;(document.getElementById('planned-dialog') as HTMLDialogElement).showModal();}));
 document.addEventListener('keydown',event=>{if((event.metaKey||event.ctrlKey)&&event.key==='k'){event.preventDefault();const dialog=document.getElementById('search-dialog') as HTMLDialogElement;if(!dialog.open)dialog.showModal();document.getElementById('search-input')?.focus();}});
 document.getElementById('search-input')?.addEventListener('input',event=>{const query=(event.target as HTMLInputElement).value.trim().toLowerCase();let count=0;document.querySelectorAll<HTMLElement>('[data-search]').forEach(item=>{item.hidden=!item.dataset.search!.includes(query);if(!item.hidden)count++;});document.getElementById('search-empty')!.hidden=count>0;});
</script></body></html>
