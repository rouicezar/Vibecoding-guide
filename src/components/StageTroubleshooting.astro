---
import {t,type Locale} from '../data/site';
import {blockers} from '../data/blockers';
import PromptTemplate from './PromptTemplate.astro';
const {stage,locale}=Astro.props as {stage:string;locale:Locale};
const items=blockers.filter(b=>b.stage===stage);
---
<section class="stage-troubleshooting" aria-labelledby={`help-${stage}`}>
<div class="help-heading"><h3 id={`help-${stage}`}>{t(stage==='tell'?['工具与规则：遇到问题这样查','Tools and rules: troubleshooting']:stage==='environment'?['Git 与环境：遇到问题这样查','Git and environment: troubleshooting']:['遇到卡点，从现象开始查','Stuck? Start with what actually happens'],locale)}</h3><span>{items.length} {t(['种情况','situations'],locale)}</span></div>
<p class="help-intro">{t(['以下路径整理自官方文档与公开求助，不代表发生频率。先按现象检查，再核对处理结果。','These paths synthesize official docs and public reports, not frequency data. Check the symptom and verify the result.'],locale)}</p>{stage==='idea'&&<p class="help-intro">{t(['先自己填写材料，提示词留到下一步讨论。','Complete personal notes first; save the prompt for the next discussion.'],locale)}</p>}
{items.map(item=><details class="blocker"><summary><span>{t(item.title,locale)}</span><span class="expand-mark" aria-hidden="true">＋</span></summary><div class="blocker-body"><p><strong>{t(['看到的现象：','Observed symptom: '],locale)}</strong>{t(item.symptom,locale)}</p><ol class="recovery-path"><li><strong>{t(['先检查','Check first'],locale)}</strong><p>{t(item.check,locale)}</p></li><li><strong>{t(['接着处理','Then resolve'],locale)}</strong><p>{t(item.fix,locale)}</p></li><li><strong>{t(['这样才算解决','Verify the result'],locale)}</strong><p>{t(item.done,locale)}</p></li></ol><PromptTemplate id={`blocker-${item.id}`} kind={stage==='idea'?'worksheet':'prompt'} title={stage==='idea'?['填写后留到下一步讨论','Complete the worksheet first; use this in the next step']:['把这段发给 AI 协助处理','Send this to AI for help']} prompt={item.prompt} locale={locale}/><p class="blocker-sources"><span>{t(['查证依据','References'],locale)}</span>{item.sources.map(source=><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a>)}</p></div></details>)}
</section>
<style>.stage-troubleshooting{margin:28px 0;border-top:1px solid #dfe6ef;padding-top:24px}.help-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.help-heading span{font-size:12px;color:#738097;white-space:nowrap}.help-intro{font-size:14px;color:#57667b;max-width:75ch;line-height:1.8}.blocker{border:1px solid #dfe6ee;border-radius:8px;margin:12px 0;background:#fff}.blocker summary{display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer;padding:16px 18px;font-size:15px;font-weight:550}.blocker[open] summary{border-bottom:1px solid #e7edf3}.blocker[open] .expand-mark{transform:rotate(45deg)}.blocker-body{padding:4px 18px 16px;font-size:14px;line-height:1.85}.recovery-path{padding-left:22px;margin:20px 0}.recovery-path li{padding:0 0 10px 5px}.recovery-path p{margin:5px 0;white-space:pre-line;max-width:80ch}.blocker-sources{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:#61738a}.blocker-sources a{text-decoration:underline;text-underline-offset:3px}@media(max-width:600px){.blocker-body{padding-inline:12px}.blocker summary{padding:14px 12px}.help-heading{align-items:flex-start}}</style>
