---
import {t,type Locale,type Project} from '../data/site';
import Icon from './Icon.astro';
interface Props {project:Project;locale:Locale;}
const {project:p,locale}=Astro.props;
const handheld=p.id==='mobile'||p.id==='mini-program';
---
<div class:list={['project-visual',p.id]} aria-label={t(['应用界面示意','Illustrative app interface'],locale)}>
<div class="mock-window"><div class:list={["mock-bar",{"handheld-bar":handheld}]}>{handheld?<span aria-hidden="true">‹</span>:<Icon name={p.id==='web'?'browser':'monitor'} size={12}/>}<span>{p.id==='web'?'the-idea.site':t(p.title,locale)}</span></div><div class="mock-content"><div class="mock-symbol"><Icon name={p.icon} size={24}/></div><strong>{t(p.example,locale)}</strong><div class="mock-line"></div><div class="mock-line short"></div><div class="mock-tiles"><span></span><span></span><span></span></div><span class="mock-action">{t(['从这里开始','Start here'],locale)} →</span></div></div><span class="visual-caption">{t(['界面示意','INTERFACE EXAMPLE'],locale)}</span>
</div>

<style>.handheld-bar{justify-content:center;position:relative;background:#fff}.handheld-bar>span:first-child{position:absolute;left:10px;font-size:18px}.handheld-bar>span:last-child{margin:auto;font-size:9px}.mock-bar{gap:8px}</style>
