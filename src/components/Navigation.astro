---
import {modules,t,url,type Locale} from '../data/site';
import Icon from './Icon.astro';
interface Props {locale:Locale; path:string;}
const {locale,path}=Astro.props;
---
<div class="nav-label">{t(['学习与实践','LEARN & BUILD'],locale)}</div>
<nav aria-label={t(['主要导航','Main navigation'],locale)}>
{modules.map(item=> 'path' in item ? <a class:list={['nav-item',{active:item.path===path}]} href={url(locale,item.path)} aria-current={item.path===path?'page':undefined}><Icon name={item.icon}/><span>{t(item.title,locale)}</span></a> : <button class="nav-item" data-planned={t(item.title,locale)} data-description={t(item.desc,locale)}><Icon name={item.icon}/><span>{t(item.title,locale)}</span><span class="pending-dot" aria-label={t(['待制作','Planned'],locale)}></span></button>)}
</nav>
<div class="nav-footer"><span class="status-dot"></span>{t(['设计预览 · 6 种页面','Design preview · 6 page types'],locale)}<p>{t(['从一个小想法开始。','Start with one small idea.'],locale)}</p></div>
