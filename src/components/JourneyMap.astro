---
import Icon from './Icon.astro';
import {mainJourney} from '../data/journey';
import {t,type Locale} from '../data/site';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const stageIcons:Record<string,string>={scope:'checklist',environment:'settings',accept:'checklist',idea:'brain',tell:'message',refine:'message',requirements:'book',stack:'layers',plan:'checklist',ui:'layout',backend:'database',build:'browser',test:'checklist',launch:'upload',maintain:'settings'};
---
<section aria-labelledby="route-title" class="journey-map">
  <div class="route-heading"><h2 id="route-title">{t(['从想法到上线的完整路线','The route from idea to release'],locale)}</h2><span>{t(['按编号前进 · 点击查看','Follow the numbers · Select a stage'],locale)}</span></div>
  <div class="route-legend"><span class="blue">{t(['想法与需求','Idea & requirements'],locale)}</span><span class="violet">{t(['选型与计划','Stack & planning'],locale)}</span><span class="amber">{t(['界面、数据与开发','Interface, data & build'],locale)}</span><span class="green">{t(['验证、发布与维护','Checks, release & upkeep'],locale)}</span></div>
  <div class="connected-route"><svg class="route-lines" aria-hidden="true"><defs><marker id="route-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="context-stroke"/></marker></defs><g id="route-edges"></g></svg>
  <ol class="route-nodes">{mainJourney.map((stage,i)=><li class={stage.color}><a href={`#stage-${stage.id}`} class:list={['route-node',{selected:i===0}]} data-stage-link={stage.id} aria-current={i===0?'step':undefined}><span class="node-index"><Icon name={stageIcons[stage.id]} size={19}/></span><strong><span class="node-order">{String(i+1).padStart(2,'0')}</span>{t(stage.title,locale)}</strong><small>{stage.term}{stage.id==='build'?t([' · 3 个分支',' · 3 branches'],locale):''}</small></a></li>)}</ol></div>
  <p class="route-return">↶ {t(['需求变化 → 回到第一版范围确认；测试或验收未通过 → 回到开发任务；上线反馈 → 区分故障与新需求后进入下一轮。','Changed requirements return to scope approval. Failed tests or acceptance return to development. Release feedback is classified before the next iteration.'],locale)}</p>
<div class="route-rules"><span>{t(['贯穿全程：可恢复版本 · 任务状态 · 验证记录','Throughout: recoverable versions · task status · verification evidence'],locale)}</span><span>{t(['按条件选择：项目类型 · 是否需要后端 · 平台发布要求','Conditional: product type · backend needs · platform release requirements'],locale)}</span></div>
</section>
<script>
const container=document.querySelector<HTMLElement>('.connected-route')!;
const edges=document.getElementById('route-edges')!;
const list=container.querySelector<HTMLOListElement>('.route-nodes')!;
const nodes=Array.from(list.children) as HTMLElement[];
let lastWidth=-1;
function layoutRoute(){
 const width=container.clientWidth;
 if(!width)return;
 const vertical=width<620;
 const rows=vertical?nodes.length:width>=950?3:4;
 const counts=Array.from({length:rows},()=>Math.floor(nodes.length/rows));
 const priority=rows===3?[1,0,2]:Array.from({length:rows},(_,i)=>i);
 for(let i=0;i<nodes.length%rows;i++)counts[priority[i]]++;
 container.classList.toggle('route-vertical',vertical);
 list.dataset.layout=vertical?'vertical':`${rows}-rows`;
 let index=0,top=0;
 const edge=vertical?0:Math.min(100,width/(Math.max(...counts)*2));
 counts.forEach((count,row)=>{
  const gap=count>1?(width-edge*2)/(count-1):0;
  const nodeWidth=vertical?width:Math.min(200,edge*2,gap-18);
  const rowNodes=nodes.slice(index,index+count);
  rowNodes.forEach((node,column)=>{
   const x=vertical?0:edge+gap*(row%2?count-column-1:column)-nodeWidth/2;
   node.style.width=`${nodeWidth}px`;
   node.style.left=`${x}px`;
   node.style.top=`${top}px`;
  });
  const height=Math.max(...rowNodes.map(node=>node.getBoundingClientRect().height));
  top+=height+(vertical?28:44);
  index+=count;
 });
 list.style.height=`${top-(vertical?28:44)+8}px`;
 drawConnections();
}
function drawConnections(){
 const box=container.getBoundingClientRect();
 const points=Array.from(container.querySelectorAll<HTMLElement>('.node-index')).map(el=>{const r=el.getBoundingClientRect();return{x:r.x-box.x+r.width/2,y:r.y-box.y+r.height/2,color:getComputedStyle(el).getPropertyValue('--stage-color').trim()};});
 edges.replaceChildren();
 points.slice(0,-1).forEach((a,i)=>{const b=points[i+1];const dx=b.x-a.x,dy=b.y-a.y;const vertical=Math.abs(dx)<2;const sign=Math.sign(vertical?dy:dx);const start=vertical?`${a.x},${a.y+19*sign}`:`${a.x+19*sign},${a.y}`;const end=vertical?`${b.x},${b.y-23*sign}`:`${b.x-23*sign},${b.y}`;const path=document.createElementNS('http://www.w3.org/2000/svg','path');path.setAttribute('d',`M ${start} L ${end}`);path.setAttribute('stroke',a.color);path.setAttribute('stroke-width','1.5');path.setAttribute('fill','none');path.setAttribute('marker-end','url(#route-arrow)');edges.append(path);});
}
new ResizeObserver(()=>{if(container.clientWidth!==lastWidth){lastWidth=container.clientWidth;layoutRoute();}}).observe(container);
document.fonts.ready.then(layoutRoute);
</script>
