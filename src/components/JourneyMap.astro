---
import Icon from './Icon.astro';
import {journey} from '../data/journey';
import {t,type Locale} from '../data/site';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const stageIcons:Record<string,string>={idea:'help',tell:'message',refine:'message',requirements:'book',stack:'layers',plan:'checklist',ui:'layout',backend:'database',build:'browser',test:'checklist',launch:'upload',maintain:'settings'};
---
<section aria-labelledby="route-title" class="journey-map">
  <div class="route-heading"><h2 id="route-title">{t(['从想法到上线的完整路线','The route from idea to release'],locale)}</h2><span>{t(['按编号前进 · 点击查看','Follow the numbers · Select a stage'],locale)}</span></div>
  <div class="route-legend"><span class="blue">{t(['想法与需求','Idea & requirements'],locale)}</span><span class="violet">{t(['选型与计划','Stack & planning'],locale)}</span><span class="amber">{t(['界面、数据与开发','Interface, data & build'],locale)}</span><span class="green">{t(['验证、发布与维护','Checks, release & upkeep'],locale)}</span></div>
  <div class="connected-route"><svg class="route-lines" aria-hidden="true"><defs><marker id="route-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="context-stroke"/></marker></defs><g id="route-edges"></g></svg>
  <ol class="route-nodes">{journey.map((stage,i)=><li class={stage.color}><a href={`#stage-${stage.id}`} class:list={['route-node',{selected:i===0}]} data-stage-link={stage.id} aria-current={i===0?'step':undefined}><span class="node-index"><Icon name={stageIcons[stage.id]} size={19}/></span><strong><span class="node-order">{String(i+1).padStart(2,'0')}</span>{t(stage.title,locale)}</strong><small>{stage.term}</small></a></li>)}</ol></div>
  <p class="route-return">↶ {t(['需求变化 → 回到需求文档并更新选型与计划；测试未通过 → 回到对应开发任务；上线反馈 → 进入下一轮。','Changed requirements return to the document and plan. Failed checks return to the relevant task. Release feedback starts the next iteration.'],locale)}</p>
</section>
<script>
const container=document.querySelector<HTMLElement>('.connected-route')!;
const edges=document.getElementById('route-edges')!;
function drawConnections(){
 const box=container.getBoundingClientRect();
 const points=Array.from(container.querySelectorAll<HTMLElement>('.node-index')).map(el=>{const r=el.getBoundingClientRect();return{x:r.x-box.x+r.width/2,y:r.y-box.y+r.height/2,color:getComputedStyle(el).getPropertyValue('--stage-color').trim()};});
 edges.replaceChildren();
 points.slice(0,-1).forEach((a,i)=>{const b=points[i+1];const dx=b.x-a.x,dy=b.y-a.y;const vertical=Math.abs(dx)<2;const sign=Math.sign(vertical?dy:dx);const start=vertical?`${a.x},${a.y+19*sign}`:`${a.x+19*sign},${a.y}`;const end=vertical?`${b.x},${b.y-23*sign}`:`${b.x-23*sign},${b.y}`;const path=document.createElementNS('http://www.w3.org/2000/svg','path');path.setAttribute('d',`M ${start} L ${end}`);path.setAttribute('stroke',a.color);path.setAttribute('stroke-width','1.5');path.setAttribute('fill','none');path.setAttribute('marker-end','url(#route-arrow)');edges.append(path);});
}
new ResizeObserver(drawConnections).observe(container);document.fonts.ready.then(drawConnections);
</script>
