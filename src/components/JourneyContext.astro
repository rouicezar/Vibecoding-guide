---
import {lessons,legacyLessons,lessonPath} from '../data/learning';
import {t,url,type Locale} from '../data/site';
const {path,locale}=Astro.props as {path:string;locale:Locale};
const mapping:Record<string,string>={tools:'tool',start:'idea',projects:'preview',communicate:'clarify',stacks:'choose-stack',components:'interface',data:'save',check:'test',launch:'delivery',maintain:'maintain',terms:'idea'};
const defaultId=mapping[path.split('/')[0]]??'idea';
---
<div class="journey-context" data-journey-context data-routes={JSON.stringify(lessons.map(l=>({id:l.id,title:t(l.title,locale)})))} data-legacy={JSON.stringify(legacyLessons)} data-default={defaultId} data-locale={locale}><span>{t(['按需参考 · 看完回到当前动作','Reference · return to the current action when ready'],locale)}</span><a data-context-return href={url(locale,lessonPath(defaultId))}>{t(['返回学习步骤 →','Return to the learning step →'],locale)}</a></div>
<script>
const context=document.querySelector<HTMLElement>('[data-journey-context]');if(context){const routes=JSON.parse(context.dataset.routes!) as {id:string;title:string}[];const query=new URLSearchParams(location.search);const legacy=JSON.parse(context.dataset.legacy!);const requested=query.get('lesson')||legacy[query.get('stage')??''];const lesson=routes.find(l=>l.id===requested)||routes.find(l=>l.id===context.dataset.default)!;const a=context.querySelector<HTMLAnchorElement>('[data-context-return]')!;a.href=`/${context.dataset.locale}/learn/${lesson.id}/`;a.textContent=(context.dataset.locale==='en'?'Return: ':'返回：')+lesson.title+' →';document.querySelectorAll<HTMLAnchorElement>('.languages a,main a').forEach(link=>{const target=new URL(link.href);if(target.origin===location.origin&&!target.pathname.includes('/learn/')&&target.pathname!==`/${context.dataset.locale}/`){target.searchParams.set('lesson',lesson.id);link.href=target.href;}});}
</script>
<style>.journey-context{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:1px solid #e2e8f0;margin-bottom:24px;padding-bottom:14px;font-size:12px;color:#64748b}.journey-context a{font-weight:600}</style>
