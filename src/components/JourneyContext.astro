---
import {journey,mainJourney} from '../data/journey';
import {t,url,type Locale} from '../data/site';
const {path,locale}=Astro.props as {path:string;locale:Locale};
const mapping:Record<string,string>={tools:'tell',start:'idea',projects:'build',communicate:'tell',stacks:'stack',components:'ui',data:'backend',check:'test',launch:'launch',maintain:'maintain',terms:'idea'};
const defaultId=mapping[path.split('/')[0]]??'idea';
const stage=journey.find(s=>s.id===defaultId)!;
const routes=journey.map(s=>({id:s.id,title:t(s.title,locale),number:mainJourney.findIndex(m=>m.id===(s.parent??s.id))+1,parent:s.parent}));
const number=mainJourney.findIndex(s=>s.id===(stage.parent??stage.id))+1;
---
<div class="journey-context" data-journey-context data-routes={JSON.stringify(routes)} data-default={defaultId} data-home={url(locale)} data-locale={locale}><div><span class="small muted">{t(['这页在制作流程中的位置','Where this page fits'],locale)}</span><p data-context-title>{number}. {t(stage.title,locale)}</p></div><a data-context-return href={`${url(locale)}#stage-${defaultId}`}>{t(['返回这一步，接着往下做 →','Return to this step and continue →'],locale)}</a></div>
<script>
const context=document.querySelector<HTMLElement>('[data-journey-context]');if(context){const routes=JSON.parse(context.dataset.routes!) as {id:string;title:string;number:number}[];const requested=new URLSearchParams(location.search).get('stage');const stage=routes.find(s=>s.id===requested)||routes.find(s=>s.id===context.dataset.default)!;context.querySelector('[data-context-title]')!.textContent=`${stage.number}. ${stage.title}`;(context.querySelector('[data-context-return]') as HTMLAnchorElement).href=context.dataset.home+'#stage-'+stage.id;if(requested&&routes.some(s=>s.id===requested))document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(a=>a.search=new URLSearchParams({stage:stage.id}).toString());}
</script>
<style>.journey-context{display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid #e2e8f0;margin-bottom:24px;padding-bottom:14px;font-size:13px}.journey-context p{margin:4px 0 0;font-weight:600}.journey-context a{max-width:48%}</style>
