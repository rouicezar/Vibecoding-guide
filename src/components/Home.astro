---
import {slogan,t,url,modules,type Locale} from '../data/site';
import {journey,mainJourney} from '../data/journey';
import Icon from './Icon.astro';
import JourneyMap from './JourneyMap.astro';
import PromptTemplate from './PromptTemplate.astro';
import StageTroubleshooting from './StageTroubleshooting.astro';
interface Props {locale:Locale;}
const {locale}=Astro.props;
---
<header class="journey-intro"><p class="small muted">{t(slogan,locale)}</p><h1>{t(['把一个想法，做成能用的产品。','Turn the idea into a working product.'],locale)}</h1><p>{t(['从想法到上线，按节点推进。AI 负责提问、整理和执行，人工确认方向、费用与实际效果；每一步都有产出和检查依据。','Follow the stages from idea to release. AI clarifies, documents, and builds; people confirm direction, costs, and actual results. Each stage has a deliverable and a check.'],locale)}</p></header>
<p class="route-introduction">{t(['第一次开始：从第 1 步填写想法。每步只做当前任务，检查结果后点“下一步”；左侧板块是需要时查阅的操作资料。','First visit: start with step 1. Complete and check one step, then choose Next. Sidebar modules provide practical help when needed.'],locale)}</p><JourneyMap locale={locale}/>
<div class="stage-workspace">{journey.map((stage)=>{const flow=stage.parent?journey.filter(s=>s.parent===stage.parent):mainJourney;const i=flow.findIndex(s=>s.id===stage.id);const number=stage.parent?`${mainJourney.findIndex(s=>s.id===stage.parent)+1}.${i+1}`:String(i+1).padStart(2,'0');return <section id={`stage-${stage.id}`} data-stage-panel={stage.id} hidden={stage.id!=='idea'} data-stage-parent={stage.parent} aria-labelledby={`title-${stage.id}`}><div class="stage-heading"><span class="stage-number">{number}</span><div><p class="term">{stage.term}</p><h2 id={`title-${stage.id}`}>{t(stage.question,locale)}</h2></div></div>{(stage.id==='build'||stage.parent==='build')&&<nav class="build-branches" aria-label={t(['开发分支','Build branches'],locale)}>{journey.filter(s=>s.id==='build'||s.parent==='build').map(branch=><a href={`#stage-${branch.id}`} aria-current={stage.id===branch.id?'page':undefined}>{t(branch.title,locale)}</a>)}<p>{t(['分支按任务依赖交替推进；不需要保存或共享资料时，可跳过后端并记录原因。','Follow task dependencies across branches. Skip backend work with a recorded reason when storage or sharing is unnecessary.'],locale)}</p></nav>}<div class="stage-incoming"><strong>{t(['先带上这些材料','Bring these inputs'],locale)}</strong><p>{t(stage.incoming,locale)}</p></div>
{stage.id==='tell'&&<div class="practice-links"><a href={url(locale,'tools')}>{t(['① 先选工具并打开项目','① Choose a tool and open a project'],locale)} →</a><a href={url(locale,'communicate/setup')}>{t(['② 初始化 Git，生成 AGENTS.md','② Set up Git and AGENTS.md'],locale)} →</a></div>}
{stage.id==='environment'&&<p><a href={url(locale,'communicate/setup')}>{t(['还没有 Git 与项目规则？先补齐项目准备 →','Missing Git or project instructions? Complete setup first →'],locale)}</a></p>}
{stage.id==='ui'&&<div class="practice-links"><a href={url(locale,'components/style')}>{t(['整体风格怎么描述','Describe the overall style'],locale)} →</a><a href={url(locale,'components/edit')}>{t(['只改一个地方或组件','Edit one area or component'],locale)} →</a></div>}
<div class="stage-columns"><div><h3>{t(stage.id==='idea'?['先记录自己的想法','Start with personal notes']:['这一步，和 AI 这样配合','Work with AI like this'],locale)}</h3><ol class="stage-actions">{stage.actions.map(action=><li>{t(action,locale)}</li>)}</ol><div class="stage-output"><Icon name="check"/><div><span>{t(stage.id==='idea'?['这一站留下的材料','Material from this step']:['和 AI 一起得到','Expected outcome'],locale)}</span><p>{t(stage.output,locale)}</p></div></div><aside class="stage-example"><p>{t(stage.example,locale)}</p></aside><div class="stage-module-links"><span>{t(['需要详细操作时打开','Open for detailed help'],locale)}</span>{stage.moduleIds.map(id=>{const item=modules.find(m=>m.id===id)!;return <a href={url(locale,item.path)+`?stage=${stage.id}`}>{t(item.title,locale)} ↗</a>;})}</div>{stage.id==='ui'&&<p class="small muted">{t(['组件词典是本节点下的分支：名称 → 可操作演示 → 描述话术。212 个词条已迁移；12 项有局部交互示例，其余演示尚未迁移或验证。','The component dictionary belongs here: name → interactive demo → descriptive prompt. All 212 entries are migrated; 12 have partial interactive examples. Remaining demos are not migrated or verified.'],locale)}</p>}{stage.id==='idea'&&<a class="text-link" href={url(locale,'start')}>{t(['比较网站、小程序和 App 的区别','Compare websites, mini programs, and apps'],locale)}<Icon name="arrow"/></a>}{stage.id==='build'&&<a class="text-link" href={url(locale,'projects/web')}>{t(['查看一个网站的制作路线','Explore the website guide'],locale)}<Icon name="arrow"/></a>}</div><aside class="stage-problem"><span class="small muted">{t(['这里常会卡住','A common sticking point'],locale)}</span><h3>{t(stage.problem,locale)}</h3><p>{t(stage.answer,locale)}</p></aside></div><PromptTemplate kind={stage.id==='idea'?'worksheet':stage.id==='tell'?'handoff':'prompt'} id={stage.id} title={stage.promptTitle} prompt={stage.prompt} locale={locale}/><StageTroubleshooting stage={stage.id} locale={locale}/><div class="stage-pagination">{stage.parent&&<a href={`#stage-${stage.parent}`}>↰ {t(['返回开发总览','Back to build overview'],locale)}</a>}{i>0&&<a href={`#stage-${flow[i-1].id}`} data-stage-link={flow[i-1].id}>← {t(flow[i-1].title,locale)}</a>}{i<flow.length-1&&<a class="next-stage" href={`#stage-${flow[i+1].id}`} data-stage-link={flow[i+1].id}>{t(['检查完成，下一步：','Checked; next: '],locale)}{t(flow[i+1].title,locale)} →</a>}</div></section>;})}</div><script>
const showStage=()=>{const id=location.hash.replace('#stage-','');const panel=document.querySelector<HTMLElement>(`[data-stage-panel="${CSS.escape(id)}"]`);const selected=panel?id:'idea';document.querySelectorAll<HTMLElement>('[data-stage-panel]').forEach(p=>p.hidden=p.dataset.stagePanel!==selected);document.querySelectorAll<HTMLElement>('.route-node').forEach(a=>{const active=a.dataset.stageLink===(panel?.dataset.stageParent||selected);a.classList.toggle('selected',active);if(active)a.setAttribute('aria-current','step');else a.removeAttribute('aria-current');});document.querySelectorAll<HTMLElement>('[data-template-status]').forEach(status=>status.textContent='');document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(a=>{a.hash=panel?'stage-'+selected:'';});};
showStage();window.addEventListener('hashchange',showStage);
</script>

<style>.stage-incoming{padding:14px 0;border-bottom:1px solid #e2e8f0;margin-bottom:20px}.stage-incoming p{margin:5px 0 0}.stage-example{border-left:3px solid #f28c18;padding:2px 14px;margin:20px 0;background:#fffaf2}.practice-links{display:flex;flex-wrap:wrap;gap:16px;margin:16px 0 24px}.practice-links a{font-weight:600}.route-introduction{font-size:14px;color:#475569}</style>
