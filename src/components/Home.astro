---
import {slogan,t,url,modules,type Locale} from '../data/site';
import {journey} from '../data/journey';
import Icon from './Icon.astro';
import JourneyMap from './JourneyMap.astro';
import PromptTemplate from './PromptTemplate.astro';
interface Props {locale:Locale;}
const {locale}=Astro.props;
---
<header class="journey-intro"><p class="small muted">{t(slogan,locale)}</p><h1>{t(['把一个想法，做成能用的产品。','Turn the idea into a working product.'],locale)}</h1><p>{t(['从想法到上线，按节点推进。AI 负责提问、整理和执行，人工确认方向、费用与实际效果；每一步都有产出和检查依据。','Follow the stages from idea to release. AI clarifies, documents, and builds; people confirm direction, costs, and actual results. Each stage has a deliverable and a check.'],locale)}</p></header>
<JourneyMap locale={locale}/>
<div class="stage-workspace">{journey.map((stage,i)=><section id={`stage-${stage.id}`} data-stage-panel={stage.id} hidden={i!==0} aria-labelledby={`title-${stage.id}`}><div class="stage-heading"><span class="stage-number">{String(i+1).padStart(2,'0')}</span><div><p class="term">{stage.term}</p><h2 id={`title-${stage.id}`}>{t(stage.question,locale)}</h2></div></div><div class="stage-columns"><div><h3>{t(stage.id==='idea'?['先记录自己的想法','Start with personal notes']:['这一步，和 AI 这样配合','Work with AI like this'],locale)}</h3><ol class="stage-actions">{stage.actions.map(action=><li>{t(action,locale)}</li>)}</ol><div class="stage-output"><Icon name="check"/><div><span>{t(stage.id==='idea'?['这一站留下的材料','Material from this step']:['和 AI 一起得到','Expected outcome'],locale)}</span><p>{t(stage.output,locale)}</p></div></div><div class="stage-module-links"><span>{t(['对应板块','Related modules'],locale)}</span>{stage.moduleIds.map(id=>{const item=modules.find(m=>m.id===id)!;return 'path' in item?<a href={url(locale,item.path)}>{t(item.title,locale)} ↗</a>:<button data-planned={t(item.title,locale)} data-description={t(item.desc,locale)}>{t(item.title,locale)} <small>{t(['待制作','Planned'],locale)}</small></button>;})}</div>{stage.id==='ui'&&<p class="small muted">{t(['组件词典是本节点下的分支：名称 → 可操作演示 → 描述话术。原 HTML 词典待迁移。','The component dictionary belongs here: name → interactive demo → descriptive prompt. Legacy migration is pending.'],locale)}</p>}{stage.id==='idea'&&<a class="text-link" href={url(locale,'start')}>{t(['比较网站、小程序和 App 的区别','Compare websites, mini programs, and apps'],locale)}<Icon name="arrow"/></a>}{stage.id==='build'&&<a class="text-link" href={url(locale,'projects/web')}>{t(['查看一个网站的制作路线','Explore the website guide'],locale)}<Icon name="arrow"/></a>}</div><aside class="stage-problem"><span class="small muted">{t(['这里常会卡住','A common sticking point'],locale)}</span><h3>{t(stage.problem,locale)}</h3><p>{t(stage.answer,locale)}</p></aside></div><PromptTemplate kind={stage.id==='idea'?'worksheet':stage.id==='tell'?'handoff':'prompt'} id={stage.id} title={stage.promptTitle} prompt={stage.prompt} locale={locale}/><div class="stage-pagination">{i>0&&<a href={`#stage-${journey[i-1].id}`} data-stage-link={journey[i-1].id}>← {t(journey[i-1].title,locale)}</a>}{i<journey.length-1&&<a class="next-stage" href={`#stage-${journey[i+1].id}`} data-stage-link={journey[i+1].id}>{t(['下一站：','Next: '],locale)}{t(journey[i+1].title,locale)} →</a>}</div></section>)}</div><script>
const showStage=()=>{const id=location.hash.replace('#stage-','');const panel=document.querySelector<HTMLElement>(`[data-stage-panel="${CSS.escape(id)}"]`);const selected=panel?id:'idea';document.querySelectorAll<HTMLElement>('[data-stage-panel]').forEach(p=>p.hidden=p.dataset.stagePanel!==selected);document.querySelectorAll<HTMLElement>('.route-node').forEach(a=>{const active=a.dataset.stageLink===selected;a.classList.toggle('selected',active);if(active)a.setAttribute('aria-current','step');else a.removeAttribute('aria-current');});document.querySelectorAll<HTMLElement>('[data-template-status]').forEach(status=>status.textContent='');document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(a=>{a.hash=panel?'stage-'+selected:'';});};
showStage();window.addEventListener('hashchange',showStage);
</script>
