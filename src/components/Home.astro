---
import {modules,slogan,t,url,type Locale} from '../data/site';
import Icon from './Icon.astro';
interface Props {locale:Locale;}
const {locale}=Astro.props;
---
<section class="home-hero"><div class="eyebrow"><span class="status-dot"></span>{t(['为每一个想把想法做出来的人','FOR PEOPLE WITH AN IDEA'],locale)}</div><h1>{locale==='zh-cn'?<>AI 时代，即使零基础不懂代码，<br/>也能 <span class="nowrap">Vibe Coding。</span></>:t(slogan,locale)}</h1><p class="lead">{t(['不必先学会代码。先讲清你想做什么，再和 AI 一起，把一个小想法变成能用的产品。','You don’t need to learn code first. Start with a clear idea, work with AI, and turn one small idea into something useful.'],locale)}</p><div class="actions"><a class="button primary" href={url(locale,'start')}>{t(['找到我的起点','Find my starting point'],locale)}<Icon name="arrow"/></a><a class="button" href={url(locale,'projects/web')}>{t(['从第一个网站开始','Build my first website'],locale)}</a></div><div class="hero-process"><span><b>01</b>{t(['说清想法','Describe it'],locale)}</span><Icon name="arrow"/><span><b>02</b>{t(['做出小版本','Build small'],locale)}</span><Icon name="arrow"/><span><b>03</b>{t(['亲手检查','Try it out'],locale)}</span></div></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">THE GUIDE</span><h2>{t(['从想法到上线，每一步都有方向','A clear next step, from idea to launch'],locale)}</h2></div><span class="muted small">{t(['11 个实践板块','11 practical topics'],locale)}</span></div><div class="module-grid">{modules.slice(1).map((item,index)=><a href={'path' in item?url(locale,item.path):undefined} role={'path' in item?undefined:'button'} tabindex={'path' in item?undefined:0} class="module-card" data-module-planned={'path' in item?undefined:t(item.title,locale)} data-description={t(item.desc,locale)}><div class="card-top"><Icon name={item.icon}/><span class="module-number">{String(index+1).padStart(2,'0')}</span></div><h3>{t(item.title,locale)}<Icon name="arrow" size={15}/></h3><span class="term">{item.term}</span><p>{t(item.desc,locale)}</p>{!('path' in item)&&<span class="planned-label">{t(['准备中','Planned'],locale)}</span>}</a>)}</div></section>
<section class="bottom-note"><Icon name="message" size={24}/><div><h3>{t(['不认识术语，也能问出好问题。','You can ask good questions without knowing the jargon.'],locale)}</h3><p>{t(['每个专业名词都有白话解释，每条路线都有能直接用的提示词。','Plain-language definitions and ready-to-adapt prompts accompany every project guide.'],locale)}</p></div><a href={url(locale,'projects/web')+'#prompt'}>{t(['看看示例','See an example'],locale)} →</a></section>
<script>
document.querySelectorAll<HTMLElement>('[data-module-planned]').forEach(item=>{const open=()=>{document.getElementById('planned-title')!.textContent=item.dataset.modulePlanned!;document.getElementById('planned-description')!.textContent=item.dataset.description!;(document.getElementById('planned-dialog') as HTMLDialogElement).showModal();};item.addEventListener('click',open);item.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});});
</script>
