---
import {slogan,t,url,type Locale} from '../data/site';
import {journey} from '../data/journey';
import Icon from './Icon.astro';
interface Props {locale:Locale;}
const {locale}=Astro.props;
---
<header class="journey-intro"><p class="small muted">{t(slogan,locale)}</p><h1>{t(['把一个想法，做成能用的产品。','Turn your idea into a working product.'],locale)}</h1><p>{t(['先看看整条路线。找到你现在的位置，点开这一站，拿到做法、模板和遇到问题时的答案。','See the whole route first. Choose your current stage for practical steps, a reusable prompt, and help with common problems.'],locale)}</p></header>
<section aria-labelledby="route-title" class="journey-map"><div class="route-heading"><h2 id="route-title">{t(['从哪里开始，走到哪里','Your route from idea to product'],locale)}</h2><span>{t(['点击节点查看','Select a stage'],locale)}</span></div><ol class="route-nodes">{journey.map((stage,i)=><li><a href={`#stage-${stage.id}`} class:list={['route-node',{selected:i===0}]} data-stage-link={stage.id} aria-current={i===0?'step':undefined}><span class="node-index">{String(i+1).padStart(2,'0')}</span><strong>{t(stage.title,locale)}</strong><small>{stage.term}</small></a></li>)}</ol><p class="route-return">↶ {t(['发现需求有变化，就回到需求文档；上线后的反馈，也从这里开始下一轮。','When requirements change, return to the document. Feedback after release starts the next round here too.'],locale)}</p></section>
<div class="stage-workspace">{journey.map((stage,i)=><section id={`stage-${stage.id}`} data-stage-panel={stage.id} hidden={i!==0} aria-labelledby={`title-${stage.id}`}><div class="stage-heading"><span class="stage-number">{String(i+1).padStart(2,'0')}</span><div><p class="term">{stage.term}</p><h2 id={`title-${stage.id}`}>{t(stage.question,locale)}</h2></div></div><div class="stage-columns"><div><h3>{t(['这一站要做的事','What to do here'],locale)}</h3><ol class="stage-actions">{stage.actions.map(action=><li>{t(action,locale)}</li>)}</ol><div class="stage-output"><Icon name="check"/><div><span>{t(['带着这个结果进入下一站','Take this to the next stage'],locale)}</span><p>{t(stage.output,locale)}</p></div></div><p class="stage-modules">{t(['相关资料：','Related topics: '],locale)}{t(stage.modules,locale)}</p>{stage.id==='idea'&&<a class="text-link" href={url(locale,'start')}>{t(['比较网站、小程序和 App 的区别','Compare websites, mini programs, and apps'],locale)}<Icon name="arrow"/></a>}{stage.id==='build'&&<a class="text-link" href={url(locale,'projects/web')}>{t(['查看一个网站的制作路线','Explore the website guide'],locale)}<Icon name="arrow"/></a>}</div><aside class="stage-problem"><span class="small muted">{t(['这里常会卡住','A common sticking point'],locale)}</span><h3>{t(stage.problem,locale)}</h3><p>{t(stage.answer,locale)}</p></aside></div><div class="stage-template"><div class="route-heading"><h3>{stage.id==='ui'?t(['把组件讲清楚：Tabs 示例','Describe a component: tabs'],locale):t(['把这段话交给 AI，再补上你的信息','Adapt this prompt for your AI assistant'],locale)}</h3><button class="copy-inline" data-copy-stage={stage.id}><Icon name="copy" size={14}/>{t(['复制','Copy'],locale)}</button></div><p data-stage-prompt={stage.id}>{t(stage.prompt,locale)}</p></div><div class="stage-pagination">{i>0&&<a href={`#stage-${journey[i-1].id}`} data-stage-link={journey[i-1].id}>← {t(journey[i-1].title,locale)}</a>}{i<journey.length-1&&<a class="next-stage" href={`#stage-${journey[i+1].id}`} data-stage-link={journey[i+1].id}>{t(['下一站：','Next: '],locale)}{t(journey[i+1].title,locale)} →</a>}</div></section>)}</div><p id="journey-status" role="status" data-success={t(['已复制。请补上你的实际信息，再交给 AI。','Copied. Add your own details before sending it to AI.'],locale)} data-failure={t(['未能复制，请手动选中文字。','Could not copy. Please select the text manually.'],locale)}></p>
<script>
const showStage=()=>{const id=location.hash.replace('#stage-','');const panel=document.querySelector<HTMLElement>(`[data-stage-panel="${CSS.escape(id)}"]`);const selected=panel?id:'idea';document.querySelectorAll<HTMLElement>('[data-stage-panel]').forEach(p=>p.hidden=p.dataset.stagePanel!==selected);document.querySelectorAll<HTMLElement>('.route-node').forEach(a=>{const active=a.dataset.stageLink===selected;a.classList.toggle('selected',active);if(active)a.setAttribute('aria-current','step');else a.removeAttribute('aria-current');});document.getElementById('journey-status')!.textContent='';document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(a=>{a.hash=panel?'stage-'+selected:'';});};
showStage();window.addEventListener('hashchange',showStage);
document.querySelectorAll<HTMLButtonElement>('[data-copy-stage]').forEach(button=>button.addEventListener('click',async()=>{const status=document.getElementById('journey-status')!;try{await navigator.clipboard.writeText(document.querySelector(`[data-stage-prompt="${button.dataset.copyStage}"]`)!.textContent!.trim());status.textContent=status.dataset.success!;}catch{status.textContent=status.dataset.failure!;}}));
</script>
