---
import {t,url,type Locale} from '../data/site';
import {legacyLessons} from '../data/learning';
import '../styles/learning.css';
const {locale}=Astro.props as {locale:Locale};
---
<div class="learning start-home" data-home-locale={locale} data-legacy={JSON.stringify(legacyLessons)}>
{Object.keys(legacyLessons).map(id=><span id={`stage-${id}`} hidden></span>)}
<p class="eyebrow">{t(['给第一次用 AI 做项目的人','FOR A FIRST PROJECT WITH AI'],locale)}</p>
<h1>{t(['从一个小想法，\n到第一个小作品。','A small idea.\nA first working project.'],locale)}</h1>
<p class="home-intro">{t(['不需要先学会编程。跟着一个动作做，看到结果，再走下一步。卡住时，就在原地找帮助。','Start without coding experience. Do one action, check its result, then continue. Find help exactly where progress stops.'],locale)}</p>
<a class="learn-primary" data-resume href={url(locale,'learn/idea')}>{t(['开始第一步','Start the first step'],locale)} →</a>
<a class="home-route" href={url(locale,'learn')}>{t(['先看完整路线','See the learning route'],locale)} ↗</a>
<div class="project-preview"><div><span class="preview-label">{t(['贯穿练习 · 学习记录','PRACTICE PROJECT · LEARNING JOURNAL'],locale)}</span><h2>{t(['先做成这件小事','Start with something small'],locale)}</h2><p>{t(['写下一句 → 保存 → 下次还能找到','Write a note → save → find it next time'],locale)}</p><a href={`/examples/journal-${locale}.html`} target="_blank" rel="noopener">{t(['试用成品示例','Try the finished example'],locale)} ↗</a></div><div class="journal-mock" aria-label={t(['学习记录外观示意','Illustration of a learning journal'],locale)}><div class="mock-dots">● ● ● <span>{t(['外观示意','Illustration'],locale)}</span></div><strong>{t(['今天，学到了什么？','What did I learn today?'],locale)}</strong><div class="mock-input">{t(['我让 AI 做出了第一个页面。','I made my first page with AI.'],locale)}</div><span class="mock-save">{t(['保存记录','Save note'],locale)}</span><div class="mock-note">✓ {t(['下次打开，还能看到','Still here when reopened'],locale)}</div></div></div>
<p class="local-note">{t(['保留自己的想法，也可以跟着示例做。已有经验？按需查资料。','Bring a personal idea or follow the example. Already experienced? Browse the reference library.'],locale)} <a href={url(locale,'library')}>{t(['查资料 →','Reference library →'],locale)}</a></p>
</div>
<script>
import {parseLearning} from '../scripts/learning';
const home=document.querySelector<HTMLElement>('[data-home-locale]');if(home){const locale=home.dataset.homeLocale!;const legacy=JSON.parse(home.dataset.legacy!);const redirect=()=>{const id=legacy[location.hash.replace('#stage-','')];if(id)location.replace(`/${locale}/learn/${id}/`);};redirect();addEventListener('hashchange',redirect);try{const state=parseLearning(localStorage.getItem('vibe-guide-learning-v1'));if(state.idea||state.completed.length){const a=home.querySelector<HTMLAnchorElement>('[data-resume]')!;a.href=`/${locale}/learn/${state.current}/`;a.textContent=locale==='en'?'Continue where I left off →':'接着上次的步骤做 →';}}catch{}}
</script>
<style>.start-home{padding-top:36px}.start-home h1{white-space:pre-line;font-size:clamp(32px,4vw,50px);line-height:1.28;max-width:680px;margin:24px 0}.home-intro{font-size:16px;line-height:1.9;color:#64748b;max-width:530px;margin-bottom:30px}.home-route{display:inline-block;margin:16px 22px;font-size:13px}.project-preview{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center;border-top:1px solid #e2e8f0;margin-top:64px;padding-top:32px}.preview-label{font-size:10px;letter-spacing:.08em;color:#64748b}.project-preview h2{font-size:20px;margin:18px 0}.project-preview p,.project-preview a{font-size:13px;color:#64748b;line-height:1.8}.journal-mock{background:#fff;border:1px solid #dce3ec;border-radius:12px;padding:20px;transform:rotate(-2deg);box-shadow:0 12px 32px #263b5710;font-size:12px}.mock-dots{font-size:8px;color:#a7b2c4;margin-bottom:22px}.mock-dots span{float:right;font-size:10px}.journal-mock strong{font-size:14px}.mock-input{background:#f5f7fa;padding:14px 10px;margin:14px 0;color:#64748b;border-radius:5px}.mock-save{display:inline-block;background:#243f65;color:white;border-radius:5px;padding:8px 14px}.mock-note{border-top:1px solid #e2e8f0;margin-top:20px;padding-top:12px;color:#3b8b6a}@media(max-width:600px){.start-home{padding-top:10px}.project-preview{grid-template-columns:1fr;margin-top:36px;gap:24px}.journal-mock{transform:none}.home-route{margin-left:0}.start-home>.learn-primary{width:auto}}
</style>
