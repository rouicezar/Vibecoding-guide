---
import {demoDocument} from '../demos/document';
import dictionary from '../data/dictionary.json';
import {lessonFor,nativeDemoIds,demoLevel} from '../data/demo-lessons';
import {t,type Locale} from '../data/site';
const {id,locale}=Astro.props as {id:string;locale:Locale};
const available=nativeDemoIds.includes(id);
const entry=dictionary.entries.find(e=>e.id===id)!;
const lesson=lessonFor(entry);
const level=demoLevel(id);
---
<section class="demo-lesson"><h2>{t(level==='visual'?['观察外观与信息层次','Observe appearance and hierarchy']:['亲手试一下，再决定是否使用','Try it before choosing'],locale)}</h2><p><strong>{t(['怎么试：','Try: '],locale)}</strong>{t(lesson.action,locale)}</p><p><strong>{t(['看什么：','Observe: '],locale)}</strong>{t(lesson.check,locale)}</p>{!available&&<p class="small muted">{t(level==='visual'?['这是外观示意，没有连接数据服务。','This is a visual reference without a data service.']:level==='simplified'?['这是简化示例，只帮助理解基本动作；完整编辑器、系统手势与业务能力仍需在项目中实现。','This simplified example demonstrates basic behavior; full editors, system gestures and business capabilities require implementation.']:['本地练习 · 重新开始会清空示例状态，不会修改项目资料。','Local exercise · restarting clears sample state without changing project data.'],locale)}{locale==='en'&&' Some preserved sample labels are in Chinese.'}</p>}</section>
{available?<div class="component-demo" data-demo={id}>
<p class="small muted">{t(['交互示例 · 不连接真实业务','Interactive example · no real business action'],locale)}</p>
{id.startsWith('tabs-')&&<><div role="tablist" aria-label={t(['示例内容','Example sections'],locale)}>{[['概览','Overview'],['账单','Billing'],['设置','Settings']].map((label,i)=><button role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{t(label as any,locale)}</button>)}</div>{[['项目概览','Project overview'],['暂无账单','No bills yet'],['通知设置','Notification settings']].map((text,i)=><div id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i!==0} tabindex="0">{t(text as any,locale)}</div>)}</>}
{id==='btn-primary'&&<button class="button primary" data-demo-action>{t(['保存示例','Save example'],locale)}</button>}
{id==='in-text'&&<label>{t(['姓名','Name'],locale)}<input data-text-input type="text" aria-describedby="text-error" placeholder={t(['王小明','Jane Doe'],locale)} maxlength="50"/><span id="text-error" hidden>{t(['名称不能为空。','Name must not be empty.'],locale)}</span></label>}
{id==='sel-single'&&<label>{t(['选择水果','Choose a fruit'],locale)}<select><option>{t(['苹果','Apple'],locale)}</option><option>{t(['橙子','Orange'],locale)}</option></select></label>}
{id==='sel-combo'&&<label>{t(['搜索城市','Search cities'],locale)}<input role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="flavor-list" autocomplete="off" data-combo/><ul role="listbox" id="flavor-list" hidden>{[['北京','Beijing'],['上海','Shanghai'],['广州','Guangzhou']].map((label,i)=><li role="option" id={`flavor-${i}`} aria-selected="false" data-option>{t(label as any,locale)}</li>)}</ul><span data-combo-value role="status"></span><span data-combo-empty hidden>{t(['没有匹配，换个词试试','No match; try another word'],locale)}</span></label>}
{id==='ck-switch'&&<label><input type="checkbox" role="switch" checked/>{t(['接收提醒','Notifications'],locale)}</label>}
{id==='sl-h'&&<label>{t(['数量','Quantity'],locale)}<input type="range" min="0" max="100" value="50"/><output>50</output></label>}
{(id==='ov-modal'||id==='ov-drawer')&&<><button class="button primary" data-demo-open>{t(['打开示例','Open example'],locale)}</button><dialog class:list={['sample-dialog',{drawer:id==='ov-drawer'}]} aria-labelledby="demo-dialog-title"><h3 id="demo-dialog-title">{t(id==='ov-modal'?['编辑项目','Edit project']:['详情','Details'],locale)}</h3><p>{t(['可按 Escape 关闭，关闭后回到打开按钮。','Press Escape to close and return focus to the opener.'],locale)}</p><form method="dialog">{id==='ov-modal'&&<><label>{t(['项目名称','Project name'],locale)}<input value={t(['预约页面','Reservation page'],locale)}/></label><button class="button primary" value="save">{t(['保存','Save'],locale)}</button><button class="button" value="cancel">{t(['取消','Cancel'],locale)}</button></>}<button class="button" value="close">{t(['关闭','Close'],locale)}</button></form></dialog></>}
{id==='fb-toast'&&<button class="button" data-demo-action>{t(['显示提示','Show notification'],locale)}</button>}
{id==='da-table'&&<div style="overflow:auto"><table><caption>{t(['预约示例','Example reservations'],locale)}</caption><thead><tr><th>{t(['编号','ID'],locale)}</th><th>{t(['状态','Status'],locale)}</th></tr></thead><tbody><tr><td>001</td><td>{t(['待确认','Pending'],locale)}</td></tr><tr><td>002</td><td>{t(['已确认','Confirmed'],locale)}</td></tr></tbody></table></div>}
<p class:list={[{'sample-toast':id==='fb-toast'}]} role="status" data-demo-status data-message={t(['示例操作已触发，没有保存或发送真实资料。','Example action triggered; no real data was saved or sent.'],locale)}></p>
{['tabs-underlined','tabs-sliding','btn-primary','in-text','sel-single','sel-combo','ck-switch','sl-h'].includes(id)&&<label class="disabled-control"><input type="checkbox" data-disable-demo/>{t(['查看禁用状态','Show disabled state'],locale)}</label>}
</div>:<iframe class="isolated-demo" title={`${entry.en} · ${t(['组件示例','Component example'],locale)}`} sandbox="allow-scripts" srcdoc={demoDocument(entry,locale)} loading="lazy"/>}

<script>
const host=document.querySelector<HTMLElement>('[data-demo]');
if(host){
 const bar=host.querySelector<HTMLElement>('[role=tablist]');
 const marker=host.dataset.demo==='tabs-sliding'?document.createElement('span'):null;
 if(marker&&bar){marker.className='sliding-marker';marker.setAttribute('aria-hidden','true');bar.append(marker);}
 const tabs=Array.from(host.querySelectorAll<HTMLButtonElement>('[role=tab]'));
 function selectTab(i:number){if(marker){marker.style.width=tabs[i].offsetWidth+'px';marker.style.transform=`translateX(${tabs[i].offsetLeft}px)`;}tabs.forEach((tab,j)=>{tab.setAttribute('aria-selected',String(i===j));tab.tabIndex=i===j?0:-1;document.getElementById(`panel-${j}`)!.hidden=i!==j;});}
 if(tabs.length){selectTab(0);new ResizeObserver(()=>selectTab(tabs.findIndex(t=>t.getAttribute('aria-selected')==='true'))).observe(bar!);}
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectTab(i));tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();selectTab(next);tabs[next].focus();});});
 let toastTimer:ReturnType<typeof setTimeout>;
 host.querySelector('[data-demo-action]')?.addEventListener('click',()=>{const status=host.querySelector<HTMLElement>('[data-demo-status]')!;status.textContent=status.dataset.message!;if(host.dataset.demo==='fb-toast'){clearTimeout(toastTimer);toastTimer=setTimeout(()=>status.textContent='',3000);}});
 host.querySelector<HTMLInputElement>('[type=range]')?.addEventListener('input',e=>host.querySelector('output')!.textContent=(e.target as HTMLInputElement).value);
 const dialog=host.querySelector<HTMLDialogElement>('dialog');const opener=host.querySelector<HTMLButtonElement>('[data-demo-open]');opener?.addEventListener('click',()=>dialog!.showModal());dialog?.addEventListener('close',()=>opener!.focus());dialog?.addEventListener('click',e=>{const rect=dialog.getBoundingClientRect();if(e.target===dialog&&(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom))dialog.close();});
 const textInput=host.querySelector<HTMLInputElement>('[data-text-input]');textInput?.addEventListener('blur',()=>{const invalid=!textInput.value.trim();textInput.setAttribute('aria-invalid',String(invalid));host.querySelector<HTMLElement>('#text-error')!.hidden=!invalid;});textInput?.addEventListener('input',()=>{textInput.removeAttribute('aria-invalid');host.querySelector<HTMLElement>('#text-error')!.hidden=true;});
 host.querySelector<HTMLInputElement>('[data-disable-demo]')?.addEventListener('change',e=>{const control=e.target as HTMLInputElement;host.querySelectorAll<HTMLInputElement|HTMLButtonElement|HTMLSelectElement>('input,button,select').forEach(el=>{if(el!==control)el.disabled=control.checked;});});
 const toggle=host.querySelector<HTMLInputElement>('[role=switch]');let dragStart=0,dragging=false;toggle?.addEventListener('pointerdown',e=>{dragStart=e.clientX;dragging=false;toggle.setPointerCapture(e.pointerId);});toggle?.addEventListener('pointermove',e=>{if(toggle.hasPointerCapture(e.pointerId)&&Math.abs(e.clientX-dragStart)>8){dragging=true;toggle.checked=e.clientX>dragStart;}});toggle?.addEventListener('click',e=>{if(dragging){e.preventDefault();dragging=false;}});

 const combo=host.querySelector<HTMLInputElement>('[data-combo]');const list=host.querySelector<HTMLElement>('[role=listbox]');const options=Array.from(host.querySelectorAll<HTMLElement>('[data-option]'));let active=-1;
 if(combo&&list){let selected='';const close=()=>{list.hidden=true;combo.setAttribute('aria-expanded','false');combo.removeAttribute('aria-activedescendant');active=-1;};const filter=()=>{options.forEach(o=>o.hidden=!o.textContent!.toLowerCase().includes(combo.value.toLowerCase()));list.hidden=false;combo.setAttribute('aria-expanded','true');host.querySelector<HTMLElement>('[data-combo-empty]')!.hidden=options.some(o=>!o.hidden);};const choose=(option:HTMLElement)=>{selected=option.textContent!;combo.value=selected;host.querySelector('[data-combo-value]')!.textContent=selected;options.forEach(o=>o.setAttribute('aria-selected',String(o===option)));close();};combo.addEventListener('input',()=>{active=-1;combo.removeAttribute('aria-activedescendant');filter();});combo.addEventListener('focus',filter);combo.addEventListener('blur',()=>setTimeout(()=>{combo.value=selected;close();host.querySelector<HTMLElement>('[data-combo-empty]')!.hidden=true;},100));options.forEach(o=>o.addEventListener('mousedown',e=>{e.preventDefault();choose(o);}));combo.addEventListener('keydown',e=>{const visible=options.filter(o=>!o.hidden);if(e.key==='Escape'){combo.value=selected;close();return;}if(e.key==='Enter'&&active>=0&&visible[active]){e.preventDefault();choose(visible[active]);return;}if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();filter();if(!visible.length)return;active=(active+(e.key==='ArrowDown'?1:-1)+visible.length)%visible.length;combo.setAttribute('aria-activedescendant',visible[active].id);options.forEach(o=>o.setAttribute('aria-selected',String(o===visible[active])));}});}
}
</script>
<style>.component-demo{padding:24px;border:1px solid #dce1e9;background:#fafbff;margin:20px 0;min-height:160px}.component-demo [role=tablist]{display:flex;gap:20px}.component-demo [role=tab]{border:0;border-bottom:2px solid transparent;padding:10px 0;background:none;color:inherit}.component-demo [role=tab][aria-selected=true]{border-color:#2563eb;color:#2563eb}.component-demo [role=tabpanel]{padding:20px 0}.component-demo input:not([type=checkbox]),.component-demo select{display:block;max-width:100%;padding:8px;margin:10px 0}.component-demo [role=option]{padding:8px;cursor:pointer}.component-demo [role=option][aria-selected=true]{background:#dbeafe}.component-demo ul{list-style:none;padding:0}.drawer{margin:0 0 0 auto;height:100dvh;max-height:100dvh;border-radius:0}.component-demo th,.component-demo td{padding:10px 24px;text-align:left;border-bottom:1px solid #ddd}.component-demo [role=tablist]{position:relative}.component-demo :global(.sliding-marker){position:absolute;left:0;bottom:0;height:2px;background:#2563eb;transition:transform 180ms,width 180ms}.component-demo[data-demo=tabs-sliding] [role=tab][aria-selected=true]{border-color:transparent}@media(prefers-reduced-motion:reduce){.component-demo :global(.sliding-marker){transition:none}}.component-demo [role=switch]{appearance:none;position:relative;display:inline-block;vertical-align:middle;width:42px;height:24px;border-radius:12px;background:#94a3b8;border:0;cursor:pointer}.component-demo [role=switch]::after{content:'';position:absolute;left:3px;top:3px;width:18px;height:18px;border-radius:50%;background:white;transition:transform 150ms}.component-demo [role=switch]:checked{background:#2563eb}.component-demo [role=switch]:checked::after{transform:translateX(18px)}.component-demo :disabled{opacity:.45;cursor:not-allowed}.disabled-control{display:block;border-top:1px solid #ddd;margin-top:18px;padding-top:12px;font-size:12px}.component-demo [aria-invalid=true]{border:1px solid #b91c1c}.component-demo #text-error{color:#b91c1c}.sample-toast:not(:empty){position:fixed;bottom:24px;right:24px;max-width:min(360px,calc(100vw - 48px));padding:14px;background:#172033;color:white;z-index:80;border-radius:6px}.sample-dialog[open]{animation:dialog-in 180ms ease-out}.sample-dialog.drawer[open]{animation:drawer-in 200ms ease-out}@keyframes dialog-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes drawer-in{from{transform:translateX(100%)}to{transform:none}}@media(prefers-reduced-motion:reduce){.sample-dialog[open]{animation:none}.component-demo [role=switch]::after{transition:none}}</style>

<style>.demo-lesson{margin-top:26px}.demo-lesson h2{font-size:22px}.demo-lesson p{font-size:15px;line-height:1.8;margin:8px 0}.isolated-demo{display:block;width:100%;height:380px;border:1px solid #dce5ec;border-radius:12px;background:white;margin:20px 0}</style>
