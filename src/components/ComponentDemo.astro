---
import {t,type Locale} from '../data/site';
const {id,locale}=Astro.props as {id:string;locale:Locale};
export const demoIds=['tabs-underlined','tabs-sliding','btn-primary','in-text','sel-single','sel-combo','ck-switch','sl-h','ov-modal','ov-drawer','fb-toast','da-table'];
const available=demoIds.includes(id);
---
{available?<div class="component-demo" data-demo={id}>
<p class="small muted">{t(['交互示例 · 不连接真实业务','Interactive example · no real business action'],locale)}</p>
{id.startsWith('tabs-')&&<><div role="tablist" aria-label={t(['示例内容','Example sections'],locale)}>{[['概览','Overview'],['账单','Billing'],['设置','Settings']].map((label,i)=><button role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{t(label as any,locale)}</button>)}</div>{[['项目概览','Project overview'],['暂无账单','No bills yet'],['通知设置','Notification settings']].map((text,i)=><div id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i!==0} tabindex="0">{t(text as any,locale)}</div>)}</>}
{id==='btn-primary'&&<button class="button primary" data-demo-action>{t(['保存示例','Save example'],locale)}</button>}
{id==='in-text'&&<label>{t(['项目名称','Project name'],locale)}<input type="text" placeholder={t(['填写一个名称','Enter a name'],locale)} maxlength="50"/></label>}
{id==='sel-single'&&<label>{t(['选择时段','Choose a time'],locale)}<select><option>{t(['上午','Morning'],locale)}</option><option>{t(['下午','Afternoon'],locale)}</option></select></label>}
{id==='sel-combo'&&<label>{t(['搜索口味','Search flavors'],locale)}<input role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="flavor-list" autocomplete="off" data-combo/><ul role="listbox" id="flavor-list" hidden>{[['巧克力','Chocolate'],['草莓','Strawberry'],['香草','Vanilla']].map((label,i)=><li role="option" id={`flavor-${i}`} aria-selected="false" data-option>{t(label as any,locale)}</li>)}</ul><span data-combo-empty hidden>{t(['没有匹配，换个词试试','No match; try another word'],locale)}</span></label>}
{id==='ck-switch'&&<label><input type="checkbox" role="switch"/>{t(['接收提醒','Receive reminders'],locale)}</label>}
{id==='sl-h'&&<label>{t(['数量','Quantity'],locale)}<input type="range" min="0" max="100" value="50"/><output>50</output></label>}
{(id==='ov-modal'||id==='ov-drawer')&&<><button class="button primary" data-demo-open>{t(['打开示例','Open example'],locale)}</button><dialog class:list={['sample-dialog',{drawer:id==='ov-drawer'}]} aria-labelledby="demo-dialog-title"><h3 id="demo-dialog-title">{t(['示例详情','Example details'],locale)}</h3><p>{t(['可按 Escape 关闭，关闭后回到打开按钮。','Press Escape to close and return focus to the opener.'],locale)}</p><form method="dialog"><button class="button">{t(['关闭','Close'],locale)}</button></form></dialog></>}
{id==='fb-toast'&&<button class="button" data-demo-action>{t(['显示提示','Show notification'],locale)}</button>}
{id==='da-table'&&<div style="overflow:auto"><table><caption>{t(['预约示例','Example reservations'],locale)}</caption><thead><tr><th>{t(['编号','ID'],locale)}</th><th>{t(['状态','Status'],locale)}</th></tr></thead><tbody><tr><td>001</td><td>{t(['待确认','Pending'],locale)}</td></tr><tr><td>002</td><td>{t(['已确认','Confirmed'],locale)}</td></tr></tbody></table></div>}
<p role="status" data-demo-status data-message={t(['示例操作已触发，没有保存或发送真实资料。','Example action triggered; no real data was saved or sent.'],locale)}></p>
</div>:<div class="example-box"><p>{t(['词条与原始描述已迁移。本词条的交互演示尚未迁移或验证，请按下方说明让 AI 制作后实际检查。','This entry and its original description have been migrated. Its interactive demo is not yet migrated or verified. Ask AI to build from the description and test the result.'],locale)}</p></div>}
<script>
const host=document.querySelector<HTMLElement>('[data-demo]');
if(host){
 const bar=host.querySelector<HTMLElement>('[role=tablist]');
 const marker=host.dataset.demo==='tabs-sliding'?document.createElement('span'):null;
 if(marker&&bar){marker.className='sliding-marker';marker.setAttribute('aria-hidden','true');bar.append(marker);}
 const tabs=Array.from(host.querySelectorAll<HTMLButtonElement>('[role=tab]'));
 function selectTab(i:number){if(marker){marker.style.width=tabs[i].offsetWidth+'px';marker.style.transform=`translateX(${tabs[i].offsetLeft}px)`;}tabs.forEach((tab,j)=>{tab.setAttribute('aria-selected',String(i===j));tab.tabIndex=i===j?0:-1;document.getElementById(`panel-${j}`)!.hidden=i!==j;});}
 if(tabs.length){selectTab(0);new ResizeObserver(()=>selectTab(tabs.findIndex(t=>t.getAttribute('aria-selected')==='true'))).observe(bar!);}
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectTab(i));tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();selectTab(next);tabs[next].focus();});});
 host.querySelector('[data-demo-action]')?.addEventListener('click',()=>{const status=host.querySelector<HTMLElement>('[data-demo-status]')!;status.textContent=status.dataset.message!;});
 host.querySelector<HTMLInputElement>('[type=range]')?.addEventListener('input',e=>host.querySelector('output')!.textContent=(e.target as HTMLInputElement).value);
 const dialog=host.querySelector<HTMLDialogElement>('dialog');const opener=host.querySelector<HTMLButtonElement>('[data-demo-open]');opener?.addEventListener('click',()=>dialog!.showModal());dialog?.addEventListener('close',()=>opener!.focus());
 const combo=host.querySelector<HTMLInputElement>('[data-combo]');const list=host.querySelector<HTMLElement>('[role=listbox]');const options=Array.from(host.querySelectorAll<HTMLElement>('[data-option]'));let active=-1;
 if(combo&&list){const close=()=>{list.hidden=true;combo.setAttribute('aria-expanded','false');combo.removeAttribute('aria-activedescendant');active=-1;};const filter=()=>{options.forEach(o=>o.hidden=!o.textContent!.toLowerCase().includes(combo.value.toLowerCase()));list.hidden=false;combo.setAttribute('aria-expanded','true');host.querySelector<HTMLElement>('[data-combo-empty]')!.hidden=options.some(o=>!o.hidden);};const choose=(option:HTMLElement)=>{combo.value=option.textContent!;options.forEach(o=>o.setAttribute('aria-selected',String(o===option)));close();};combo.addEventListener('input',()=>{active=-1;combo.removeAttribute('aria-activedescendant');filter();});combo.addEventListener('focus',filter);combo.addEventListener('blur',()=>setTimeout(close,100));options.forEach(o=>o.addEventListener('mousedown',e=>{e.preventDefault();choose(o);}));combo.addEventListener('keydown',e=>{const visible=options.filter(o=>!o.hidden);if(e.key==='Escape'){close();return;}if(e.key==='Enter'&&active>=0&&visible[active]){e.preventDefault();choose(visible[active]);return;}if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();filter();if(!visible.length)return;active=(active+(e.key==='ArrowDown'?1:-1)+visible.length)%visible.length;combo.setAttribute('aria-activedescendant',visible[active].id);options.forEach(o=>o.setAttribute('aria-selected',String(o===visible[active])));}});}
}
</script>
<style>.component-demo{padding:24px;border:1px solid #dce1e9;background:#fafbff;margin:20px 0;min-height:160px}.component-demo [role=tablist]{display:flex;gap:20px}.component-demo [role=tab]{border:0;border-bottom:2px solid transparent;padding:10px 0;background:none;color:inherit}.component-demo [role=tab][aria-selected=true]{border-color:#2563eb;color:#2563eb}.component-demo [role=tabpanel]{padding:20px 0}.component-demo input:not([type=checkbox]),.component-demo select{display:block;max-width:100%;padding:8px;margin:10px 0}.component-demo [role=option]{padding:8px;cursor:pointer}.component-demo [role=option][aria-selected=true]{background:#dbeafe}.component-demo ul{list-style:none;padding:0}.drawer{margin:0 0 0 auto;height:100dvh;max-height:100dvh;border-radius:0}.component-demo th,.component-demo td{padding:10px 24px;text-align:left;border-bottom:1px solid #ddd}.component-demo [role=tablist]{position:relative}.component-demo :global(.sliding-marker){position:absolute;left:0;bottom:0;height:2px;background:#2563eb;transition:transform 180ms,width 180ms}.component-demo[data-demo=tabs-sliding] [role=tab][aria-selected=true]{border-color:transparent}@media(prefers-reduced-motion:reduce){.component-demo :global(.sliding-marker){transition:none}}</style>
