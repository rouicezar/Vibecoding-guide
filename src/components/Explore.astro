---
import {report,ideas,research,repos,groups,repoLessons,licenseNotes,ideaPrompt} from '../data/explore';
import {t,url,type Locale} from '../data/site';
import PromptTemplate from './PromptTemplate.astro';
import Icon from './Icon.astro';
const {locale,path}=Astro.props as {locale:Locale;path:string};
const L=(a:string,b:string)=>t([a,b],locale);
const part=path.split('/');
const chapter=report.chapters.find(c=>c.id===part[2]);
const supplement=research.chapters.find(c=>c.id===part[2]);
const idea=ideas.find(i=>i.id===part[2]);
const titles:Record<string,string>={report:L('AI工具与收益：全景调研','AI tools and revenue research'),ideas:L('50个可以尝试的方向','50 directions to explore'),projects:L('看看别人做出的项目','Explore existing projects'),evidence:L('资料、来源与阅读方法','Sources and research method')};
const title=idea?.title??chapter?.title??titles[part[1]]??L('大家在做什么','What people are building');
---
<div class="explore">
<nav class="explore-crumb"><a href={url(locale,'explore')}>{L('大家在做什么','Explore')}</a>{part[1]&&<><span>/</span><a href={url(locale,`explore/${part[1]}`)}>{titles[part[1]]}</a></>}</nav>
<p class="explore-eyebrow">{L('看见可能 · 理解条件 · 从小处尝试','OBSERVE · UNDERSTAND · TRY SMALL')}</p>
<h1>{title}</h1>
<aside class="revenue-notice" aria-label={L('本站收益提醒','Revenue notice')}><Icon name="info" size={24}/><div><strong>{L('有收益的可能，不等于一定有收益。','Revenue is possible, never guaranteed.')}</strong><p>{L('案例不是承诺，项目点子是待验证的假设。你可能没有收入，也可能投入时间和费用后亏损。本站建议先做小范围需求验证，再决定是否继续投入。','Cases are not promises. Ideas are hypotheses: you may earn nothing or lose time and money. Validate a small need before investing more.')}</p></div></aside>
{locale==='en'&&<p class="language-note">The navigation is bilingual. This research edition, source report, additions and idea templates are in Chinese, explicitly marked below; a full English translation is not yet available.</p>}
<nav class="explore-tabs" aria-label={L('调研板块','Research sections')}>{[['report',L('完整调研','Report')],['projects',L('GitHub项目','GitHub projects')],['ideas',L('50个方向','50 ideas')],['evidence',L('来源与方法','Sources')]].map(([p,n])=><a aria-current={part[1]===p?'page':undefined} href={url(locale,`explore/${p}`)}>{n}</a>)}</nav>
{path==='explore'?<>
<section class="explore-intro" lang="zh-CN"><div><h2>先看看别人，<br/>再找到自己的起点。</h2><p>用AI做产品、接交付、整理内容、提高工作效率……同样是使用AI，用户、成本和收益方式可以完全不同。</p><a class="explore-primary" href={url(locale,'explore/ideas')}>还没方向？看看50个点子 <Icon name="arrow" size={18}/></a></div><div class="opportunity-flow"><div><Icon name="users"/><strong>谁遇到了问题</strong><small>找到你能接触的人</small></div><span>↓</span><div><Icon name="tool"/><strong>做一个小解决方案</strong><small>先完成一件可检查的事</small></div><span>↓</span><div><Icon name="checklist"/><strong>看是否被持续使用</strong><small>再验证付费意愿与成本</small></div></div></section>
<section lang="zh-CN"><h2>按你现在的问题进入</h2><div class="explore-grid">{[['report','大家在用AI做什么？','从10个主题了解实际案例、收益方式、适用条件与前景。'],['projects','有没有真实产品可以看？','19个GitHub项目，观察功能与交互，不把开源热度当收益。'],['ideas','我没有想法，从哪里开始？','10组场景、50个方向：第一版、验证方法、可能收益与停止条件。'],['evidence','数字可信吗，怎么看前景？','了解调研依据，分清官方资料、案例当事人自述与本站判断。']].map(([p,h,d])=><a class="explore-card" href={url(locale,`explore/${p}`)}><Icon name={p==='projects'?'layers':p==='ideas'?'idea':'book'} size={26}/><h3>{h}</h3><p>{d}</p><span>展开看看 →</span></a>)}</div></section>
<section lang="zh-CN"><h2>哪些值得试，哪些先放一放？</h2><div class="compare-grid"><div><h3>值得小规模验证</h3><p>认识目标用户；问题反复出现；结果可以人工检查；失败可以恢复；费用在承受范围内。</p></div><div><h3>先不要急着做</h3><p>只有收益截图；找不到用户；现有免费工具已经够用；依赖无人审核的高风险操作；维护成本还没算。</p></div></div><p class="local-note">这是本站的选题判断方法，不是对某个行业能否获利的确定预测。</p></section>
</>:part[1]==='report'&&!chapter?<section lang="zh-CN"><h2>AI工具与收益：本站全景调研</h2><p>这份调研帮助你了解大家在做什么、收益从哪里来，以及尝试前需要具备哪些条件。先选一个感兴趣的主题，再展开具体案例。A/B/C/D表示资料证据等级，不代表收益已通过独立审计。</p><div class="chapter-list">{report.chapters.map((c,n)=><a href={url(locale,`explore/report/${c.id}`)}><span>{String(n+1).padStart(2,'0')}</span><div><h3>{c.title}</h3><p>{research.chapters[n].title}</p></div><Icon name="arrow" size={20}/></a>)}</div><details><summary>调研概览与结语</summary><p class="source-label">调研阅读提示 · 统计口径与收益证据请结合各章说明查看</p><div class="source-report" set:html={report.intro}/><div class="source-report" set:html={report.footer}/></details></section>
:chapter&&supplement?<section lang="zh-CN"><p class="source-label">本站调研 · 发布：2026-09-26 · 更新：2026-09-27</p><h2>{supplement.title}</h2><p>{supplement.findings}</p><div class="research-note"><strong>这些数据该怎样理解</strong><p>{supplement.caveat}</p></div><div class="compare-grid"><div><h3>怎么判断与验证</h3><p>{supplement.method}</p></div><div><h3>前景与适用条件 · 本站判断</h3><p>{supplement.outlook}</p></div></div><details><summary>查看本章资料来源</summary>{research.sources.filter(s=>supplement.sources.includes(s.id)).map(s=><p><a href={s.url} target="_blank" rel="noopener">{s.title} ↗</a> · {s.type}<br/>{s.note}</p>)}</details><h2>案例与详细分析</h2><p class="source-label">以下案例用于理解业务做法。历史费率、收益数字与评价请结合记录时间和证据说明阅读，不代表当前统一规则或收益承诺。</p><div class="source-report" set:html={chapter.html}/><div class="explore-next"><a href={url(locale,'explore/report')}>← 返回全部章节</a><a href={url(locale,'explore/ideas')}>从案例走向自己的点子 →</a></div></section>
:part[1]==='projects'?<section lang="zh-CN"><h2>观察别人解决问题的方法</h2><p>这些仓库确实存在相应产品功能。本站根据公开仓库资料介绍其功能，尚未逐一部署验证；收录不代表项目有收益或由AI开发。先看截图与文档，再决定是否适合；不用先下载、安装或理解全部代码。</p><div class="repo-guide"><span>看用户与功能</span><b>→</b><span>只选一个可借鉴动作</span><b>→</b><span>回到自己的小项目</span></div><div class="explore-grid">{repos.map(r=><article class="explore-card"><h3><a href={r.url} target="_blank" rel="noopener">{r.repo} ↗</a></h3><p>{repoLessons[r.repo]}</p><details><summary>状态、许可与参考方向</summary><p>核对：{r.checked} · {r.archived?'已归档':'未归档'} · 最近推送：{r.pushedAt.slice(0,10)}。活跃不等于质量或安全保证。</p><p>许可：{licenseNotes[r.repo]??`${r.license}（GitHub元数据标识，仍需核对文件与依赖）`}</p><a href={`${r.url}/tree/${r.branch}`} target="_blank" rel="noopener">查看仓库文件与许可 ↗</a><ul>{ideas.filter(i=>i.repo===r.repo).map(i=><li><a href={url(locale,`explore/ideas/${i.id}`)}>{i.title}</a></li>)}</ul></details></article>)}</div></section>
:part[1]==='ideas'&&!idea?<section lang="zh-CN"><h2>选一个你能找到用户的场景</h2><p>50个方向不是已验证的商业机会。GitHub参考证明“有人做过相邻的功能”，不证明你的细分人群愿意付费。入门也需要跟随学习路线完成测试。</p><div class="idea-filters"><label>按场景筛选<select id="idea-group"><option value="">全部10组</option>{groups.map(g=><option>{g}</option>)}</select></label><label>搜索用户或问题<input id="idea-query" type="search" placeholder="例如：花店、表格、照片"/></label></div><p id="idea-count" role="status">共50个方向</p>{groups.map((g,idx)=><details class="idea-group" data-idea-group={g}><summary><span class="group-number">{String(idx+1).padStart(2,'0')}</span>{g} · 5个方向</summary><div class="explore-grid">{ideas.filter(i=>i.group===g).map(i=><a class="explore-card idea-card" data-idea-search={`${i.title} ${i.audience} ${i.problem}`} href={url(locale,`explore/ideas/${i.id}`)}><small>{String(i.number).padStart(2,'0')} · {i.level}练习</small><h3>{i.title}</h3><p>{i.audience} · {i.problem}</p><span>看第一版与验证方法 →</span></a>)}</div></details>)}</section>
:idea?<section lang="zh-CN"><p class="source-label">方向 {idea.number} / 50 · {idea.group} · {idea.level}练习 · 尚未验证收益</p><p class="idea-lead">为{idea.audience}，解决“{idea.problem}”的问题。</p><div class="compare-grid"><div><h2>第一版做什么</h2><p>{idea.mvp}。</p><h3>暂时不做</h3><p>{idea.exclude}。</p></div><div><h2>怎样才算能用</h2><p>{idea.check}。</p><h3>先做这一件事</h3><p>{idea.first}。</p></div></div><details open><summary>谁可能付费，为什么？</summary><p>可能方式：{idea.revenue}。付费对象首先应是直接获得便利的人或管理者，不假定使用者和付款人永远相同。</p><p>有尝试价值的条件：{idea.fit}。不适合的情况：{idea.notFit}。</p><p>让用户比较现有办法与这个工具：完成任务省了多少时间、减少了什么错误、是否愿再用一次。若免费办法已足够，或用户不愿改变习惯，暂停收费假设。</p></details><details><summary>怎么找到第一批试用者，判断要不要继续？</summary><ol><li>{idea.first}。先获得试用意愿，不群发、不购买名单。</li><li>约3位符合人群的人使用同一小版本；记录他们能否独立完成“{idea.check}”。3位只是起步安排，不是有效市场统计。</li><li>询问上次问题怎么解决、现在花多少时间、什么条件下愿付费；不诱导对方认可你的点子。</li><li>有人复用且指出具体价值，再讨论小范围收费试点与维护承诺；没人需要时先改人群或问题，不靠加功能挽救。</li></ol></details><details><summary>成本、难点与第二阶段</summary><p>{idea.level==='入门'?'可优先做本地或单用户网页原型，先不用模型API和自动化支付。':'涉及共享状态、文件或外部服务，需在学习路线里补充权限、失败处理和交付验证。'} AI可以帮助开发，但运行中的产品不一定需要AI。</p><p>核算工具订阅、域名/托管、存储、模型调用（如需）、人工测试、获客、退款与售后；先填实际预算上限，不承诺零成本。只有跨设备同步、多人协作或模型能力被用户明确需要时再增加。</p><p>继续条件：核心流程稳定、用户反复使用、收费覆盖持续交付成本。暂停条件：{idea.notFit}，或维护和数据风险超出能力。</p></details><details><summary>看看已有项目，借鉴哪一部分？</summary><p>{repoLessons[idea.repo]}</p><a href={`https://github.com/${idea.repo}`} target="_blank" rel="noopener">{idea.repo} ↗</a><p>这是相邻功能参考，不是该项目的收入案例；不要求新手复制整个仓库。先看许可、文档、截图和用户反馈。</p></details><h2>把这个方向改成你自己的项目</h2><p>已有方向与边界已带入，只补充真实用户情况、设备和预算。确认后复制给AI先澄清，不会直接开始开发。</p><PromptTemplate id={`explore-${idea.id}`} title={['整理这个方向的项目描述','Adapt this project idea']} locale={locale} prompt={[ideaPrompt(idea),ideaPrompt(idea)]}/><a class="explore-primary" href={url(locale,'learn/idea')}>带着描述，从第1步开始做 <Icon name="arrow" size={18}/></a><p class="local-note">在第1步的想法草稿中粘贴你确认的材料；此入口不覆盖你原有项目。</p><a href={url(locale,'explore/ideas')}>← 返回50个方向</a></section>
:<section lang="zh-CN"><h2>读数字之前，先读口径</h2><div class="explore-grid">{[['收入≠利润','收入还需要扣平台费、算力、人工、退款、获客与税费。'],['MRR≠已到账年收入','MRR是月度经常性收入指标；ARR常按年化计算，不能保证未来持续。'],['GMV≠你的收益','商品成交规模不等于卖家利润，也不等于内容作者佣金。'],['个例≠成功概率','案例存在、工具能做、你能交付、客户愿付费，是四个不同问题。']].map(([h,p])=><div class="explore-card"><h3>{h}</h3><p>{p}</p></div>)}</div><h2>本站调研的方法与范围</h2><p>本站围绕10个主题调研AI工具的使用场景与收益方式，重点核对平台需求、费用、案例口径、项目功能和许可。案例依据包括官方资料、公开采访和当事人自述；无法独立核实的收益会明确说明。50个方向是供你验证的项目建议，不是收益榜单。</p>{research.sources.map(s=><details><summary>{s.title} · {s.type}</summary><p>{s.note}</p><p>核对日期：{s.checked}</p><a href={s.url} target="_blank" rel="noopener">阅读原始来源 ↗</a></details>)}<h2>调研资料下载</h2><p>你可以下载本站调研资料继续阅读。资料记录了调研时的案例与判断；历史数字和待核实信息请结合本页及各章的证据说明使用。</p><ul><li><a href="/research/report-original.html.txt" download>本站调研报告（HTML文本文件）</a></li>{['01_intl_tools_money.md','02_china_tools_money.md','03_freelance_market.md','04_indie_hacker_saas.md','05_content_edu_enterprise.md'].map(f=><li><a href={`/research/${f}`} download>{f}</a></li>)}</ul><p class="local-note">文件校验值：{report.sha256}</p><a href={url(locale,'explore/report')}>阅读分章节完整版 →</a></section>}
</div>
<script>
const group=document.querySelector<HTMLSelectElement>('#idea-group'),query=document.querySelector<HTMLInputElement>('#idea-query');
function filterIdeas(){let count=0;document.querySelectorAll<HTMLDetailsElement>('[data-idea-group]').forEach(section=>{let visible=0;section.querySelectorAll<HTMLElement>('[data-idea-search]').forEach(card=>{const match=(!group?.value||section.dataset.ideaGroup===group.value)&&(!query?.value||card.dataset.ideaSearch!.toLowerCase().includes(query.value.trim().toLowerCase()));card.hidden=!match;if(match){count++;visible++;}});section.hidden=visible===0;section.open=Boolean(group?.value||query?.value.trim());});const status=document.querySelector('#idea-count');if(status)status.textContent=count?`找到${count}个方向`:'没有匹配的方向，试试其他词或清空筛选。';}
group?.addEventListener('change',filterIdeas);query?.addEventListener('input',filterIdeas);
</script>
<style>
.explore{max-width:1240px;margin:0 auto;padding:12px 0 60px}.explore-crumb,.explore-tabs{display:flex;gap:16px;flex-wrap:wrap;font-size:14px}.explore-crumb{color:#627589;margin-bottom:32px}.explore-eyebrow{font-size:12px;letter-spacing:.15em;color:#438881}.explore h1{font-size:clamp(30px,4vw,52px);line-height:1.25;margin:16px 0 26px}.explore h2{font-size:26px;margin:32px 0 18px}.explore h3{font-size:18px;margin:0 0 10px}.explore p{font-size:16px;line-height:1.85}.revenue-notice{display:flex;gap:15px;align-items:flex-start;padding:19px 22px;border:1px solid #dca86c;border-radius:12px}.revenue-notice>svg{flex-shrink:0;color:#ac6427}.revenue-notice strong{font-size:18px;color:#875226}.revenue-notice p{margin:5px 0 0;font-size:14px;color:#5d6572}.explore-tabs{padding:22px 0;border-bottom:1px solid #e0e7ed;margin-bottom:30px}.explore-tabs a{padding:8px 15px;border:1px solid #d6e1e9;border-radius:22px;text-decoration:none}.explore-tabs [aria-current=page]{border-color:#398a82;color:#266c68}.explore-intro{display:grid;grid-template-columns:1.3fr 1fr;gap:52px;align-items:center;padding:10px 0 40px}.explore-intro h2{font-size:clamp(28px,3.2vw,42px);line-height:1.45;margin-top:0}.explore-primary{display:inline-flex;align-items:center;gap:12px;border:1px solid #39847e;color:#2c746e;border-radius:9px;padding:13px 18px;text-decoration:none;margin:14px 0}.opportunity-flow{display:grid;text-align:center}.opportunity-flow>div{display:grid;grid-template-columns:auto 1fr;gap:8px 15px;text-align:left;border:1px solid #c0d8d3;padding:18px 24px;border-radius:12px}.opportunity-flow svg{grid-row:span 2;color:#428783}.opportunity-flow small{color:#718296}.opportunity-flow>span{color:#98a9b7;margin:8px}.explore-grid,.compare-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.explore-card{border:1px solid #d7e2e8;border-radius:13px;padding:24px;min-width:0;text-decoration:none;color:inherit;transition:border-color .2s,transform .2s}.explore-card:hover{border-color:#6daba2}.explore-card>svg{color:#438d85;margin-bottom:16px}.explore-card p{color:#607287;font-size:15px;margin:10px 0 16px}.explore-card span,.explore-card small{color:#367d77;font-size:13px}.compare-grid>div{padding:22px;border-top:2px solid #70aaa0}.compare-grid>div+div{border-color:#ca9b62}.compare-grid h2{margin-top:0;font-size:21px}.chapter-list>a{display:flex;gap:22px;align-items:center;padding:23px 0;border-bottom:1px solid #dde5ed;text-decoration:none}.chapter-list>a>span{font-size:22px;color:#45867f}.chapter-list>a>div{flex:1}.chapter-list p{font-size:14px;color:#6a7b8c;margin:0}.explore details{border-bottom:1px solid #e0e7ed;padding:6px 0}.explore summary{cursor:pointer;padding:20px 0;font-size:16px;font-weight:600}.explore details p{font-size:15px}.research-note{border:1px solid #c3d7e4;border-radius:10px;padding:20px}.research-note p{margin-bottom:0}.source-label,.language-note{font-size:13px!important;color:#718092}.repo-guide{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin:25px 0;color:#44867f}.idea-filters{display:flex;gap:18px;flex-wrap:wrap;margin:24px 0}.idea-filters label{display:grid;gap:8px;font-size:14px;flex:1;min-width:200px}.idea-filters input,.idea-filters select{padding:12px;border:1px solid #b8cbd7;border-radius:8px;background:white;color:#273e54;font:inherit}.group-number{color:#45867f;font-size:18px;margin-right:13px}.idea-group{margin:32px 0}.idea-lead{font-size:21px!important}.explore-next{display:flex;justify-content:space-between;gap:20px;margin-top:30px}.explore [hidden]{display:none!important}.explore a{overflow-wrap:anywhere}.explore li{line-height:1.9;margin:8px 0}.explore .local-note{overflow-wrap:anywhere;font-size:13px}
