---
import { stepUrl } from '../data/nodes';
import { legacyLessons } from '../data/learning';
import { t, url, type Locale } from '../data/site';
import { practiceHref, type Practice } from '../data/practice';
import PromptTemplate from './PromptTemplate.astro';
import StageTroubleshooting from './StageTroubleshooting.astro';
const { locale, practice: p } = Astro.props as {
  locale: Locale;
  practice: Practice;
};
---

<header class="journey-intro">
  <p class="eyebrow">{t(['跟着操作', 'PRACTICAL GUIDE'], locale)}</p>
  <h1>{t(p.title, locale)}</h1>
  <p>{t(p.intro, locale)}</p>
</header>
{p.path === 'communicate/tools' && (
  <p>
    <a class="text-link" href={url(locale, 'tools')}>
      {t(
        [
          '还没选工具？先查看工具对比与价格 →',
          'No tool selected? Compare tools and pricing first →',
        ],
        locale,
      )}
    </a>
  </p>
)}
{p.path === 'communicate/setup' && (
  <div class="setup-shortcuts">
    <strong>
      {t(
        [
          '直接拿走：按顺序发给正在操作项目的 AI',
          'Ready to use: send in order to the AI working on the project',
        ],
        locale,
      )}
    </strong>
    <p>
      {t(
        [
          '第一份建立版本记录，第二份生成并验证规则。第二份已包含完整文件模板，不必另外拼接。先等当前任务完成并核对结果，再发送下一份。',
          'The first prompt establishes version history. The second creates and verifies instructions and includes the full file template. Check each result before sending the next prompt.',
        ],
        locale,
      )}
    </p>
    <a class="button primary" href="#template-git-setup">
      {t(['1 · 初始化 Git 提示词', '1 · Git setup prompt'], locale)}
    </a>
    <a class="button" href="#template-agents-create">
      {t(['2 · 生成项目规则提示词', '2 · Create project rules prompt'], locale)}
    </a>
    <a class="text-link" href="#template-agents-file">
      {t(
        ['查看 AGENTS.md 文件模板', 'Read the AGENTS.md file template'],
        locale,
      )}
    </a>
  </div>
)}
<div class="practice-input">
  <strong>
    {t(['开始前需要准备什么？', 'What do you need before starting?'], locale)}
  </strong>
  <p>{t(p.input, locale)}</p>
</div>
<nav
  class="anchor-nav"
  aria-label={t(['本页操作顺序', 'Steps on this page'], locale)}
>
  {p.steps.map((step, i) => (
    <a href={`#action-${i + 1}`}>
      {i + 1}. {t(step.title, locale)}
    </a>
  ))}
  <a href="#templates">
    {t(
      [
        '这一步需要复制或填写哪些材料？',
        'Which material should you copy or fill in here?',
      ],
      locale,
    )}
  </a>
</nav>
{p.steps.map((step, i) => (
  <section class="section" id={`action-${i + 1}`}>
    <h2>
      {i + 1}. {t(step.title, locale)}
    </h2>
    <p>{t(step.body, locale)}</p>
    {step.example && (
      <aside class="practice-example">
        <p>{t(step.example, locale)}</p>
      </aside>
    )}
    <p class="practice-check">
      <strong>
        {t(
          [
            '看到下面的结果后，再继续：',
            'Continue after you see this result: ',
          ],
          locale,
        )}
      </strong>
      {t(step.check, locale)}
    </p>
  </section>
))}
<section class="section" id="templates">
  <h2>
    {t(
      [
        '复制材料，按实际项目填写',
        'Copy the material and add actual project details',
      ],
      locale,
    )}
  </h2>
  {p.templates.map((template) => (
    <PromptTemplate
      id={template.id}
      title={template.title}
      prompt={template.text}
      kind={template.kind ?? 'prompt'}
      locale={locale}
    />
  ))}
</section>
{p.path === 'communicate/setup' && (
  <>
    <StageTroubleshooting stage="tell" locale={locale} />
    <StageTroubleshooting stage="environment" locale={locale} />
  </>
)}
{p.sources && (
  <details class="section">
    <summary>
      {t(
        [
          '工具差异与官方依据 · 2026-09-23 核对',
          'Tool differences and official references · checked 2026-09-23',
        ],
        locale,
      )}
    </summary>
    <p>
      {t(
        [
          '按钮名称、可用能力和费用可能随版本变化。按所用工具的实际界面与官方说明操作；本页没有代为注册、付费或发布。',
          'Labels, capabilities, and costs may change. Follow the actual tool and its official documentation. This guide does not register, purchase, or publish on behalf of the reader.',
        ],
        locale,
      )}
    </p>
    <ul>
      {p.sources.map((source) => (
        <li>
          <a href={source.href}>{source.label}</a>
        </li>
      ))}
    </ul>
  </details>
)}
<div class="practice-next">
  <p>
    {t(
      [
        '完成上面的检查后再继续；遇到失败，保留报错原文交给当前 AI 对话处理。',
        'Continue after the checks pass. If a step fails, bring the exact error back to the current AI conversation.',
      ],
      locale,
    )}
  </p>
  <a class="button primary" href={practiceHref(locale, p.next)}>
    {t(p.nextLabel, locale)} →
  </a>
  <a href={stepUrl(locale, legacyLessons[p.stage])}>
    {t(['返回本步路线', 'Return to this journey step'], locale)}
  </a>
</div>
<style>
  .practice-input {
    padding: 16px 0;
    border-block: 1px solid #e2e8f0;
  }
  .practice-input p {
    margin-bottom: 0;
  }
  .practice-example {
    border-left: 0;
    border-radius: 8px;
    padding: 4px 16px;
    margin: 18px 0;
    background: #fffaf2;
  }
  .practice-check {
    padding-top: 10px;
    color: #334155;
  }
  .practice-next {
    border-top: 1px solid #e2e8f0;
    padding: 24px 0;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .practice-next p {
    width: 100%;
  }
  .section {
    scroll-margin-top: 85px;
  }
  .setup-shortcuts {
    padding: 20px;
    background: #f1f6fc;
    border: 1px solid #dce6f2;
    border-radius: 8px;
    margin: 20px 0;
  }
  .setup-shortcuts .button {
    margin: 8px 8px 8px 0;
  }
  .setup-shortcuts .text-link {
    display: block;
    margin-top: 8px;
  }
  :global(.prompt-template) {
    scroll-margin-top: 85px;
  }
</style>
