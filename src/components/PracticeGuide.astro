---
import {t,url,type Locale} from '../data/site';
import {practiceHref,type Practice} from '../data/practice';
import PromptTemplate from './PromptTemplate.astro';
const {locale,practice:p}=Astro.props as {locale:Locale;practice:Practice};
---
<header class="journey-intro"><p class="eyebrow">{t(['跟着操作','PRACTICAL GUIDE'],locale)}</p><h1>{t(p.title,locale)}</h1><p>{t(p.intro,locale)}</p></header>
{p.path==='communicate/tools'&&<p><a class="text-link" href={url(locale,'tools')}>{t(['还没选工具？先查看工具对比与价格 →','No tool selected? Compare tools and pricing first →'],locale)}</a></p>}
<div class="practice-input"><strong>{t(['开始前带上','Bring to this step'],locale)}</strong><p>{t(p.input,locale)}</p></div>
<nav class="anchor-nav" aria-label={t(['本页操作顺序','Steps on this page'],locale)}>{p.steps.map((step,i)=><a href={`#action-${i+1}`}>{i+1}. {t(step.title,locale)}</a>)}<a href="#templates">{t(['可复制材料','Copyable material'],locale)}</a></nav>
{p.steps.map((step,i)=><section class="section" id={`action-${i+1}`}><h2>{i+1}. {t(step.title,locale)}</h2><p>{t(step.body,locale)}</p>{step.example&&<aside class="practice-example"><p>{t(step.example,locale)}</p></aside>}<p class="practice-check"><strong>{t(['这样就能继续：','Ready to continue when: '],locale)}</strong>{t(step.check,locale)}</p></section>)}
<section class="section" id="templates"><h2>{t(['复制材料，按实际项目填写','Copy the material and add actual project details'],locale)}</h2>{p.templates.map(template=><PromptTemplate id={template.id} title={template.title} prompt={template.text} kind={template.kind??'prompt'} locale={locale}/>)}</section>
{p.sources&&<details class="section"><summary>{t(['工具差异与官方依据 · 2026-09-23 核对','Tool differences and official references · checked 2026-09-23'],locale)}</summary><p>{t(['按钮名称、可用能力和费用可能随版本变化。按所用工具的实际界面与官方说明操作；本页没有代为注册、付费或发布。','Labels, capabilities, and costs may change. Follow the actual tool and its official documentation. This guide does not register, purchase, or publish on behalf of the reader.'],locale)}</p><ul>{p.sources.map(source=><li><a href={source.href}>{source.label}</a></li>)}</ul></details>}
<div class="practice-next"><p>{t(['完成上面的检查后再继续；遇到失败，保留报错原文交给当前 AI 对话处理。','Continue after the checks pass. If a step fails, bring the exact error back to the current AI conversation.'],locale)}</p><a class="button primary" href={practiceHref(locale,p.next)}>{t(p.nextLabel,locale)} →</a><a href={`${url(locale)}#stage-${p.stage}`}>{t(['返回本步路线','Return to this journey step'],locale)}</a></div>
<style>.practice-input{padding:16px 0;border-block:1px solid #e2e8f0}.practice-input p{margin-bottom:0}.practice-example{border-left:3px solid #f28c18;padding:4px 16px;margin:18px 0;background:#fffaf2}.practice-check{padding-top:10px;color:#334155}.practice-next{border-top:1px solid #e2e8f0;padding:24px 0;display:flex;gap:16px;flex-wrap:wrap}.practice-next p{width:100%}.section{scroll-margin-top:85px}</style>
