---
import {phases,lessons,lessonPath,legacyLessons} from '../data/learning';
import {t,url,modules,type Locale} from '../data/site';
import StepVisual from './StepVisual.astro';
import PromptTemplate from './PromptTemplate.astro';
import '../styles/learning.css';
const {locale,path}=Astro.props as {locale:Locale;path:string};
const bits=path.split('/');
const lesson=lessons.find(l=>l.id===bits[1]);
const phase=phases.find(p=>p.id===(lesson?.phase??bits[2]));
const issue=lesson?.issues.find(i=>i.id===bits[3]);
const help=bits[2]==='help';
const index=lesson?lessons.indexOf(lesson):-1;
const next=lessons[index+1];
const knowledgeStage=lesson?.stage??Object.entries(legacyLessons).find(([,id])=>id===lesson?.id)?.[0]??({idea:'idea',prepare:'tell',scope:'scope',build:'build',check:'test',use:'launch'}[lesson?.phase??'idea']);
const label=(zh:string,en:string)=>t([zh,en],locale);
---
<div class="learning" data-learning data-lesson={lesson?.id} data-locale={locale}>
<nav class="lesson-crumb" aria-label={label('当前位置','Breadcrumb')}><a href={url(locale,'learn')}>{label('学习路线','Learning route')}</a>{phase&&<><span aria-hidden="true">/</span><a href={url(locale,`learn/stage/${phase.id}`)}>{t(phase.title,locale)}</a></>}{help&&lesson&&<><span aria-hidden="true">/</span><a href={url(locale,lessonPath(lesson.id))}>{t(lesson.title,locale)}</a></>}</nav>
{path==='library'?<><h1>{label('需要时，再来查','Resources, when needed')}</h1><p class="lesson-lead">{label('学习主线之外的工具、例子与参考资料。','Tools, examples, and reference material beyond the learning route.')}</p><div class="route-list">{modules.filter(m=>m.path).map(m=><a href={url(locale,m.path)}><span>{t(m.title,locale)}</span><span aria-hidden="true">↗</span></a>)}</div></>:!lesson?<><p class="eyebrow">{label('从想法到第一个小作品','FROM IDEA TO A FIRST PROJECT')}</p><h1>{phase?t(phase.title,locale):label('一次，只走一小步','One small step at a time')}</h1><p class="lesson-lead">{phase?t(phase.description,locale):label('先选一个阶段。进入后，每次只处理一个动作。','Choose a stage, then work on one action at a time.')}</p><div class="route-list">{phase?lessons.filter(l=>l.phase===phase.id).map((l,i)=><a href={url(locale,lessonPath(l.id))}><span class="route-number">{String(i+1).padStart(2,'0')}</span><span>{t(l.title,locale)}</span><span class="route-status" data-progress={l.id}>→</span></a>):phases.map((p,i)=><a href={url(locale,`learn/stage/${p.id}`)}><span class="route-number">{String(i+1).padStart(2,'0')}</span><span><strong>{t(p.title,locale)}</strong><small>{t(p.result,locale)}</small></span><span aria-hidden="true">→</span></a>)}</div><p class="local-note">{label('可以提前浏览，也可以返回重做。进度由本人确认，不代表网站已经检测作品。','Explore ahead or repeat any step. Progress is self-reported; this guide does not inspect the project.')}</p></>:help?<><p class="eyebrow">{label('卡住了，先解决这一件事','GET UNSTUCK')}</p><h1>{issue?t(issue.title,locale):label('现在遇到了什么？','What happened?')}</h1>{issue?<><div class="rescue-flow"><section><span class="step-tag">01</span><h2>{label('先看哪里','Check')}</h2><p>{t(issue.check,locale)}</p></section><section><span class="step-tag">02</span><h2>{label('这样处理','Try this')}</h2><p>{t(issue.action,locale)}</p></section><section class="success-check"><span class="step-tag">✓</span><h2>{label('恢复后应该看到','Expected recovery')}</h2><p>{t(issue.expected,locale)}</p></section></div>{issue.retry&&<a href={url(locale,lessonPath(issue.retry))}>{label('回到前面的准备步骤 →','Revisit the preparation step →')}</a>}<a class="learn-primary" href={url(locale,lessonPath(lesson.id))}>{label('返回刚才那一步，再试一次','Return to the original step and retry')} →</a></>:<div class="route-list">{lesson.issues.map(i=><a href={url(locale,`${lessonPath(lesson.id)}/help/${i.id}`)}>{t(i.title,locale)}<span>→</span></a>)}</div>}<details class="learn-details"><summary>{label('问题不在列表里','My problem is different')}</summary><p>{label('记下停在哪个操作、实际画面和报错原文。把下面这段发给当前项目里的 AI，并附上截图或原文。','Record the action, actual screen, and exact error. Send this to the AI in the current project with the screenshot or error.')}</p><PromptTemplate id="rescue" title={['请 AI 帮助排查','Ask AI for help']} locale={locale} prompt={[`我停在“${lesson.title[0]}”。预期结果：${lesson.expected[0]}。实际画面/报错：[在这里补充]。请先根据已有文件检查原因，一次只给一个可逆的处理动作，说明在哪里操作、恢复后应看到什么。不要重建项目，不要删除已有成果。`,`I am at “${lesson.title[1]}”. Expected: ${lesson.expected[1]}. Actual screen/error: [add here]. Inspect existing files first. Give one reversible action at a time, its location, and expected result. Do not recreate the project or delete existing work.`]}/></details></>:<><p class="eyebrow">{label('当前动作','CURRENT ACTION')} · {index+1} / {lessons.length}</p><h1>{t(lesson.title,locale)}</h1><div class="action-location"><span aria-hidden="true">◎</span><span>{t(lesson.where,locale)}</span></div>
<StepVisual id={lesson.id} locale={locale}/>
<ol class="lesson-actions">{lesson.actions.map(a=><li>{t(a,locale)}</li>)}</ol>
{lesson.id==='idea'&&<form class="idea-draft" data-draft-form><label for="idea-text">{label('想帮助谁，完成什么？','Who is it for, and what should it do?')}</label><textarea id="idea-text" name="idea" rows="3" placeholder={label('例如：给自己用，记录每天学到的东西。','For example: a personal daily learning journal.')}></textarea><details class="learn-details"><summary>{label('补充想法（可以以后再填）','Add details (optional for now)')}</summary><label for="later-text">{label('以后再做 / 现在不确定的事','Later / undecided')}</label><textarea id="later-text" name="later" rows="3"></textarea></details><div class="draft-tools"><button type="button" data-example>{label('填入练习示例','Use practice example')}</button><button type="button" data-export>{label('下载草稿与进度','Download draft and progress')}</button></div><details class="learn-details" data-export-fallback hidden><summary>{label('下载没有开始？展开复制备份','Download did not start? Copy the backup')}</summary><label for="draft-backup">{label('草稿与进度备份','Draft and progress backup')}</label><textarea id="draft-backup" readonly rows="7"></textarea></details></form>}
{lesson.id==='goal'&&<a class="learn-primary" href={`/examples/journal-${locale}.html`} target="_blank" rel="noopener">{label('试用成品示例 ↗','Try the finished example ↗')}</a>}
{lesson.prompt&&<details class="learn-details prompt-disclosure"><summary>{label('展开给 AI 的话 · 带上已保存的想法','Open the AI prompt · includes the saved idea')}</summary><PromptTemplate id={`learn-${lesson.id}`} title={['发到当前项目的 AI 对话','Send in the current project chat']} locale={locale} prompt={lesson.prompt}/></details>}
{lesson.source&&<a class="official-link" href={lesson.source} target="_blank" rel="noopener">{label('打开官方操作入口 ↗','Open the official instructions ↗')}</a>}
<section class="success-check"><h2><span aria-hidden="true">✓</span> {label('看到这个结果，才算完成','Check this before continuing')}</h2><p>{t(lesson.expected,locale)}</p></section>
<div class="lesson-footer"><a class="learn-help" href={url(locale,`${lessonPath(lesson.id)}/help`)}>{label('没做到 / 我卡住了','It didn’t work / I’m stuck')} →</a>{next&&lesson.id!=='delivery'&&<a class="learn-primary" data-complete={lesson.id} href={url(locale,lessonPath(next.id))}>{label('已核对，下一步','Checked, continue')} →</a>}{lesson.id==='delivery'&&<div><a class="learn-primary" data-complete={lesson.id} href={url(locale,'learn/maintain')}>{label('先自己用','Keep it personal')} →</a><a class="learn-help" data-complete={lesson.id} href={url(locale,'learn/publish')}>{label('准备公开分享','Prepare to publish')} →</a></div>}{!next&&<button class="learn-primary" data-finish={lesson.id}>{label('已核对，记录完成','Checked, mark complete')}</button>}</div>
{(lesson.sample||lesson.refs)&&<details class="learn-details"><summary>{label('看示例或查资料','Examples and reference')}</summary>{lesson.sample&&<p>{t(lesson.sample,locale)}</p>}{lesson.refs?.map(r=><p><a href={`${url(locale,r.path)}?lesson=${lesson.id}`}>{t(r.title,locale)} →</a></p>)}</details>}
</>}
{lesson&&!help&&<p class="local-note"><a href={url(locale,`roadmap/${knowledgeStage}`)}>{label('查看这一站的完整知识与路线位置 →','See the complete stage knowledge and roadmap →')}</a></p>}
<p class="local-note" data-learning-status role="status">{label('草稿与进度只保存在当前浏览器。','Draft and progress stay in this browser.')}</p>
</div>
<script>
import {initLearning} from '../scripts/learning';
initLearning();
</script>
