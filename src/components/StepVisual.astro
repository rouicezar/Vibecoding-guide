---
import {t,type Locale,type Copy} from '../data/site';
const {id,locale}=Astro.props as {id:string;locale:Locale};
const diagrams:Record<string,Copy[]>={
 idea:[['谁来用','Who'],['一件困难','One problem'],['一个结果','One outcome']],goal:[['写一句','Write'],['保存','Save'],['再打开','Reopen']],
 tool:[['官方入口','Official site'],['安装并登录','Install & sign in'],['项目界面','Project view']],folder:[['访达','Finder'],['文稿','Documents'],['新建文件夹','New folder']],
 'open-project':[['打开项目','Open project'],['选择文件夹','Choose folder'],['核对位置','Check location']],
 'first-file':[['发给 AI','Ask AI'],['tool-check.md','tool-check.md'],['亲手打开','Open it']],checkpoint:[['已有文件','Existing files'],['保存版本','Save version'],['约定规则','Agree on rules']],
 clarify:[['自己的想法','The idea'],['AI 一次一问','One question'],['逐项回答','Answer each']],scope:[['想做的事','Ideas'],['只留主流程','Core flow'],['其他以后做','Extras later']],
 requirements:[['确认范围','Agree scope'],['需求文件','Requirements'],['逐项核对','Review']], 'choose-stack':[['实际条件','Conditions'],['比较方案','Compare'],['确认一种','Choose one']],plan:[['拆成小任务','Small tasks'],['一次做一项','One at a time'],['每项可检查','Check each']],
 preview:[['AI 制作','AI builds'],['打开地址','Open address'],['看到页面','See page']],interface:[['指出一处','Pick one part'],['说明目标','Describe goal'],['对照画面','Compare']],save:[['输入内容','Write'],['点击保存','Save'],['刷新查看','Refresh']],flow:[['填写','Input'],['操作','Action'],['结果反馈','Feedback']],test:[['正常填写','Valid input'],['空白尝试','Try blank'],['检查反馈','Check response']],restart:[['关闭页面','Close page'],['原地址打开','Same address'],['记录仍在','Notes remain']],accept:[['真实场景','Real task'],['完整试用','Full test'],['记录结果','Keep evidence']],delivery:[['已经验收','Checked'],['自己使用','Personal'],['或公开分享','Or public']],publish:[['网页文件','Site files'],['Pages 发布','Publish Pages'],['新网址检查','Check URL']],maintain:[['原项目','Same project'],['读取交接','Read handoff'],['接着下一项','Next task']]
};
const nodes=diagrams[id]??diagrams.idea;
---
<figure class="step-visual">
{['folder','open-project','first-file'].includes(id)?<div class="file-demo"><div class="file-toolbar"><span aria-hidden="true">● ● ●</span><span>{id==='open-project'?t(['选择项目文件夹','Choose a project folder'],locale):t(['文稿','Documents'],locale)}</span></div><div class="file-tree"><span class="folder-shape" aria-hidden="true"></span><strong>learning-journal</strong>{id==='first-file'?<div class="file-child"><span aria-hidden="true">↳ ▤</span> tool-check.md <span class="file-open">{t(['双击打开','Open file'],locale)}</span></div>:<span class="file-open">{id==='folder'?'⇧ ⌘ N':t(['选择并打开','Select & open'],locale)}</span>}</div></div>:<div class="visual-flow">{nodes.map((n,i)=><><div class="visual-node"><span class="visual-icon" aria-hidden="true">{i===0?'◧':i===1?'◇':'✓'}</span><strong>{t(n,locale)}</strong></div>{i<2&&<span class="visual-arrow" aria-hidden="true">→</span>}</>)}</div>}
<figcaption>{t(['操作示意 · 非工具截图','Illustration · not an app screenshot'],locale)}</figcaption>
</figure>
<style>.step-visual{margin:24px 0;background:#f5f7fa;border:1px solid #e1e7ef;border-radius:10px;padding:24px 24px 12px}.step-visual figcaption{text-align:right;font-size:10px;color:#64748b;margin-top:14px}.visual-flow{display:flex;align-items:center;justify-content:space-between;gap:10px}.visual-node{display:flex;flex-direction:column;align-items:center;gap:12px;flex:1}.visual-icon{display:grid;place-items:center;width:44px;height:44px;background:#fff;border:1px solid #d3deeb;border-radius:10px;color:#3d689e;font-size:24px}.visual-node strong{font-size:13px;font-weight:500;text-align:center}.visual-arrow{color:#98a7bd}.file-demo{background:white;border:1px solid #dbe2ec;border-radius:8px;max-width:460px;margin:auto}.file-toolbar{display:flex;gap:20px;padding:10px 16px;border-bottom:1px solid #e4e8ee;font-size:11px;color:#64748b}.file-toolbar>span:first-child{color:#b1bdcc;font-size:9px}.file-tree{display:flex;align-items:center;gap:10px;padding:20px;flex-wrap:wrap;font-size:14px}.folder-shape{width:28px;height:20px;background:#bcd6f1;border-radius:3px;position:relative}.folder-shape:before{content:'';position:absolute;top:-4px;left:0;width:12px;height:5px;background:#bcd6f1;border-radius:3px}.file-open{margin-left:auto;font-size:11px;color:#466992}.file-child{width:100%;padding:14px 0 0 24px;font-size:13px;display:flex;gap:8px}.file-child>span:first-child{color:#8e9fb5}@media(max-width:450px){.step-visual{padding:20px 12px 10px}.visual-node strong{font-size:11px}.file-tree{padding:16px 10px}.file-child{padding-left:8px;font-size:12px}}
</style>
