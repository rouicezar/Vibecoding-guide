---
import {t,url,type Locale} from '../data/site';
import type {Guide} from '../data/action-guides';
import {journey} from '../data/journey';
import {troubleshooting} from '../data/troubleshooting';
import PromptTemplate from './PromptTemplate.astro';
const {locale,guide:g}=Astro.props as {locale:Locale;guide:Guide};
---
<header class="journey-intro"><p class="eyebrow">{g.id.toUpperCase()}</p><h1>{t(g.title,locale)}</h1><p>{t(g.intro,locale)}</p></header>
<nav class="anchor-nav"><a href="#actions">{t(['现在做什么','Actions'],locale)}</a><a href="#record">{t(['留下检查记录','Record results'],locale)}</a><a href="#problems">{t(['卡住怎么办','Troubleshooting'],locale)}</a><a href="#template">{t(['交给 AI 的材料','AI handoff'],locale)}</a></nav>
<section class="section" id="actions"><h2>{t(['按实际结果推进','Move forward using observed results'],locale)}</h2>{g.steps.map((s,i)=><article class="example-box"><h3>{i+1}. {t(s.title,locale)}</h3><p>{t(s.action,locale)}</p><p><strong>{t(['完成依据：','Evidence of completion: '],locale)}</strong>{t(s.check,locale)}</p><label class="check-item"><input type="checkbox"/>{t(['已亲手检查并在下方记录证据','Checked personally and recorded evidence below'],locale)}</label></article>)}<p class="small muted">{t(['勾选只是当前页面的个人标记，不是自动测试或持久保存，刷新会清空。','Checks are personal marks on this page, not automatic tests or saved records. Reloading clears them.'],locale)}</p></section>
<section class="section" id="record"><h2>{t(['填写本次记录','Write this run’s record'],locale)}</h2><p>{t(['把空白字段补齐，未做的项目写“待验证”。记录只留在当前页面，复制到项目资料后再关闭。','Fill each field and mark unexecuted checks as unverified. This record stays on the current page; copy it into project notes before closing.'],locale)}</p><label for="run-record">{t(['检查记录 · 可编辑','Editable check record'],locale)}</label><textarea id="run-record" rows="13">{t(g.record,locale)}</textarea><button class="button" id="copy-record" data-success={t(['记录已复制，请保存到项目资料。','Record copied. Save it in the project notes.'],locale)} data-failure={t(['复制失败，请手动选择记录文字复制。','Copy failed. Select and copy the record manually.'],locale)}>{t(['复制记录','Copy record'],locale)}</button><p role="status" id="record-status"></p></section>
<section class="section" id="problems"><h2>{t(['根据检查结果选择下一步','Choose the next step from the result'],locale)}</h2>{g.problems.map(p=><details class="example-box"><summary>{t(p.title,locale)}</summary><p>{t(p.body,locale)}</p></details>)}{g.id==='test'&&troubleshooting.map((p,i)=><details class="example-box" id={`problem-${i+1}`}><summary>{t(p.title,locale)}</summary><p>{t(p.check,locale)}</p><ul><li>{t(p.yes,locale)}</li><li>{t(p.no,locale)}</li></ul><p class="small muted">{t(['出口：按原步骤复测；通过则记录证据并继续，未通过则保留结果再排查，不标记完成。','Exit: rerun the original steps. On success, record evidence and continue. Otherwise retain results for further investigation and keep the task incomplete.'],locale)}</p></details>)}</section>
<section class="section" id="template"><PromptTemplate id={`guide-${g.id}`} title={['完整任务模板','Complete task template']} prompt={journey.find(s=>s.id===g.stage)!.prompt} locale={locale}/><a href={url(locale,g.next)}>{t(g.nextLabel,locale)} →</a><p><a href={`${url(locale)}#stage-${g.stage}`}>{t(['返回首页对应节点','Return to the matching journey stage'],locale)}</a></p></section>
<script>
const button=document.querySelector<HTMLButtonElement>('#copy-record');button?.addEventListener('click',async()=>{const status=document.querySelector('#record-status')!;try{await navigator.clipboard.writeText(document.querySelector<HTMLTextAreaElement>('#run-record')!.value);status.textContent=button.dataset.success!;}catch{status.textContent=button.dataset.failure!;}});
document.querySelector('#run-record')?.addEventListener('input',()=>document.querySelector('#record-status')!.textContent='');
</script>
<style>#run-record{display:block;width:100%;box-sizing:border-box;margin:12px 0;padding:14px;font:inherit;border:1px solid #9aa5b5;border-radius:6px;resize:vertical}.example-box{margin-bottom:16px}</style>
