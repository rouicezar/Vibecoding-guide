---
import {t,url,type Locale} from '../data/site';
import type {Guide} from '../data/action-guides';
import {journey} from '../data/journey';
import {troubleshooting} from '../data/troubleshooting';
import PromptTemplate from './PromptTemplate.astro';
const {locale,guide:g}=Astro.props as {locale:Locale;guide:Guide};
---
<header class="journey-intro"><p class="eyebrow">{g.id.toUpperCase()}</p><h1>{t(g.title,locale)}</h1><p>{t(g.intro,locale)}</p></header>
{g.id==='backend'&&<details class="section"><summary>{t(['要接 AI、支付或其他外部 API？先做这项准备','Connecting AI, payments or another API? Start here'],locale)}</summary><p>{t(['先确认本项目确实需要外部服务，再核对官方支持的用途、账号条件、用量与费用。使用测试环境和测试资料，真实付款或对外发送另行确认。','First confirm the service is needed, then check official capability, account conditions, allowance and costs. Use a test environment and test data; confirm real payments or outbound messages separately.'],locale)}</p><PromptTemplate id="external-api-plan" title={['只确认接口方案，不执行真实交易','Plan the integration without live transactions']} locale={locale} prompt={['项目需要的能力：【填写】\n候选服务与官方文档：【填写】\n需要发送的资料：【填写；不要粘贴密钥】\n希望收到的结果：【填写】\n预算与用量：【填写或尚未确定】\n只核对接口方案：输入输出、认证放置位置、测试环境、超时/失败/额度用尽的处理、重复请求是否重复执行。列出一个最小测试和通过标准，未知项先问。本次不写业务代码、不付款、不调用真实交易或对外发送接口。','Required capability: [fill in]\nService and official docs: [fill in]\nData to send: [fill in; no secrets]\nExpected response: [fill in]\nBudget and usage: [fill in or undecided]\nOnly assess inputs/outputs, credential placement, sandbox, timeout/failure/quota handling and duplicate requests. Propose a minimal test and passing criteria; ask about unknowns. Do not implement, pay, transact or send outward messages.']}/></details>}
<nav class="anchor-nav" data-shared-storage={g.id==='backend' ? '' : undefined} hidden={g.id==='backend'}><a href="#actions">{t(['现在做什么','Actions'],locale)}</a><a href="#record">{t(['留下检查记录','Record results'],locale)}</a><a href="#problems">{t(['卡住怎么办','Troubleshooting'],locale)}</a><a href="#template">{t(['交给 AI 的材料','AI handoff'],locale)}</a></nav>
{g.id==='backend'&&<><label for="storage-kind">{t(['先选资料如何保存','Choose where data lives'],locale)}</label><select id="storage-kind"><option value="">{t(['请选择实际需要','Choose the actual need'],locale)}</option><option value="local">{t(['只在当前浏览器保存','Only in this browser'],locale)}</option><option value="shared">{t(['多人或多设备使用','Shared across people or devices'],locale)}</option><option value="none">{t(['只展示内容，不保存','Display only; no saved data'],locale)}</option></select><section id="local-storage-guide" hidden><h2>{t(['先检查同一浏览器中的保存','Check same-browser storage first'],locale)}</h2><ol><li>{t(['写一条测试内容并保存。','Write and save a sample record.'],locale)}</li><li>{t(['刷新页面，再关闭并从同一个地址打开。','Refresh, close, then reopen at the same address.'],locale)}</li><li>{t(['记录仍在才算通过；换浏览器、换地址不应当作同步测试。','Pass only if the record remains. A different browser or address is not a sync test.'],locale)}</li></ol><p>{t(['清理浏览器数据会丢失记录。让 AI 提供导出办法，并实际尝试恢复。','Clearing browser data removes records. Ask AI for export and test recovery.'],locale)}</p><a href={url(locale,'learn/save/help/lost-record')}>{t(['保存失败或记录不见了 →','Saving failed or records disappeared →'],locale)}</a></section><p id="no-storage-guide" hidden>{t(['本次无需做保存和权限测试。确认页面内容正确，返回原步骤继续。','Storage and permission checks do not apply. Check displayed content, then return to the original step.'],locale)}</p></>}{g.id==='backend'&&<p data-pagefind-weight="8" data-shared-storage hidden>{t(['数据权限与访问规则：谁能查看、修改或删除资料。','Data permissions and access rules: who can read, edit, or delete records.'],locale)}</p>}
<section class="section" id="actions" data-shared-storage={g.id==='backend' ? '' : undefined} hidden={g.id==='backend'}><h2>{t(['按实际结果推进','Move forward using observed results'],locale)}</h2>{g.steps.map((s,i)=><details class="example-box"><summary>{i+1}. {t(s.title,locale)}</summary><p>{t(s.action,locale)}</p><p><strong>{t(['完成依据：','Evidence of completion: '],locale)}</strong>{t(s.check,locale)}</p><label class="check-item"><input type="checkbox"/>{t(['已亲手检查并在下方记录证据','Checked personally and recorded evidence below'],locale)}</label></details>)}<p class="small muted">{t(['勾选只是当前页面的个人标记，不是自动测试或持久保存，刷新会清空。','Checks are personal marks on this page, not automatic tests or saved records. Reloading clears them.'],locale)}</p></section>
<details class="section" id="record" data-shared-storage={g.id==='backend' ? '' : undefined} hidden={g.id==='backend'}><summary>{t(['填写检查记录','Write check results'],locale)}</summary><h2>{t(['填写本次记录','Write this run’s record'],locale)}</h2><p>{t(['把空白字段补齐，未做的项目写“待验证”。记录只留在当前页面，复制到项目资料后再关闭。','Fill each field and mark unexecuted checks as unverified. This record stays on the current page; copy it into project notes before closing.'],locale)}</p><label for="run-record">{t(['检查记录 · 可编辑','Editable check record'],locale)}</label><textarea id="run-record" rows="13">{t(g.record,locale)}</textarea><button class="button primary" id="confirm-record" type="button">{t(['确认，生成本次检查记录','Confirm this check record'],locale)}</button><div id="record-result" hidden><p>{t(['已确认的本次记录','Confirmed record'],locale)}</p><pre><code id="confirmed-record"></code></pre></div><button disabled class="button" id="copy-record" data-success={t(['记录已复制，请保存到项目资料。','Record copied. Save it in the project notes.'],locale)} data-failure={t(['复制失败，请手动选择记录文字复制。','Copy failed. Select and copy the record manually.'],locale)}>{t(['复制记录','Copy record'],locale)}</button><p role="status" id="record-status"></p></details>
<details class="section" id="problems" data-shared-storage={g.id==='backend' ? '' : undefined} hidden={g.id==='backend'}><summary>{t(['遇到问题时展开','Open troubleshooting'],locale)}</summary><h2>{t(['根据检查结果选择下一步','Choose the next step from the result'],locale)}</h2>{g.problems.map(p=><details class="example-box"><summary>{t(p.title,locale)}</summary><p>{t(p.body,locale)}</p></details>)}{g.id==='test'&&troubleshooting.map((p,i)=><details class="example-box" id={`problem-${i+1}`}><summary>{t(p.title,locale)}</summary><p>{t(p.check,locale)}</p><ul><li>{t(p.yes,locale)}</li><li>{t(p.no,locale)}</li></ul><p class="small muted">{t(['出口：按原步骤复测；通过则记录证据并继续，未通过则保留结果再排查，不标记完成。','Exit: rerun the original steps. On success, record evidence and continue. Otherwise retain results for further investigation and keep the task incomplete.'],locale)}</p></details>)}</details>
<details class="section" id="template" data-shared-storage={g.id==='backend' ? '' : undefined} hidden={g.id==='backend'}><summary>{t(['展开 AI 交接模板','Open AI handoff template'],locale)}</summary><PromptTemplate id={`guide-${g.id}`} title={['完整任务模板','Complete task template']} prompt={journey.find(s=>s.id===g.stage)!.prompt} locale={locale}/><a href={url(locale,g.next)}>{t(g.nextLabel,locale)} →</a><p><a href={url(locale,`roadmap/${g.stage}`)}>{t(['返回对应知识节点','Return to the matching journey stage'],locale)}</a></p></details>
<script>
document.querySelector<HTMLSelectElement>('#storage-kind')?.addEventListener('change',event=>{const kind=(event.target as HTMLSelectElement).value;document.querySelectorAll<HTMLElement>('[data-shared-storage]').forEach(el=>el.hidden=kind!=='shared');document.querySelector<HTMLElement>('#local-storage-guide')!.hidden=kind!=='local';document.querySelector<HTMLElement>('#no-storage-guide')!.hidden=kind!=='none';});
const openAnchor=()=>{const el=document.getElementById(location.hash.slice(1));if(el instanceof HTMLDetailsElement)el.open=true;};openAnchor();addEventListener('hashchange',openAnchor);
const button=document.querySelector<HTMLButtonElement>('#copy-record');button?.addEventListener('click',async()=>{const status=document.querySelector('#record-status')!;try{await navigator.clipboard.writeText(document.querySelector<HTMLTextAreaElement>('#run-record')!.value);status.textContent=button.dataset.success!;}catch{status.textContent=button.dataset.failure!;}});
document.querySelector('#confirm-record')?.addEventListener('click',()=>{const value=document.querySelector<HTMLTextAreaElement>('#run-record')!.value.trim();if(!value){document.querySelector('#record-status')!.textContent=document.documentElement.lang==='en'?'Fill in the record first.':'请先填写本次记录。';return;}document.querySelector('#confirmed-record')!.textContent=value;document.querySelector<HTMLElement>('#record-result')!.hidden=false;button!.disabled=false;document.querySelector('#record-status')!.textContent=document.documentElement.lang==='en'?'Confirmed, ready to copy.':'已确认，可以复制。';});
document.querySelector('#run-record')?.addEventListener('input',()=>{button!.disabled=true;document.querySelector<HTMLElement>('#record-result')!.hidden=true;document.querySelector('#record-status')!.textContent=document.documentElement.lang==='en'?'Record changed. Confirm again.':'记录已修改，请重新确认。';});
</script>
<style>#run-record{display:block;width:100%;box-sizing:border-box;margin:12px 0;padding:14px;font:inherit;border:1px solid #9aa5b5;border-radius:6px;resize:vertical}.example-box{margin-bottom:16px}</style>
