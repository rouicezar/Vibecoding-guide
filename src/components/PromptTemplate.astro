---
import Icon from './Icon.astro';
import {t,type Locale,type Copy} from '../data/site';
interface Props {id:string; title:Copy; prompt:Copy; locale:Locale;}
const {id,title,prompt,locale}=Astro.props;
---
<div class="prompt-template">
  <div class="template-toolbar"><h3 id={`prompt-title-${id}`}><Icon name="message" size={15}/>{t(title,locale)}</h3><button class="template-copy" data-copy-template={id} data-copied={t(['已复制','Copied'],locale)} data-failed={t(['复制失败，请在代码框内手动选择并复制。','Copy failed. Select and copy the text in the code box.'],locale)}><Icon name="copy" size={14}/><span>{t(['一键复制','Copy template'],locale)}</span></button></div>
  <p class="template-instruction">{t(['以虚构的烘焙预约项目为例。保留【字段名】，把后面的示例内容换成实际情况；不确定的部分填写“尚未确定”。','The fictional bakery project is an example. Keep the [field labels] and replace the sample values with actual details. Write “undecided” where information is missing.'],locale)}</p>
  <pre tabindex="0" aria-labelledby={`prompt-title-${id}`}><code data-template-text={id}>{t(prompt,locale)}</code></pre>
  <div class="template-footer"><span>{t(['纯文本 · 修改示例后发送给 AI','Plain text · Edit examples before sending to AI'],locale)}</span><span role="status" data-template-status={id}></span></div>
</div>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-copy-template]').forEach(button=>button.addEventListener('click',async()=>{
 const id=button.dataset.copyTemplate!;
 const text=document.querySelector<HTMLElement>(`[data-template-text="${id}"]`)!.textContent!;
 const status=document.querySelector<HTMLElement>(`[data-template-status="${id}"]`)!;
 try{await navigator.clipboard.writeText(text);status.textContent=button.dataset.copied!;}
 catch{status.textContent=button.dataset.failed!;}
}));
</script>
