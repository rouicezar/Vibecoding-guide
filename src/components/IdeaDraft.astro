---
import { t, type Locale } from '../data/site';
/** 想法草稿表单：从旧的 /learn/idea 页面原样搬来，供节点 1 的步骤内使用。 */
const { locale } = Astro.props as { locale: Locale };
const label = (zh: string, en: string) => t([zh, en], locale);
---

<form class="idea-draft" data-draft-form>
  <label for="idea-text">
    {label('按模板改成自己的想法', 'Make this template personal')}
  </label>
  <p class="local-note">
    {label(
      '替换括号里的内容；拿不准就填“尚未确定”，然后确认生成。',
      'Replace the bracketed fields, or write undecided, then confirm.',
    )}
  </p>
  <textarea
    id="idea-text"
    name="idea"
    rows="7"
    placeholder={label(
      '例如：给自己用，记录每天学到的东西。',
      'For example: a personal daily learning journal.',
    )}
  ></textarea>
  <button type="button" class="learn-primary" data-confirm-idea>
    {label('确认，生成我的想法草稿', 'Confirm and generate my idea')}
  </button>
  <p data-idea-status role="status"></p>
  <div data-idea-result hidden>
    <label for="idea-personal">
      {label('我的专属想法草稿', 'My personal idea draft')}
    </label>
    <textarea id="idea-personal" readonly rows="6"></textarea>
    <button type="button" class="button" data-copy-idea disabled>
      {label('一键复制我的草稿', 'Copy my draft')}
    </button>
  </div>
  <details class="learn-details">
    <summary>
      {label('补充想法（可以以后再填）', 'Add details (optional for now)')}
    </summary>
    <label for="later-text">
      {label(
        '哪些功能以后再做，哪些事情还没决定？',
        'Which features can wait, and what have you not decided yet?',
      )}
    </label>
    <textarea id="later-text" name="later" rows="3"></textarea>
  </details>
</form>
<style>
  .idea-draft {
    margin: 8px 0 4px;
  }
  .idea-draft label {
    display: block;
    font-weight: 650;
    margin: 14px 0 6px;
  }
  .idea-draft textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #b9cad4;
    border-radius: 8px;
    padding: 14px;
    font: 14px/1.8 system-ui;
    resize: vertical;
  }
</style>
