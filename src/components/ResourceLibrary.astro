---
import {resourceGuidance} from '../data/resource-guidance';
import {t,url,type Locale} from '../data/site';
import Icon from './Icon.astro';
import {routeNodes} from '../data/nodes';
import {resourcesForNode} from '../data/node-resources';
const {locale}=Astro.props as {locale:Locale};
const groups=[{title:['决定做什么、用什么','Choose the product and tools'],paths:['start','tools','stacks']},{title:['把当前任务做出来','Build the current task'],paths:['communicate','components','data']},{title:['检查、交付、继续维护','Verify, deliver and maintain'],paths:['check','launch','maintain','terms']}];
---
<h1>{t(['带着问题来，拿着方法走','Find a method for the current question'],locale)}</h1><p class="lesson-lead">{t(['不必把资料库读完。选择当前卡住的问题，看适用条件与方法，带着结果回到项目。','No need to read the whole library. Choose the current question, check the method and conditions, then return to the project.'],locale)}</p>
<section class="library-node-index"><h2>{t(['按当前节点找资料','Find references by milestone'],locale)}</h2><p>{t(['先选正在做的节点，只展开相关资料；原有按问题分类保留在下方。','Choose the current milestone for its references; question categories remain below.'],locale)}</p>{routeNodes.map(n=><details data-library-node={n.id}><summary>{String(n.order).padStart(2,'0')}. {t(n.title,locale)}</summary><ul>{resourcesForNode(n.id).map(r=><li><a href={`${url(locale,r.path)}?node=${n.id}`}>{t(r.question,locale)}</a></li>)}</ul><a href={`${url(locale,'terms')}?node=${n.id}`}>{t(['本节点的术语','Terms for this milestone'],locale)}</a><a class="library-back" href={url(locale,`node/${n.id}`)}>{t(['返回节点 →','Return to milestone →'],locale)}</a></details>)}</section>
<a class="glossary-entry" href={url(locale,'terms')}><Icon name="book" size={28}/><span><strong>{t(['AI 与项目开发术语库','AI & development glossary'],locale)}</strong><small>{t(['大模型、Skill、Agent、MCP、前后端、API……一句解释，配上生活例子和图解。','Models, skills, agents, MCP, APIs and more—with everyday examples and diagrams.'],locale)}</small></span><Icon name="arrow" size={20}/></a>
{groups.map(group=><section class="resource-group"><h2>{t(group.title as [string,string],locale)}</h2><div class="resource-grid">{group.paths.map(path=>{const r=resourceGuidance.find(r=>r.path===path)!;return <a href={url(locale,path)}><h3>{t(r.question,locale)}<Icon name="arrow" size={17}/></h3><p>{t(r.use,locale)}</p><small>{t(['读完后，你会得到什么？','What will you get from reading this? '],locale)}{t(r.result,locale)}</small></a>})}</div></section>)}
<details class="resource-extra"><summary>{t(['已有明确操作？直接查专项方法','Need a specific procedure?'],locale)}</summary><div>{[['communicate/tools',['打开工具并检查项目访问','Open a tool and check project access']],['communicate/setup',['Git 与项目规则','Git and project rules']],['components/style',['描述界面风格','Describe visual style']],['components/edit',['只改一处界面','Change one interface part']]].map(([path,title])=><a href={url(locale,path as string)}>{t(title as [string,string],locale)} →</a>)}</div></details>
<style>.glossary-entry{display:flex;align-items:center;gap:18px;border:1px solid #a9cdc7;border-radius:10px;padding:22px;margin:24px 0}.glossary-entry>svg{color:#318178}.glossary-entry>svg:last-child{margin-left:auto}.glossary-entry strong{display:block;font-size:20px}.glossary-entry small{display:block;font-size:14px;line-height:1.8;color:#506579;margin-top:6px}.resource-group{margin:32px 0}.resource-group>h2{font-size:20px!important;margin-bottom:16px!important}.resource-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.resource-grid>a{display:block;padding:22px;border:1px solid #d7e5e8;border-radius:12px;text-decoration:none;background:white}.resource-grid h3{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:17px;margin:0 0 10px;color:#243b53}.resource-grid p{font-size:15px;color:#61778b;margin:0 0 12px}.resource-grid small{font-size:13px;color:#357d78}.resource-extra{border-top:1px solid #e1e9ef}.resource-extra summary{font-size:16px;padding-left:0}.resource-extra a{display:block;padding:9px 0;font-size:15px}@media(max-width:700px){.resource-grid{grid-template-columns:1fr}}
</style>

<script>const node=new URLSearchParams(location.search).get('node');document.querySelectorAll<HTMLDetailsElement>('[data-library-node]').forEach(el=>{if(el.dataset.libraryNode===node){el.open=true;}});</script>
<style>.library-node-index{margin:24px 0}.library-node-index>p{font-size:14px;color:#536b80}.library-node-index details{border-bottom:1px solid #dce5ed;padding:10px 0}.library-node-index summary{min-height:44px;font-size:15px;cursor:pointer;padding:10px 0}.library-node-index a{font-size:14px;display:inline-block;padding:8px 0}.library-back{margin-left:20px}</style>
