---
import {resourceGuidance} from '../data/resource-guidance';
import {t,url,type Locale} from '../data/site';
import Icon from './Icon.astro';
const {locale}=Astro.props as {locale:Locale};
const groups=[{title:['决定做什么、用什么','Choose the product and tools'],paths:['start','tools','stacks']},{title:['把当前任务做出来','Build the current task'],paths:['communicate','components','data']},{title:['检查、交付、继续维护','Verify, deliver and maintain'],paths:['check','launch','maintain','terms']}];
---
<h1>{t(['带着问题来，拿着方法走','Find a method for the current question'],locale)}</h1><p class="lesson-lead">{t(['不必把资料库读完。选择当前卡住的问题，看适用条件与方法，带着结果回到项目。','No need to read the whole library. Choose the current question, check the method and conditions, then return to the project.'],locale)}</p>
{groups.map(group=><section class="resource-group"><h2>{t(group.title as [string,string],locale)}</h2><div class="resource-grid">{group.paths.map(path=>{const r=resourceGuidance.find(r=>r.path===path)!;return <a href={url(locale,path)}><h3>{t(r.question,locale)}<Icon name="arrow" size={17}/></h3><p>{t(r.use,locale)}</p><small>{t(['读完得到：','Leave with: '],locale)}{t(r.result,locale)}</small></a>})}</div></section>)}
<details class="resource-extra"><summary>{t(['已有明确操作？直接查专项方法','Need a specific procedure?'],locale)}</summary><div>{[['communicate/tools',['打开工具并检查项目访问','Open a tool and check project access']],['communicate/setup',['Git 与项目规则','Git and project rules']],['components/style',['描述界面风格','Describe visual style']],['components/edit',['只改一处界面','Change one interface part']]].map(([path,title])=><a href={url(locale,path as string)}>{t(title as [string,string],locale)} →</a>)}</div></details>
<style>.resource-group{margin:32px 0}.resource-group>h2{font-size:20px!important;margin-bottom:16px!important}.resource-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.resource-grid>a{display:block;padding:22px;border:1px solid #d7e5e8;border-radius:12px;text-decoration:none;background:white}.resource-grid h3{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:17px;margin:0 0 10px;color:#243b53}.resource-grid p{font-size:15px;color:#61778b;margin:0 0 12px}.resource-grid small{font-size:13px;color:#357d78}.resource-extra{border-top:1px solid #e1e9ef}.resource-extra summary{font-size:16px;padding-left:0}.resource-extra a{display:block;padding:9px 0;font-size:15px}@media(max-width:700px){.resource-grid{grid-template-columns:1fr}}
</style>
