---
import {journey,mainJourney} from '../data/journey';
import {legacyLessons} from '../data/learning';
import {t,url,type Locale} from '../data/site';
import Icon from './Icon.astro';
const {locale,compact=false}=Astro.props as {locale:Locale;compact?:boolean};
const groups=[{title:['把想法说清楚','Shape the idea'] as const,ids:['idea','tell','refine','scope','requirements'],tone:'red',icon:'brain'},{title:['准备开始制作','Prepare to build'] as const,ids:['stack','plan','environment'],tone:'green',icon:'layers'},{title:['做出可以使用的版本','Build a working version'] as const,ids:['build'],tone:'blue',icon:'browser'},{title:['检查、交付、继续改','Check, deliver, improve'] as const,ids:['test','accept','launch','maintain'],tone:'orange',icon:'checklist'}];
---
<section class:list={['roadmap',{compact}]} aria-labelledby="roadmap-title" data-roadmap data-lesson-map={JSON.stringify(legacyLessons)}>
<header class="roadmap-heading" hidden={compact}><div><span class="eyebrow">{t(['完整路线 · 随时知道下一步','THE COMPLETE JOURNEY'],locale)}</span><h2 id="roadmap-title">{t(['看清全程，再走好每一步','See the journey. Take the next step.'],locale)}</h2></div><span class="map-key"><i></i>{t(['点击节点，展开这一站','Select a node to explore'],locale)}</span></header>
<div class="roadmap-lanes">{groups.map((g,i)=><section class={`map-lane tone-${g.tone}`}><header><span class="lane-number">0{i+1}</span><h3>{t(g.title,locale)}</h3></header><ol>{g.ids.map(id=>{const s=journey.find(s=>s.id===id)!;return <li><a class="map-node" href={url(locale,`roadmap/${id}`)} data-map-node={id}><span class="map-dot"><Icon name={g.icon} size={16}/></span><span><strong>{t(s.title,locale)}</strong><small>{String(mainJourney.indexOf(s)+1).padStart(2,'0')} · {s.term}</small></span><span class="map-state" aria-hidden="true">↗</span></a>{id==='build'&&<div class="map-branches"><span>{t(['按作品需要进入分支','Branches as needed'],locale)}</span>{journey.filter(b=>b.parent==='build').map(b=><a href={url(locale,`roadmap/${b.id}`)} data-map-node={b.id}><span aria-hidden="true">↳</span> {t(b.title,locale)} <span aria-hidden="true">→</span></a>)}</div>}</li>})}</ol></section>)}</div>
<footer class="map-footer"><span>↶ {t(['检查未通过，回到制作；需求改变，回到范围确认。','Checks failed? Revisit building. Scope changed? Revisit agreement.'],locale)}</span><a href={url(locale,'learn/idea')}>{t(['零基础？从第一个小动作开始 →','New to this? Start with one small action →'],locale)}</a></footer>
</section>
<script>
import {parseLearning} from '../scripts/learning';
const map=document.querySelector<HTMLElement>('[data-roadmap]');if(map){try{const saved=parseLearning(localStorage.getItem('vibe-guide-learning-v1'));const lookup=JSON.parse(map.dataset.lessonMap!);map.querySelectorAll<HTMLAnchorElement>('[data-map-node]').forEach(a=>{if(lookup[a.dataset.mapNode!]===saved.current&&(saved.idea||saved.completed.length)){a.setAttribute('aria-current','step');const state=a.querySelector('.map-state');if(state)state.textContent=document.documentElement.lang==='en'?'Here':'当前';}});}catch{}}
</script>
<style>
.roadmap{margin:40px 0 24px}.roadmap-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:26px}.roadmap-heading h2{font-size:clamp(23px,2.5vw,30px);letter-spacing:-.035em;margin:10px 0 0;color:#17243b}.map-key{font-size:11px;color:#64748b;white-space:nowrap}.map-key i{display:inline-block;background:#537cba;width:6px;height:6px;border-radius:50%;margin-right:7px}.roadmap-lanes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.map-lane{--tone:#df3044;--ink:#bc2335;--on-accent:#fff;--wash:#ffecef;min-width:0}.tone-green{--tone:#50a976;--ink:#36764f}.tone-blue{--tone:#4385e8;--ink:#2863b9}.tone-orange{--tone:#ff7a1a;--ink:#b74208}.map-lane>header{position:relative;display:flex;gap:10px;align-items:center;padding:12px 10px;background:#fff;border:1px solid var(--tone);border-radius:10px;min-height:58px}.lane-number{font-size:11px;color:var(--ink);background:transparent;padding:4px 6px;border-radius:6px;font-weight:750}.map-lane h3{font-size:14px;line-height:1.55;color:#20262d;margin:0}.map-lane:not(:last-child)>header:after{content:'→';position:absolute;right:-12px;top:18px;z-index:1;color:#8092ac;font-size:12px;background:white;border-radius:50%;width:20px;height:20px;text-align:center}.map-lane ol{list-style:none;padding:12px 0 0;margin:0}.map-lane li{position:relative;margin-bottom:12px}.map-lane li+li:before{content:'';position:absolute;top:-13px;left:25px;height:13px;border-left:1px solid var(--tone)}.map-node{display:flex;gap:9px;align-items:center;padding:15px 10px;border:1px solid var(--tone);background:white;border-radius:9px;min-height:76px;text-decoration:none;color:#25354d;box-shadow:0 2px 4px #17243b03;transition:transform .18s,border-color .18s,box-shadow .18s}.map-node:hover{transform:translateY(-3px);border-color:var(--tone);box-shadow:0 5px 12px #17243b0a}.map-node[aria-current]{border-color:var(--tone);background:#fff;box-shadow:0 0 0 1px var(--tone)}.map-dot{width:28px;height:28px;border-radius:8px;background:transparent;color:var(--ink);display:grid;place-items:center;flex-shrink:0}.map-node strong{display:block;font-size:14px;font-weight:650;line-height:1.6}.map-node small{font-size:11px;color:#718198;display:block;margin-top:3px}.map-state{font-size:10px;color:var(--ink);margin-left:auto;white-space:nowrap}.map-branches{margin:8px 0 0 24px;padding:12px 0 0 12px;border-left:1px dashed var(--tone)}.map-branches>span{font-size:10px;color:#64748b}.map-branches a{display:flex;gap:6px;align-items:center;border:1px solid var(--tone);background:#fff;border-radius:7px;padding:12px 8px;margin-top:9px;font-size:12px;text-decoration:none;color:var(--ink)}.map-branches a>span:last-child{margin-left:auto}.map-footer{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;padding:18px 0;border-bottom:1px solid #e2e8f0;font-size:12px;color:#64748b}.map-footer a{font-weight:600}@media(max-width:1100px){.map-lane:nth-child(2)>header:after{display:none}.roadmap-lanes{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 16px}.roadmap-heading{align-items:start;flex-direction:column;gap:12px}}@media(max-width:560px){.map-lane>header:after{display:none}.roadmap-lanes{grid-template-columns:1fr}.map-lane>header{min-height:48px}.map-lane h3{font-size:15px}.map-node{min-height:66px;padding:13px 14px}.map-node strong{font-size:15px}.map-lane li+li:before{left:29px}.roadmap{margin-top:30px}}
</style>
