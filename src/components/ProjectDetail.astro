---
import {t,url,type Project,type Locale} from '../data/site';
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
interface Props {locale:Locale;project:Project;}
const {locale,project:p}=Astro.props;
---
<div class="breadcrumb"><a href={url(locale,'start')}>{t(['项目分类','Project types'],locale)}</a><Icon name="chevron" size={14}/><span>{t(p.title,locale)}</span></div>
<section class="detail-hero"><div><span class="eyebrow">{p.term.toUpperCase()}</span><h1>{t(p.tagline,locale)}</h1><p class="lead">{t(p.intro,locale)}</p><span class="badge blue">{t(p.badge,locale)}</span></div><ProjectVisual project={p} locale={locale}/></section>
<nav class="anchor-nav" aria-label={t(['页面目录','On this page'],locale)}><a href="#overview">{t(['开始之前','Before you start'],locale)}</a><a href="#steps">{t(['制作路线','The route'],locale)}</a><a href="#prompt">{t(['对 AI 这样说','Your first prompt'],locale)}</a><a href="#terms">{t(['认识几个词','Useful terms'],locale)}</a></nav>
<div class="detail-columns"><div><section class="section" id="overview"><div class="section-heading"><h2>{t(['从一个足够小的版本开始','Start with a small first version'],locale)}</h2><span class="eyebrow">01 / START</span></div><div class="example-box"><span class="term">{t(['贯穿示例','WORKING EXAMPLE'],locale)}</span><h3>{t(p.example,locale)}</h3><p>{t(p.exampleDesc,locale)}</p></div>{p.platforms.length>0&&<div class="platform-picker"><h3>{t(['先选一个平台','Choose one platform first'],locale)}</h3><div class="segmented" role="group" aria-label={t(['目标平台','Target platform'],locale)}>{p.platforms.map((platform,i)=><button data-platform={platform.id} aria-pressed={i===0?'true':'false'}>{t(platform.name,locale)}</button>)}</div>{p.platforms.map((platform,i)=><p data-platform-note={platform.id} hidden={i!==0}>{t(platform.note,locale)}</p>)}</div>}<h3 class="subheading">{t(['准备这三件事','Three things to prepare'],locale)}</h3><ul class="feature-list">{p.requirements.map(r=><li><Icon name="check" size={17}/>{t(r,locale)}</li>)}</ul></section>
<section class="section" id="steps"><div class="section-heading"><h2>{t(['一步一步，把它做出来','Your route from idea to product'],locale)}</h2><span class="eyebrow">02 / BUILD</span></div><p class="muted">{t(['每次完成一小步，亲手检查后再继续。点击步骤查看完成标准。','Finish one small step, check it yourself, then move on. Open each step to see the expected result.'],locale)}</p><div class="steps">{p.steps.map((step,i)=><details open={i===0}><summary><span class="step-number">{String(i+1).padStart(2,'0')}</span><strong>{t(step.title,locale)}</strong><Icon name="chevron" size={17}/></summary><div class="step-body"><p>{t(step.desc,locale)}</p><div class="outcome"><Icon name="check" size={15}/><span>{t(['完成时：','You should have: '],locale)}{t(step.outcome,locale)}</span></div></div></details>)}</div></section>
<section class="section" id="prompt"><div class="section-heading"><h2>{t(['第一句话，可以这样说','Start the conversation like this'],locale)}</h2><span class="eyebrow">03 / PROMPT</span></div><div class="prompt-box"><div class="prompt-heading"><span><Icon name="message"/>{t(['发送给你的 AI 助手','A prompt for your AI assistant'],locale)}</span><button id="copy-prompt" class="button small-button" data-success={t(['已复制','Copied'],locale)} data-failure={t(['未能复制，请手动选中文字','Could not copy. Select the text manually.'],locale)}><Icon name="copy" size={15}/><span>{t(['复制','Copy'],locale)}</span></button></div><p id="prompt-text">{t(p.prompt,locale)}</p></div><p id="copy-status" role="status" class="small muted"></p><p class="small muted">{t(['把示例中的用途和平台换成自己的，再发送给 AI。','Replace the example purpose and platform with your own before sending.'],locale)}</p></section>
<section class="section" id="terms"><div class="section-heading"><h2>{t(['顺便认识这几个词','A few useful terms'],locale)}</h2><span class="eyebrow">04 / UNDERSTAND</span></div><dl class="terms">{p.terms.map(term=><div><dt>{t(term.name,locale)}</dt><dd>{t(term.definition,locale)}</dd></div>)}</dl></section></div>
<aside class="detail-aside"><div class="aside-card"><span class="eyebrow">YOUR PROJECT</span><h3>{t(p.title,locale)}</h3><dl><dt>{t(['适合','For'],locale)}</dt><dd>{t(p.audience,locale)}</dd><dt>{t(['做完得到','The result'],locale)}</dt><dd>{t(p.result,locale)}</dd></dl><a class="button primary" href="#prompt">{t(['拿走起步提示词','Get the first prompt'],locale)}<Icon name="arrow" size={15}/></a></div><div class="aside-card"><h3>{t(['亲手检查这三件事','Check these yourself'],locale)}</h3><p class="small muted">{t(['自检清单，不是自动检测结果。','A personal checklist, not an automated test.'],locale)}</p>{p.checks.map(check=><label class="check-item"><input type="checkbox"/>{t(check,locale)}</label>)}</div><a class="back-link" href={url(locale,'start')}>← {t(['比较其他项目','Compare other projects'],locale)}</a></aside></div>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-platform]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>('[data-platform]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-platform-note]').forEach(note=>note.hidden=note.dataset.platformNote!==button.dataset.platform);}));
document.getElementById('copy-prompt')?.addEventListener('click',async()=>{const button=document.getElementById('copy-prompt')!;try{await navigator.clipboard.writeText(document.getElementById('prompt-text')!.textContent!.trim());document.getElementById('copy-status')!.textContent=button.dataset.success!;}catch{document.getElementById('copy-status')!.textContent=button.dataset.failure!;}});
</script>
