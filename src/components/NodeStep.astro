---
import Icon from './Icon.astro';
import FullstackPractice from './FullstackPractice.astro';
import fullstackRows from '../data/fullstack-practice.json';
import { microActions } from '../data/micro-actions';
import PromptTemplate from './PromptTemplate.astro';
import StepVisual from './StepVisual.astro';
import LearningBranches from './LearningBranches.astro';
import StepRecord from './StepRecord.astro';
import IdeaDraft from './IdeaDraft.astro';
import ToolEntries from './ToolEntries.astro';
import { lessons } from '../data/learning';
import { stepSupport, referenceAnswers } from '../data/learning-support';
import { fileContracts } from '../data/learning-contracts';
import { glossary } from '../data/glossary';
import { t, url, type Locale, type Copy } from '../data/site';
import { nodeForStep, optionalSteps } from '../data/nodes';
/**
 * 一个步骤的固定结构。18 个节点、31 个步骤共用这一个模板：
 *   固定区块 A 操作示意 → 9 个编号槽位（顺序固定）→ 固定区块 B 项目分支 → 固定区块 C 示例资料
 *   → 固定区块 D 记录与核对 → 固定底栏（分支选择或下一步）。
 * 槽位与区块的内容全部来自现有数据；本文件不写教学内容。
 */
interface Props {
  stepId: string;
  index: number;
  total: number;
  locale: Locale;
  open?: boolean;
  nextHref?: string;
  nextLabel?: Copy;
}
const {
  stepId,
  index,
  total,
  locale,
  open = false,
  nextHref,
  nextLabel,
} = Astro.props;
const lesson = lessons.find((l) => l.id === stepId);
if (!lesson) throw new Error(`未知步骤：${stepId}`);
const support = stepSupport.find((s) => s.id === stepId);
if (!support) throw new Error(`步骤缺少步骤材料：${stepId}`);
const label = (zh: string, en: string) => t([zh, en] as const, locale);
const terms = support.terms
  .map((id) => glossary.find((g) => g.id === id))
  .filter(Boolean);
const purpose = lesson.understanding?.why ?? support.answer;
const contract = fileContracts[lesson.id];
const answer = referenceAnswers[lesson.id];
const optional = optionalSteps[stepId];
const practice = fullstackRows.find((row) => row.id === stepId)!;
const heading = (n: number, zh: string, en: string) =>
  `<h3 class="slot-title"><span class="slot-number">${String(n).padStart(2, '0')}</span>${t([zh, en] as const, locale)}</h3>`;
/** 跨节点引用另一步骤时用完整地址，只有同节点内的步骤才用页内锚点。 */
const stepHref = (id: string) =>
  `${url(locale, `node/${nodeForStep(id)}`)}#${id}`;
---

<details class="node-step" id={stepId} data-node-step={stepId} open={open}>
  <summary>
    <span class="step-order">
      {String(index).padStart(2, '0')}
      <span aria-hidden="true">/</span>
      {String(total).padStart(2, '0')}
    </span>
    <span class="step-title">
      {t(lesson.title, locale)}
      {optional && <em class="step-optional">{label('可选', 'Optional')}</em>}
    </span>
    <span class="step-progress" data-progress={stepId}>
      {label('待核对', 'To check')}
    </span>
    <span class="step-hint">
      <span class="when-closed">{label('展开这一步', 'Open this step')}</span>
      <span class="when-open">{label('收起这一步', 'Close this step')}</span>
      <Icon name="chevron" size={16} />
    </span>
  </summary>

  <div class="step-body">
    {optional && (
      <p class="step-optional-note">
        <Icon name="help" size={16} />
        {t(optional, locale)}
      </p>
    )}

    <!-- 固定区块 A · 操作示意 -->
    <StepVisual id={lesson.id} locale={locale} />

    <!-- 槽位 01 · 材料交接 -->
    <div class="step-slot">
      <Fragment
        set:html={heading(
          1,
          '开始前准备什么，做完后留下什么？',
          'What do you need, and what should you keep?',
        )}
      />
      <div class="material-flow">
        <div>
          <small>
            {label('开始前需要准备什么？', 'What do you need before starting?')}
          </small>
          <p>{t(support.input, locale)}</p>
        </div>
        <span class="material-arrow" aria-hidden="true">
          →
        </span>
        <div>
          <small>
            {label(
              '做完后要留下什么？',
              'What should you keep for the next step?',
            )}
          </small>
          <p>{t(support.output, locale)}</p>
        </div>
      </div>
      {contract && (
        <details class="learn-details">
          <summary>
            {label(
              '这一步要让 AI 读取和保存哪些文件？',
              'Which files should AI read and save in this step?',
            )}
          </summary>
          <p>
            {label(
              '在所选工具的项目对话中，让它先打开下面的文件。找不到时，点击下方链接回到创建文件的步骤。',
              'In your tool’s project chat, ask it to open the files below. If a file is missing, follow the link back to the step that creates it.',
            )}
          </p>
          <p>
            <strong>
              {label(
                '先让 AI 读取这些材料：',
                'Ask AI to read these materials first: ',
              )}
            </strong>
            {contract.reads.join(' · ') ||
              label(
                '当前已确认材料与项目位置',
                'Confirmed material and project location',
              )}
          </p>
          <p>
            <strong>
              {label('让 AI 将结果保存到：', 'Ask AI to save the result to: ')}
            </strong>
            {contract.writes.join(' · ') ||
              label('只检查，不改文件', 'Read-only; no file changes')}
          </p>
          <p class="slot-note">
            <a href={stepHref(contract.back)}>
              {label(
                '缺少这些材料？回到创建它们的步骤 →',
                'Missing these materials? Return to the step that creates them →',
              )}
            </a>
          </p>
        </details>
      )}
    </div>

    <!-- 槽位 02 · 这一步要达成 -->
    <div class="step-slot">
      <Fragment
        set:html={heading(
          2,
          '这一步要帮你解决什么问题？',
          'What will this step help you do?',
        )}
      />
      <p>{t(purpose, locale)}</p>
      {lesson.understanding && (
        <details class="learn-details">
          <summary>
            {label(
              '弄懂原理，再试着自己判断',
              'Understand it, then judge for yourself',
            )}
          </summary>
          <h4>
            {label('这个概念是什么意思？', 'What does this concept mean?')}
          </h4>
          <p>{t(lesson.understanding.concept, locale)}</p>
          <h4>
            {label(
              '换个情况，你会怎样判断？',
              'How would you decide in a different situation?',
            )}
          </h4>
          <p>{t(lesson.understanding.question, locale)}</p>
          {answer && (
            <details>
              <summary>
                {label('查看参考答案', 'See a reference answer')}
              </summary>
              <p>{t(answer, locale)}</p>
            </details>
          )}
          <p class="slot-note">
            {label(
              '试着用自己的话回答；拿不准时先对照上面的解释，再用自己的项目举例核对。',
              'Answer in your own words; if unsure, compare the explanation above and check it against your own project.',
            )}
          </p>
        </details>
      )}
    </div>

    <!-- 槽位 03 · 你要做的 -->
    <details class="step-slot step-extra" data-step-section="actions" open>
      <summary>
        <Fragment
          set:html={heading(
            3,
            '这一步具体怎么做？',
            'What exactly should you do in this step?',
          )}
        />
        <span class="slot-fold-hint">
          <span class="when-closed">{label('展开', 'Open')}</span>
          <span class="when-open">{label('收起', 'Close')}</span>
          <Icon name="chevron" size={14} />
        </span>
      </summary>
      <p class="step-location">
        <Icon name="location" size={16} />
        {t(lesson.where, locale)}
      </p>
      {microActions[stepId].some((action) => action.prompt) && (
        <p>
          {label(
            '每次只发送当前这一项的提示词：选中框内文字复制（Mac 按 ⌘C，Windows 按 Ctrl+C），切到所选工具的项目对话，粘贴后把【】替换成自己的内容，再点发送。等工具回复并核对“完成后应该看到”的结果，再做下一项。',
            'Send one action at a time: select and copy its prompt (⌘C on Mac, Ctrl+C on Windows), switch to your tool’s project chat, paste it, replace bracketed fields and send. Wait for the reply and check the stated result before continuing.',
          )}
        </p>
      )}
      <ol class="lesson-actions">
        {microActions[stepId].map((action, actionIndex) => {
          const instruction = t(action.action, locale);
          const prompt = action.prompt ? t(action.prompt, locale) : undefined;
          const result = t(action.afterwards, locale);
          return (
            <li>
              <details
                class="action-detail"
                data-guided-action={action.id}
                open={actionIndex === 0}
              >
                <summary>
                  {instruction}
                  <span class="action-hint">
                    <span class="when-closed">{label('展开', 'Open')}</span>
                    <span class="when-open">{label('收起', 'Close')}</span>
                    <Icon name="chevron" size={14} />
                  </span>
                </summary>
                {prompt && (
                  <>
                    <p>
                      <strong>
                        {label('建议提示词：', 'Suggested prompt:')}
                      </strong>
                    </p>
                    <pre>{prompt}</pre>
                  </>
                )}
                <p>
                  <strong>
                    {label('完成后应该看到：', 'Afterwards, you should see: ')}
                  </strong>
                  {result}
                </p>
              </details>
            </li>
          );
        })}
      </ol>
      {lesson.id === 'tool' && <ToolEntries locale={locale} />}
      <FullstackPractice id={stepId} locale={locale} />
    </details>

    <!-- 槽位 04 · 逐项跟着做 -->
    <details class="step-slot step-extra">
      <summary>
        <Fragment
          set:html={heading(
            4,
            '不会具体操作？逐项跟着做',
            'Not sure how? Follow each action',
          )}
        />
        <span class="slot-fold-hint">
          <span class="when-closed">{label('展开', 'Open')}</span>
          <span class="when-open">{label('收起', 'Close')}</span>
          <Icon name="chevron" size={14} />
        </span>
      </summary>
      <ol class="support-actions">
        {microActions[stepId].map((step) => (
          <li data-micro-action={step.id}>
            <p>{t(step.action, locale)}</p>
            <dl class="micro-check">
              <dt>
                {label(
                  '操作后应该看到什么？',
                  'What should you see after this action?',
                )}
              </dt>
              <dd>{t(step.expect, locale)}</dd>
              <dt>
                {label(
                  '没有看到这个结果时，怎么办？',
                  'What should you do if that result is missing?',
                )}
              </dt>
              <dd>{t(step.ifWrong, locale)}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </details>

    <!-- 槽位 05 · 这一步出现的词 -->
    <details class="step-slot step-extra">
      <summary>
        <Fragment
          set:html={heading(5, '这一步出现的词', 'Words in this step')}
        />
        <span class="slot-fold-hint">
          <span class="when-closed">{label('展开', 'Open')}</span>
          <span class="when-open">{label('收起', 'Close')}</span>
          <Icon name="chevron" size={14} />
        </span>
      </summary>
      <div class="step-terms">
        {terms.map((term) => (
          <section>
            <h4>
              <a href={url(locale, `terms/${term!.id}`)}>
                {t(term!.name, locale)} ↗
              </a>
            </h4>
            <p>{t(term!.definition, locale)}</p>
            <p class="slot-note">{t(term!.example, locale)}</p>
          </section>
        ))}
      </div>
    </details>

    <!-- 槽位 06 · 可能卡住的地方 -->
    <details class="step-slot step-extra">
      <summary>
        <Fragment
          set:html={heading(
            6,
            '遇到问题时，应该怎么处理？',
            'How should you handle a problem here?',
          )}
        />
        <span class="slot-fold-hint">
          <span class="when-closed">{label('展开', 'Open')}</span>
          <span class="when-open">{label('收起', 'Close')}</span>
          <Icon name="chevron" size={14} />
        </span>
      </summary>
      {lesson.issues.map((issue) => (
        <div class="issue-card">
          <p class="issue-symptom">
            <Icon name="bug" size={16} />
            {t(issue.title, locale)}
          </p>
          <dl>
            <dt>
              {label(
                '先检查哪里，确认问题的原因？',
                'Where should you look to understand the problem?',
              )}
            </dt>
            <dd>{t(issue.check, locale)}</dd>
            <dt>
              {label(
                '按下面的方法处理问题',
                'Follow these steps to resolve the problem',
              )}
            </dt>
            <dd>{t(issue.action, locale)}</dd>
            <dt>{label('恢复后应该看到', 'Expected recovery')}</dt>
            <dd>{t(issue.expected, locale)}</dd>
          </dl>
          {issue.retry && (
            <p class="slot-note">
              <a href={stepHref(issue.retry)}>
                {label(
                  '回到前面的准备步骤 →',
                  'Revisit the preparation step →',
                )}
              </a>
            </p>
          )}
        </div>
      ))}
      <PromptTemplate
        id={`rescue-${lesson.id}`}
        title={
          [
            '问题不在列表里？请 AI 排查',
            'Not listed? Ask AI to investigate',
          ] as Copy
        }
        locale={locale}
        prompt={
          [
            `我停在“${lesson.title[0]}”。预期结果：${lesson.expected[0]}。实际画面/报错：[在这里补充]。请先根据已有文件检查原因，一次只给一个可逆的处理动作，说明在哪里操作、恢复后应看到什么。不要重建项目，不要删除已有成果。`,
            `I am at “${lesson.title[1]}”. Expected: ${lesson.expected[1]}. Actual screen/error: [add here]. Inspect existing files first. Give one reversible action at a time, its location, and expected result. Do not recreate the project or delete existing work.`,
          ] as Copy
        }
      />
    </details>

    <!-- 槽位 07 · 本步材料 -->
    <details class="step-slot step-extra" data-step-section="material">
      <summary>
        <Fragment
          set:html={heading(
            7,
            '本步材料（填写或复制）',
            'Material for this step (fill or copy)',
          )}
        />
        <span class="slot-fold-hint">
          <span class="when-closed">{label('展开', 'Open')}</span>
          <span class="when-open">{label('收起', 'Close')}</span>
          <Icon name="chevron" size={14} />
        </span>
      </summary>
      <p>
        {lesson.templateKind === 'worksheet' || lesson.id === 'idea'
          ? label(
              '先在下面填写自己的材料，点击确认后核对生成内容；什么时候交给工具，按上面的具体操作来。重新打开本页若只看到编辑框，核对后再点确认即可重新复制。',
              'Fill your own material below, confirm it and check the result. Follow the actions above for when to give it to your tool. If reopening shows only the editor, review and confirm again to copy.',
            )
          : label(
              '上面已经逐项发送并完成的，不必再发下面整段模板。需要整理本步材料时再使用；替换【】后确认，再复制到项目对话。',
              'If you completed the individual prompts above, do not resend this full template. Use it to organize this step’s material when needed; replace bracketed fields, confirm and copy into the project chat.',
            )}
      </p>
      {lesson.prompt ? (
        <PromptTemplate
          id={`learn-${lesson.id}`}
          title={
            lesson.templateKind === 'worksheet'
              ? (['这一步的填写模板', 'Worksheet for this step'] as Copy)
              : ([
                  '这一步的提示词模板',
                  'Prompt template for this step',
                ] as Copy)
          }
          kind={lesson.templateKind ?? 'prompt'}
          prompt={lesson.prompt}
          locale={locale}
        />
      ) : lesson.id === 'idea' ? (
        <IdeaDraft locale={locale} />
      ) : (
        <p>
          {label(
            '这一步不需要发给 AI：先在自己的笔记里填写。',
            'This step does not need a prompt. Write it in your own notes.',
          )}
        </p>
      )}
      <details class="learn-details" data-fullstack-prompt={stepId}>
        <summary>
          {label(
            '跟练个人学习记录：本步怎么填写／补充提示词',
            'Journal practice: fill or supplement this step',
          )}
        </summary>
        <p>
          {lesson.templateKind === 'worksheet' || stepId === 'idea'
            ? label(
                '这是填写方向，请把上方模板中的空白换成自己的真实信息。验收、费用、路径和测试结果不能照抄示例。',
                'Use this as guidance for filling the template with your real information. Never copy example acceptance, costs, paths or test results.',
              )
            : label(
                '仅当你选择本页全栈跟练时使用：使用下面已合并本步要求的提示词，填好空白后复制发送；不必重复发送上方通用模板。它不授权跳到后续步骤。',
                'For this full-stack practice only: use this combined prompt, fill its fields and send it once instead of also sending the generic template. It does not authorize later steps.',
              )}
        </p>
        {lesson.prompt && lesson.templateKind !== 'worksheet' ? (
          <PromptTemplate
            id={`fullstack-${stepId}`}
            title={
              ['全栈跟练：本步提示词', 'Full-stack practice: this step'] as Copy
            }
            locale={locale}
            prompt={
              [
                lesson.prompt[0] +
                  '\n\n本次已选择个人学习记录全栈跟练。\n' +
                  practice.instruction[0],
                lesson.prompt[1] +
                  '\n\nI selected the full-stack journal practice.\n' +
                  practice.instruction[1],
              ] as Copy
            }
          />
        ) : (
          <pre class="practice-instruction">{practice.instruction[locale==='zh-cn'?0:1]}</pre>
        )}
      </details>
    </details>

    <!-- 槽位 08 · 看到这个结果才算完成 -->
    <div class="step-slot step-slot-done">
      <Fragment
        set:html={heading(
          8,
          '看到这个结果才算完成',
          'Check this before continuing',
        )}
      />
      <p class="success-line">
        <Icon name="verify" size={18} />
        {t(lesson.expected, locale)}
      </p>
    </div>

    <!-- 槽位 09 · 没有出现预期结果时 -->
    <details class="step-slot step-extra">
      <summary>
        <Fragment
          set:html={heading(
            9,
            '没有看到预期结果，接下来怎么办？',
            'What should you do if the expected result is missing?',
          )}
        />
        <span class="slot-fold-hint">
          <span class="when-closed">{label('展开', 'Open')}</span>
          <span class="when-open">{label('收起', 'Close')}</span>
          <Icon name="chevron" size={14} />
        </span>
      </summary>
      <p>{t(support.recovery, locale)}</p>
      <details class="learn-details">
        <summary>
          {label(
            '看结果对照（教学示意，不是你的项目结果）',
            'Compare with an example (illustration, not your result)',
          )}
        </summary>
        <pre>{t(support.example, locale)}</pre>
      </details>
    </details>

    <!-- 固定区块 B · 按项目类型展开 -->
    <LearningBranches id={lesson.id} locale={locale} />

    <!-- 固定区块 C · 示例与参考资料 -->
    {(lesson.sample || lesson.refs || lesson.source) && (
      <details class="learn-details">
        <summary>{label('看示例或查资料', 'Examples and reference')}</summary>
        {lesson.sample && <p>{t(lesson.sample, locale)}</p>}
        {lesson.refs?.map((r) => (
          <p>
            <a href={`${url(locale, r.path)}?lesson=${lesson.id}`}>
              {t(r.title, locale)} →
            </a>
          </p>
        ))}
        {lesson.source && (
          <p>
            <a href={lesson.source} target="_blank" rel="noopener">
              {label('打开官方操作入口 ↗', 'Open the official instructions ↗')}
            </a>
          </p>
        )}
      </details>
    )}

    <!-- 固定区块 D · 记录与核对 -->
    <StepRecord id={lesson.id} locale={locale} />

    <button
      type="button"
      class="undo-progress"
      data-undo-complete={stepId}
      hidden
    >
      {label(
        '改动后需重查：撤销本动作完成标记',
        'Needs another check: undo completion',
      )}
    </button>
    <!-- 固定底栏 -->
    <div class="step-footer">
      <span class="slot-note">
        {label(`第 ${index} 步，共 ${total} 步`, `Step ${index} of ${total}`)}
      </span>
      {lesson.choices ? (
        <span class="step-choices">
          {lesson.choices.map((choice, i) => (
            <a
              class={
                i === lesson.choices!.length - 1
                  ? 'learn-primary'
                  : 'learn-help'
              }
              data-follow-step={choice.id}
              data-complete={
                ['feedback', 'repair-plan'].includes(choice.id)
                  ? undefined
                  : lesson.id
              }
              href={stepHref(choice.id)}
            >
              {t(choice.label, locale)} →
            </a>
          ))}
        </span>
      ) : nextHref && nextLabel ? (
        <a
          class="learn-primary"
          data-complete={lesson.id}
          data-follow-step={
            nextHref.startsWith('#') ? nextHref.slice(1) : undefined
          }
          href={nextHref}
        >
          {t(nextLabel, locale)} →
        </a>
      ) : (
        <button type="button" class="learn-primary" data-finish={lesson.id}>
          {label('已核对，记录完成', 'Checked, mark complete')}
        </button>
      )}
    </div>
  </div>
</details>

<style>
  .node-step {
    border: 1px solid #dfe6ee;
    border-radius: 12px;
    background: #fff;
    margin: 12px 0;
    overflow: hidden;
    scroll-margin-top: 90px;
  }
  .node-step[open] {
    border-color: #b9cade;
    box-shadow: 0 6px 18px #17243b0a;
  }
