---
import {t,url,type Locale,type Copy} from '../data/site';
import {stacks} from '../data/stacks';
import {journey} from '../data/journey';
import PromptTemplate from './PromptTemplate.astro';
const {locale}=Astro.props as {locale:Locale};
const fields:{name:string;title:Copy;options:[string,Copy][]}[]=[
{name:'type',title:['产品形式','Product form'],options:[['content',['展示或内容网站','Content website']],['web',['经常操作的网页工具','Interactive web tool']],['mobile',['手机 App','Mobile app']],['desktop',['桌面 App','Desktop app']],['mini',['小程序','Mini program']]]},
{name:'data',title:['资料保存','Data storage'],options:[['none',['不保存','No persistence']],['local',['只在本机','On this device']],['shared',['多人或多设备共享','Shared across people or devices']]]},
{name:'device',title:['设备能力','Device capabilities'],options:[['basic',['普通页面操作','Ordinary page interactions']],['native',['相机、文件或系统能力是核心','Camera, files, or system features are essential']]]},
{name:'login',title:['是否需要区分身份','Sign-in required'],options:[['no',['不需要','No']],['yes',['需要','Yes']]]},
{name:'budget',title:['运行预算','Operating budget'],options:[['zero',['先零预算试验','Zero-budget prototype first']],['paid',['可接受核实后的费用','Can accept verified costs']]]},
{name:'maintenance',title:['持续照看意愿','Ongoing upkeep'],options:[['limited',['希望尽量少照看','Prefer minimal upkeep']],['active',['能定期检查与维护','Can check and maintain regularly']]]},
{name:'existing',title:['已有可运行项目','Existing working project'],options:[['no',['没有','No']],['yes',['有，优先继续现有项目','Yes, prefer continuing it']]]}];
---
<header class="journey-intro"><p class="eyebrow">TECH STACK</p><h1>{t(['技术栈选择','Choosing a stack'],locale)}</h1><p>{t(['技术栈是制作与运行产品所需的一组技术和服务。先说明要完成的事情，让 AI 推荐并验证；不必先背技术名字。','A stack is the set of technologies and services used to build and run a product. Describe the task, then ask AI to recommend and validate a fit.'],locale)}</p></header>
<div class="example-box"><p>{t(['AI 助手负责制作 → 技术栈组成产品 → 托管服务放置或运行产品。三者费用和职责分别确认。','An AI assistant builds → a stack forms the product → hosting stores or runs it. Confirm each role and cost separately.'],locale)}</p></div>
<section class="section"><h2>{t(['先回答实际条件','Start with practical conditions'],locale)}</h2><form id="stack-form" data-locale={locale}><div class="stack-fields">{fields.map(f=><label>{t(f.title,locale)}<select name={f.name}><option value="unknown">{t(['尚未确定','Undecided'],locale)}</option>{f.options.map(([value,label])=><option value={value}>{t(label,locale)}</option>)}</select></label>)}</div><button class="button primary" type="submit">{t(['查看条件对应的候选','See candidates for these conditions'],locale)}</button></form><div class="example-box" id="stack-result" role="status"><p>{t(['尚未生成结果。未知项不会被当作满足条件。','No result yet. Unknowns are not treated as satisfied requirements.'],locale)}</p></div></section>
<section class="section"><h2>{t(['候选目录与代价','Candidate catalog and tradeoffs'],locale)}</h2><p class="muted">{t(['官方能力资料核验：2026-09-23。以下适用判断是本站按需求作出的建议；费用金额、设备兼容性和平台账号条件需制作前再次核对。','Official capability sources checked on 2026-09-23. Suitability is this guide’s assessment. Verify current prices, device compatibility, and account requirements before building.'],locale)}</p>{stacks.map(s=><article class="example-box" id={`stack-${s.id}`}><h3>{s.name}</h3><p>{t(s.summary,locale)}</p><p><strong>{t(['限制：','Limits: '],locale)}</strong>{t(s.limits,locale)}</p><p><strong>{t(['费用类型：','Cost categories: '],locale)}</strong>{t(s.cost,locale)}</p><a href={s.source}>{t(['官方说明','Official documentation'],locale)} ↗</a></article>)}</section>
<PromptTemplate id="stack-request" title={['让 AI 核对并推荐','Ask AI to verify and recommend']} prompt={journey.find(s=>s.id==='stack')!.prompt} locale={locale}/>
<section class="section"><h2>{t(['遇到分歧或未知项','Resolve uncertainty'],locale)}</h2><details class="example-box"><summary>{t(['两个 AI 推荐不同方案','Two assistants recommend different stacks'],locale)}</summary><p>{t(['把同一份需求、预算和目标设备同时交给两方。条件不同 → 先统一材料；条件相同 → 要求各自做同一条核心流程的小样，对照运行结果、费用和维护工作再选。不用框架流行度代替验证。','Give both the same requirements, budget, and target devices. Different assumptions → align the inputs. Same assumptions → ask for prototypes of the same core flow and compare observed behavior, costs, and upkeep. Popularity is not validation.'],locale)}</p></details><details class="example-box"><summary>{t(['不知道是否需要后端','Unclear whether a backend is needed'],locale)}</summary><p>{t(['只展示公开内容 → 先考虑无需保存的页面；只在一台设备保留资料 → 核对丢失与导出风险；多人共享或限制谁能访问 → 让 AI 设计保存与权限，并用两个身份试验。','Public content only → consider pages without persistence. Data on one device → review loss and export risks. Shared or restricted data → ask AI for storage and access rules, then test two identities.'],locale)}</p></details><a href={`${url(locale)}#stage-plan`}>{t(['下一步：生成可跟踪开发计划 →','Next: create a trackable build plan →'],locale)}</a></section>
<script>
import {selectStacks,stacks,type StackAnswers} from '../data/stacks';
import {t,type Locale} from '../data/site';
const form=document.querySelector<HTMLFormElement>('#stack-form')!;
form.addEventListener('change',()=>{document.querySelector('#stack-result')!.textContent=form.dataset.locale==='en'?'Conditions changed. Submit again to update candidates.':'条件已修改，请重新查看候选。';});
form.addEventListener('submit',e=>{e.preventDefault();const locale=form.dataset.locale as Locale;const result=selectStacks(Object.fromEntries(new FormData(form)) as unknown as StackAnswers);const container=document.querySelector('#stack-result')!;container.replaceChildren();const reason=document.createElement('p');reason.textContent=t(result.reason,locale);container.append(reason);for(const id of result.ids){const stack=stacks.find(s=>s.id===id)!;const link=document.createElement('a');link.href='#stack-'+id;link.textContent=stack.name+' → ';container.append(link);}});
</script>
<style>.stack-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:20px}.stack-fields label{font-weight:600;font-size:14px}.stack-fields select{display:block;width:100%;margin-top:7px;padding:10px;border:1px solid #9aa5b5;border-radius:6px;background:white;font:inherit}.example-box{margin-bottom:16px}@media(max-width:600px){.stack-fields{grid-template-columns:1fr}}</style>
