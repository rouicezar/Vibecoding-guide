---
import rows from '../data/fullstack-practice.json';
import {base} from '../data/base';
import {t,type Locale} from '../data/site';
interface Props {id:string;locale:Locale;}
const {id,locale}=Astro.props;
const row=rows.find(row=>row.id===id)!;
const text=(value:string[])=>value[locale==='zh-cn'?0:1];
const label=(zh:string,en:string)=>t([zh,en],locale);
---
<details class="practice-guide" data-fullstack-step={id} open={['idea','choose-stack','save'].includes(id)}>
 <summary>{label('跟练：个人学习记录（前端 + 后端 + 数据库）','Practice: personal journal (frontend + backend + database)')}</summary>
 <p class="practice-scope">{label('选择这个示例时，沿用同一个 learning-journal 项目逐步完成。已有自己的项目时，对照检查相关要求即可，不必另建项目。','Use the same learning-journal project throughout this example. For your own project, compare applicable requirements without creating another project.')}</p>
 <p>{text(row.action)}</p>
 <dl><dt>{label('本步应看到','Expected here')}</dt><dd>{text(row.expected)}</dd><dt>{label('卡住时','If stuck')}</dt><dd>{text(row.recovery)}</dd></dl>
 {row.issues.length>0&&<details class="practice-errors"><summary>{label('对照具体报错，找到下一步','Match an error to the next action')}</summary>{row.issues.map(issue=><section><h4>{text(issue.title)}</h4><dl><dt>{label('先检查','Check first')}</dt><dd>{text(issue.check)}</dd><dt>{label('这样处理','Try this')}</dt><dd>{text(issue.action)}</dd><dt>{label('恢复后','After recovery')}</dt><dd>{text(issue.expected)}</dd></dl></section>)}</details>}
 {['tool','open-project','first-file'].includes(id)&&<figure><a href={`${base}/images/guide/codex-location-map.png`} target="_blank" rel="noopener"><img src={`${base}/images/guide/codex-location-map.png`} width="1536" height="1024" loading="lazy" alt={label('Codex 定位示意：1 核对项目，2 在项目对话发送本步任务，3 打开文件核对。示意并非真实截图。','Codex conceptual map: 1 check project, 2 send this task in its chat, 3 open the file. Illustration, not a screenshot.')} /></a><figcaption>{label('点击放大。AI 绘制的定位示意，不是当前版本实机截图；图中示例文字不可替代本步骤提示词。','Click to enlarge. AI-generated conceptual map, not a current app screenshot; pictured example text is not this lesson’s prompt.')} <a href="https://learn.chatgpt.com/docs/projects" target="_blank" rel="noopener">{label('官方项目入口说明','Official project instructions')}</a></figcaption></figure>}
 {id==='choose-stack'&&<ol><li>{label('前端：你在浏览器看到、填写和点击的页面。','Frontend: the page you see, fill in and click.')}</li><li>{label('后端：收到保存请求后检查内容，决定能不能保存。接口就是页面向它交材料的入口。','Backend: receives requests, checks content and decides whether to save. An API is the entry for those requests.')}</li><li>{label('数据库：按编号保管记录。SQLite 是实际文件，不是浏览器缓存，也不是另一个必须注册的网站。','Database: stores numbered records. SQLite is a real file, not browser cache or another account you must register.')}</li></ol>}
 {id==='save'&&<ol class="save-checks">
 <li>{label('建表：让 Codex 报告数据库完整路径、entries 表和字段；重复启动不清空旧数据。','Table: report full database path, entries and fields; startup must preserve records.')}</li>
 <li>{label('接口：GET 是读取，POST 是提交。先用测试内容验证接口保存和返回编号，再试全空格输入应被拒绝。','API: GET reads, POST submits. Test saving and its returned ID, then rejection of spaces-only input.')}</li>
 <li>{label('接线：在网页点击保存，页面请求同一个服务的 /api/entries。只有后端保存成功才提示成功；失败保留输入。','Connect: Save sends to /api/entries on the same service. Show success only after persistence; retain input on failure.')}</li>
 <li>{label('读回：复制正在运行的实际网址到另一浏览器，查看同一编号。由 Codex 只读核对数据库记录；你不必先学会 SQL。','Read back: open the running URL in another browser and find the same ID. Codex checks the database read-only; you need not learn SQL first.')}</li>
 </ol>}
 {['save','flow','test'].includes(id)&&<figure><a href={`${base}/images/guide/${id==='test'?'journal-service-stopped':'journal-saved-example'}.png`} target="_blank" rel="noopener"><img src={`${base}/images/guide/${id==='test'?'journal-service-stopped':'journal-saved-example'}.png`} loading="lazy" alt={id==='test'?label('参考项目实测截图：服务停止后输入保留，页面没有显示保存成功。','Reference runtime: stopped service preserves input without claiming success.'):label('参考项目实测截图：通过后端保存到数据库后，页面显示编号 1 和历史记录。','Reference runtime: backend/database save produces record ID 1 and history.')} /></a><figcaption>{label('参考项目的实际运行截图。用于对照现象，不是你的项目验收结果。点击可放大。','Actual reference-project runtime, for comparison rather than your project acceptance. Click to enlarge.')}</figcaption></figure>}
 {['environment','choose-stack','save'].includes(id)&&<p class="practice-source"><a href="https://flask.palletsprojects.com/en/stable/installation/">{label('Flask 安装依据','Flask installation')}</a> · <a href="https://flask.palletsprojects.com/en/stable/tutorial/database/">{label('SQLite 与后端连接依据','SQLite integration')}</a></p>}
</details>
<style>
.practice-guide{margin-top:20px;border:1px solid #edcbaa;border-radius:10px;padding:16px;background:#fffaf5}.practice-guide>summary{font-size:16px;font-weight:650;cursor:pointer;line-height:1.6}.practice-guide p,.practice-guide li,.practice-guide dd{font-size:15px;line-height:1.8}.practice-scope,.practice-source,figcaption{color:#526071;font-size:13px!important}.practice-guide dt{font-weight:650;margin-top:10px}.practice-guide dd{margin-left:0}.practice-guide img{width:100%;height:auto;display:block;border-radius:8px}.practice-guide figure{margin:16px 0}.practice-guide a{text-decoration:underline}.save-checks li{margin:12px 0}
</style>
