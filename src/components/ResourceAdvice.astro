---
import {routeUrl} from '../data/nodes';
import PromptTemplate from './PromptTemplate.astro';
import {resourceTasks,resourcePrompt} from '../data/resource-tasks';
import {resourceGuidance} from '../data/resource-guidance';
import {t,type Locale,type Copy} from '../data/site';
const {path,locale}=Astro.props as {path:string;locale:Locale};
const item=resourceGuidance.find(r=>r.path===path.split('/')[0]);
---
{item&&<details class="resource-advice"><summary>{t(['这页的方法适合你的项目吗，怎样检查？','Does this method fit your project, and how can you check?'],locale)}</summary><dl>{[[['什么情况下会用到这页的方法？','When would you use this method?'],item.use],[['根据自己的情况，应该怎样选择？','How should you choose for your situation?'],item.decision],[['哪些情况容易判断错？','What is easy to misunderstand?'],item.avoid],[['怎样检查这个方法在你的项目中有用？','How can you check that this works for your project?'],item.check]].map(([label,copy])=><div><dt>{t(label as Copy,locale)}</dt><dd>{t(copy as Copy,locale)}</dd></div>)}</dl>{path===item.path&&!['data','check','launch','maintain'].includes(path)&&resourceTasks[item.path]&&<details class="resource-task"><summary>{t(['拿当前项目试一次：填写材料，生成本次任务','Try with this project: fill material and prepare the task'],locale)}</summary><PromptTemplate id={`resource-${item.path}`} locale={locale} title={['只处理当前判断','Handle this decision only']} prompt={resourcePrompt(item.path)}/></details>}<a href={routeUrl(locale,item.next)}>{t(['带着结果回到操作 →','Return to the action with the result →'],locale)}</a></details>}
<style>.resource-advice{margin:0 0 28px;border:1px solid #d9e6e9;border-radius:12px;padding:0 20px}.resource-advice summary{font-size:15px;padding:17px 0;font-weight:600}.resource-advice dl{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:5px 0 20px}.resource-advice dt{font-size:14px;font-weight:650;color:#2d7b78}.resource-advice dd{margin:8px 0 0;font-size:15px;color:#53677b;line-height:1.8}.resource-advice>a{display:inline-block;margin-bottom:20px;font-size:14px;color:#317f9e}@media(max-width:650px){.resource-advice dl{grid-template-columns:1fr}}
</style>
