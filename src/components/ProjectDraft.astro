---
import {t,type Locale} from '../data/site';
const {locale}=Astro.props as {locale:Locale};
---
<details class="learn-details" data-project-panel><summary>{t(['我的项目材料与备份','My project material and backups'],locale)}</summary>
<p>{t(['材料只存于这台设备的当前浏览器；不是项目文件，也不会自动发给 AI。中英文模板分别保存，项目选择和学习进度共用。不要在这里填写密码或 API Key。','Material stays in this browser, not in project files or AI chat. Chinese and English template drafts are separate; project selection and progress are shared. Do not enter passwords or API keys here.'],locale)}</p>
<label>{t(['当前项目','Current project'],locale)} <select data-project-select></select></label>
<button type="button" class="button" data-project-switch>{t(['切换到所选项目','Switch to selected project'],locale)}</button>
<label>{t(['另一个项目的名称（现有材料会保留）','Another project’s name (current material is kept)'],locale)} <input data-project-name maxlength="100" /></label>
<button type="button" class="button" data-project-new>{t(['新建独立草稿','Create separate draft'],locale)}</button>
<button type="button" class="button" data-project-export>{t(['备份本项目全部材料','Back up all project material'],locale)}</button>
<p class="local-note">{t(['包括想法、进度、各步模板、人工核对记录及选型条件；不包含你的真实项目代码。恢复会建立一个新草稿，不覆盖已有项目。','Includes idea, progress, template drafts, personal checks and selection conditions, but not project code. Restore creates a new draft and preserves existing projects.'],locale)}</p>
<label>{t(['从本站备份文件恢复','Restore a guide backup'],locale)} <input type="file" accept=".json,application/json" data-project-import /></label>
<details><summary>{t(['下载或导入不工作？复制备份文本恢复','Download/import unavailable? Restore backup text'],locale)}</summary><label>{t(['备份文本（点击备份后生成；也可粘贴本站备份）','Backup text (generated by backup; or paste a guide backup)'],locale)}<textarea rows="6" data-project-backup></textarea></label><button type="button" class="button" data-project-restore-text>{t(['从文本恢复为新草稿','Restore text as a new draft'],locale)}</button></details>
<p role="status" data-project-status></p>
</details>
<script>
import {projectList,activeProject,switchProject,createProject,exportProject,restoreProject} from '../scripts/project-storage';
const panel=document.querySelector<HTMLElement>('[data-project-panel]');if(panel){const en=document.documentElement.lang==='en';const status=panel.querySelector<HTMLElement>('[data-project-status]')!;const select=panel.querySelector<HTMLSelectElement>('[data-project-select]')!;try{for(const p of projectList()){const o=new Option(p.name,p.id);select.add(o);}select.value=activeProject();}catch{status.textContent=en?'Browser storage unavailable. Keep manual copies.':'浏览器存储不可用，请手动留底。';}
const run=(action:()=>void)=>{try{action();}catch{status.textContent=en?'Could not save or read material. Existing projects were kept; check the backup file and browser storage.':'无法保存或读取材料，已有项目已保留。请检查备份文件和浏览器存储空间。';}};
panel.querySelector('[data-project-switch]')!.addEventListener('click',()=>run(()=>{switchProject(select.value);location.reload();}));panel.querySelector('[data-project-new]')!.addEventListener('click',()=>run(()=>{const name=panel.querySelector<HTMLInputElement>('[data-project-name]')!.value;if(!name.trim()){status.textContent=en?'Enter a project name.':'请先填写新项目名称。';return;}createProject(name);location.reload();}));
panel.querySelector('[data-project-export]')!.addEventListener('click',()=>run(()=>{const backup=JSON.stringify(exportProject(),null,2);panel.querySelector<HTMLTextAreaElement>('[data-project-backup]')!.value=backup;const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([backup],{type:'application/json'}));a.download='vibe-project-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);status.textContent=en?'Backup download requested. Check the file or copy backup text below before switching devices.':'已请求下载备份。换设备前请确认文件存在，或展开下方复制备份文本。';}));
panel.querySelector('[data-project-restore-text]')!.addEventListener('click',()=>run(()=>{restoreProject(JSON.parse(panel.querySelector<HTMLTextAreaElement>('[data-project-backup]')!.value));location.reload();}));
panel.querySelector<HTMLInputElement>('[data-project-import]')!.addEventListener('change',async event=>{const file=(event.target as HTMLInputElement).files?.[0];if(!file)return;if(file.size>10000000){status.textContent=en?'Backup too large (10 MB maximum).':'备份过大（上限10 MB）。';return;}try{const data=JSON.parse(await file.text());restoreProject(data);location.reload();}catch{status.textContent=en?'Restore failed. Use a complete guide backup; current material was kept.':'恢复失败。请选择本站完整备份；当前材料已保留。';}});
}
</script>
<style>label{display:block;margin:16px 0 8px}input,select,textarea{max-width:100%;padding:8px;border:1px solid #cad6dd;border-radius:6px;font:inherit}.button{margin:8px 8px 8px 0}</style>
