---
import {learningBranches} from '../data/learning-branches';
import {t,type Locale} from '../data/site';
import PromptTemplate from './PromptTemplate.astro';
const {id,locale}=Astro.props as {id:string;locale:Locale};
const entries=learningBranches.filter(b=>b.lesson===id);
---
{entries.length>0&&<details class="learn-details"><summary>{t(['按我的项目类型，展开具体操作','Expand the instructions for my project'],locale)}</summary><p>{t(['只选择项目实际需要的分支。本分支提示词替代本页通用提示词，不要把所有分支一起发给AI。命令、配置值由AI读取当前项目确定；账号和渠道条件以当前官方说明为准。','Choose only relevant branches. Use the branch prompt instead of this page’s general prompt; do not send all branches together. AI derives commands/config from the actual project; verify current official account/channel requirements.'],locale)}</p>{entries.map(b=><details class="branch-detail"><summary>{t(b.title,locale)}</summary><p class="local-note">{t(b.when,locale)}</p><ol>{b.steps.map(s=><li>{t(s,locale)}</li>)}</ol><p><strong>{t(['完成条件：','Completion: '],locale)}</strong>{t(b.check,locale)}</p><details><summary>{t(['本分支提示词','Prompt for this branch'],locale)}</summary><PromptTemplate id={`branch-${b.id}`} locale={locale} title={b.title} prompt={b.prompt}/></details>{b.id==='ios'&&<p><a href="https://developer.apple.com/support/web-distribution-eu/" target="_blank" rel="noopener">{t(['其他渠道示例：Apple网页分发资格（非所有用户适用）','Alternative example: Apple web-distribution eligibility (not universal)'],locale)}</a></p>}{b.id==='mini-program'&&<p class="local-note">{t(['平台审核条件可能变化，请在官方后台核对。本教程未验证你的账号资格或完成真实审核。','Platform review requirements change. Verify in the official console; this guide has not tested your account eligibility or completed a review.'],locale)}</p>}{b.source&&<p><a href={b.source} target="_blank" rel="noopener">{t(['核对当前官方操作条件 ↗','Check current official instructions ↗'],locale)}</a></p>}</details>)}</details>}
<style>.branch-detail{border-top:1px solid #dbe5ea;padding:18px 0}.branch-detail summary{cursor:pointer;font-weight:650;line-height:1.7}.branch-detail li{margin:16px 0;line-height:1.85}.branch-detail ol{padding-left:24px}</style>
