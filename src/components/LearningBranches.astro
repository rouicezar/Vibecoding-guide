---
import {learningBranches} from '../data/learning-branches';
import {t,type Locale} from '../data/site';
import PromptTemplate from './PromptTemplate.astro';
const {id,locale}=Astro.props as {id:string;locale:Locale};
const entries=learningBranches.filter(b=>b.lesson===id);
---
{entries.length>0&&<details class="learn-details"><summary>{t(['按我的项目类型，展开具体操作','Expand the instructions for my project'],locale)}</summary><p>{t(['只选择项目实际需要的分支。每次只做一项，使用该项下面的提示词；已逐项完成时，不必再发送末尾的完整模板。命令、配置值由AI读取当前项目确定；账号和渠道条件以当前官方说明为准。','Choose only relevant branches. Complete one action at a time using its prompt; do not resend the full template after completing individual actions. AI derives commands/config from the actual project; verify current official account/channel requirements.'],locale)}</p>{entries.map(b=><details class="branch-detail"><summary>{t(b.title,locale)}</summary><p class="local-note">{t(b.when,locale)}</p><ol>{b.steps.map((s,i)=><li><p>{t(s,locale)}</p><p><strong>{t(['建议提示词：','Suggested prompt:'],locale)}</strong></p><pre>{t(b.actionPrompts[i],locale)}</pre></li>)}</ol><p><strong>{t(['怎样检查这个分支已经完成？','How can you check that this branch is complete?'],locale)}</strong>{t(b.check,locale)}</p><details><summary>{t(['本分支提示词','Prompt for this branch'],locale)}</summary><PromptTemplate id={`branch-${b.id}`} locale={locale} title={b.title} prompt={b.prompt}/></details>{b.id==='ios'&&<p><a href="https://developer.apple.com/support/web-distribution-eu/" target="_blank" rel="noopener">{t(['其他渠道示例：Apple网页分发资格（非所有用户适用）','Alternative example: Apple web-distribution eligibility (not universal)'],locale)}</a></p>}{b.id==='mini-program'&&<p class="local-note">{t(['打开平台官方后台，核对自己的账号资格和审核要求，再按页面提示准备资料。','Check your account eligibility and review requirements in the official console, then prepare the requested materials.'],locale)}</p>}{b.source&&<p><a href={b.source} target="_blank" rel="noopener">{t(['核对当前官方操作条件 ↗','Check current official instructions ↗'],locale)}</a></p>}</details>)}</details>}
<style>.branch-detail{border-top:1px solid #dbe5ea;padding:18px 0}.branch-detail summary{cursor:pointer;font-weight:650;line-height:1.7}.branch-detail li{margin:16px 0;line-height:1.85}.branch-detail ol{padding-left:24px}</style>
