---
import { Wrench, Terminal, Brain, House, LayoutGrid, Globe, Smartphone, Monitor, MessageSquare, Layers, PanelsTopLeft, Database, ListChecks, Upload, Settings, ArrowRight, Search, Menu, X, Check, Copy, BookOpen, ChevronRight, CircleQuestionMark } from '@lucide/astro';
interface Props {name:string; size?:number;}
const {name,size=18}=Astro.props;
const icons:Record<string,typeof House>={tool:Wrench,code:Terminal,brain:Brain,home:House,grid:LayoutGrid,browser:Globe,phone:Smartphone,monitor:Monitor,message:MessageSquare,layers:Layers,layout:PanelsTopLeft,database:Database,checklist:ListChecks,upload:Upload,settings:Settings,arrow:ArrowRight,search:Search,menu:Menu,close:X,check:Check,copy:Copy,book:BookOpen,chevron:ChevronRight,help:CircleQuestionMark};
const Glyph=icons[name]??CircleQuestionMark;
---
<Glyph size={size} stroke-width={1.65} aria-hidden="true" />
