---
import { icons } from '../data/icons';
interface Props {
  name: string;
  size?: number;
}
const { name, size = 18 } = Astro.props;
const glyph = icons[name] ?? icons.question;
---

<svg
  viewBox={glyph.viewBox}
  width={size}
  height={size}
  fill="currentColor"
  focusable="false"
  class="semantic-icon"
  aria-hidden="true"
  data-icon={name}
>
  {glyph.paths.map((d) => (
    <path d={d} />
  ))}
</svg>

<style>
  .semantic-icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
