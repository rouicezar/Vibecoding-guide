---
import {t,type Locale} from '../data/site';
import {toolReviews} from '../data/tool-reviews';
const {locale}=Astro.props as {locale:Locale};
---
<section id="reviews" class="review-section"><h2>{t(['别人怎样选择，用过后怎样评价','How others choose—and what they report'],locale)}</h2><p>{t(['结合独立实测、原始用户讨论与研究，共整理 8 个选型判断。评价反映特定任务和版本，不能替代当前产品规格；点击标题查看依据与局限。','Eight decision points drawn from independent tests, original user discussions and research. Experiences reflect particular tasks and versions, not current specifications. Open each topic for evidence and limits.'],locale)}</p><div class="review-grid">{toolReviews.map(review=><details><summary>{t(review.title,locale)}<span aria-hidden="true">＋</span></summary><div class="review-body"><span class="evidence-label">{t(['外部观察 · 意译','EXTERNAL OBSERVATION · PARAPHRASED'],locale)}</span><p>{t(review.finding,locale)}</p><span class="evidence-label">{t(['本站建议','OUR RECOMMENDATION'],locale)}</span><p>{t(review.advice,locale)}</p><p class="review-limit">{t(['适用边界：','Evidence limit: '],locale)}{t(review.limit,locale)}</p><div class="review-sources">{review.sources.map(source=><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a>)}</div></div></details>)}</div></section>
<style>.review-section{padding:24px 0 36px;scroll-margin-top:85px}.review-section>p{max-width:80ch;color:#5d6878;font-size:14px;line-height:1.85}.review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:20px}.review-grid details{border:1px solid #dfe5ed;border-radius:8px;align-self:start}.review-grid summary{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:17px;cursor:pointer;font-size:14px;font-weight:600}.review-grid details[open] summary span{transform:rotate(45deg)}.review-body{padding:0 17px 17px;font-size:14px;line-height:1.8}.evidence-label{font-size:11px;color:#657892;font-weight:600}.review-body p{margin:6px 0 16px}.review-limit{font-size:12px;color:#64748b;border-left:2px solid #d3dce9;padding-left:10px}.review-sources{display:flex;flex-direction:column;gap:5px;font-size:12px;color:#526987;overflow-wrap:anywhere}.review-sources a{text-decoration:underline;text-underline-offset:3px}@media(max-width:700px){.review-grid{grid-template-columns:1fr}}</style>
