---
import Icon from './Icon.astro';
import {t,url,type Locale} from '../data/site';
import {nodePhases,routeNodes,stepUrl} from '../data/nodes';
const {locale}=Astro.props as {locale:Locale};
const label=(zh:string,en:string)=>t([zh,en],locale);
const groups=nodePhases.map(phase=>({title:phase.title,caption:phase.caption,nodes:routeNodes.filter(node=>node.phaseId===phase.id)}));

---
<div class="project-map">
<p class="map-intro">{label('沿彩色路线，从想法走到交付。18 个关键节点串起 31 个教学动作，点击节点开始这一段。','Follow the colored path from idea to delivery. 18 milestones connect 31 guided actions; open a node to begin.')}</p>
<div class="serpent-map">
<svg class="route-track" viewBox="0 0 1000 1560" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="journey-colors" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ee7f86"/><stop offset="20%" stop-color="#53b8ad"/><stop offset="40%" stop-color="#6e9cde"/><stop offset="60%" stop-color="#e8b455"/><stop offset="80%" stop-color="#a38bd1"/><stop offset="100%" stop-color="#54b8c8"/></linearGradient></defs><path d="M 60 105 H 930 Q 978 105 978 153 V 317 Q 978 365 930 365 H 70 Q 22 365 22 413 V 577 Q 22 625 70 625 H 930 Q 978 625 978 673 V 837 Q 978 885 930 885 H 70 Q 22 885 22 933 V 1097 Q 22 1145 70 1145 H 930 Q 978 1145 978 1193 V 1357 Q 978 1405 930 1405 H 60" fill="none" stroke="url(#journey-colors)" stroke-width="5" vector-effect="non-scaling-stroke" stroke-linecap="round"/></svg>
{groups.map((group,i)=><section class={`journey-row color-${i}`}>
<header><span>{label(`阶段 ${i+1}`,`STAGE ${i+1}`)}</span><h2>{t(group.title,locale)}</h2><span class="direction">{i%2===0?'→':'←'}</span></header>
<ol style={`--count:${group.nodes.length}`}>{group.nodes.map(node=><li><a href={url(locale,`node/${node.id}`)}><span class="milestone"><Icon name={node.icon} size={25}/><b>{String(node.order).padStart(2,'0')}</b></span><h3>{t(node.title,locale)}</h3><p>{t(node.gloss,locale)}</p></a></li>)}</ol>
</section>)}
</div>
<div class="route-decisions">
<section><span class="decision-icon"><Icon name="refresh" size={23}/></span><h2>{label('没通过？沿这条路修好再继续','Not passed? Repair before continuing')}</h2><p>{label('人工验收或上线评估发现问题时：','When acceptance or release review finds an issue:')}</p><div class="repair-links"><a href={stepUrl(locale,'feedback')}>{label('记录反馈','Record feedback')}</a><span>→</span><a href={stepUrl(locale,'repair-plan')}>{label('修复计划与测试标准','Repair plan and criteria')}</a><span>→</span><a href={stepUrl(locale,'repair')}>{label('修复与复测','Repair and retest')}</a></div><p><a href={stepUrl(locale,'accept')}>{label('↶ 回到人工验收','↶ Return to acceptance')}</a><span> · </span><a href={stepUrl(locale,'release-review')}>{label('↶ 回到上线评估','↶ Return to release review')}</a></p></section>
<section><span class="decision-icon"><Icon name="route" size={23}/></span><h2>{label('选择适合项目的交付方式','Choose a delivery path')}</h2><div class="delivery-options"><a href={stepUrl(locale,'delivery')}><Icon name="monitor"/>{label('本机使用','Local use')}</a><a href={stepUrl(locale,'package')}><Icon name="browser"/>{label('网站部署','Web deployment')}</a><a href={stepUrl(locale,'package')}><Icon name="package"/>{label('应用安装包','App installer')}</a></div><p><a href={stepUrl(locale,'publish')}>{label('静态网站可参考 GitHub Pages ↗','GitHub Pages guide for static sites ↗')}</a></p><p>{label('交付后仍需检查实际入口，有问题就返回反馈与修复。','Check the real entry after delivery; return to feedback and repair if needed.')}</p></section>
</div>
<p class="map-note">{label('Git 与项目规则在第一次改文件前准备；进入节点后，按具体动作顺序操作。','Prepare Git and project rules before the first file changes; follow the guided action order inside each milestone.')}</p>
</div>
<style>
.project-map{margin:8px 0 36px}.map-intro{font-size:16px;color:#617187;margin:0 0 30px;line-height:1.8}.serpent-map{position:relative}.route-track{position:absolute;inset:0;width:100%;height:1560px;pointer-events:none}.journey-row{--tone:#ee7f86;position:relative;height:260px;padding:0 6%;}.color-1{--tone:#53b8ad}.color-2{--tone:#6e9cde}.color-3{--tone:#e8b455}.color-4{--tone:#a38bd1}.color-5{--tone:#54b8c8}.journey-row>header{display:flex;align-items:center;gap:14px;height:62px}.journey-row header>span:first-child{font-size:11px;color:#6c788b;letter-spacing:.08em}.journey-row h2{font-size:20px;margin:0;color:#23344a}.direction{color:var(--tone);font-size:24px}.journey-row:nth-of-type(even)>header{justify-content:flex-end}.journey-row ol{display:grid;grid-template-columns:repeat(var(--count),minmax(0,1fr));list-style:none;padding:11px 0 0;margin:0;gap:20px}.journey-row:nth-of-type(even) ol{direction:rtl}.journey-row li{direction:ltr;min-width:0;text-align:center}.journey-row a{display:block;text-decoration:none;color:inherit}.milestone{position:relative;display:grid;place-items:center;width:64px;height:64px;margin:0 auto 18px;background:#fff;color:var(--tone);border:3px solid var(--tone);border-radius:50%;box-shadow:0 0 0 7px #fff;transition:transform .2s,box-shadow .2s}.milestone b{position:absolute;bottom:-8px;right:-7px;background:var(--tone);color:#23344a;font-size:11px;line-height:22px;width:25px;border-radius:12px;border:2px solid #fff}.journey-row h3{font-size:16px;line-height:1.5;margin:0 0 7px;color:#24354c}.journey-row li p{font-size:13px;line-height:1.7;color:#68798e;margin:0 auto;max-width:230px}.journey-row a:hover .milestone{transform:translateY(-3px);box-shadow:0 0 0 7px #fff,0 8px 18px #334b6014}.journey-row a:focus-visible{outline:2px solid #397eb9;outline-offset:7px;border-radius:8px}.route-decisions{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:12px}.route-decisions section{border:1px dashed #8dbfb9;border-radius:18px;padding:25px;background:#fff}.route-decisions section+section{border-color:#a1b9dc}.decision-icon{color:#3c9990}.route-decisions h2{font-size:18px;margin:12px 0}.route-decisions p,.map-note{font-size:14px;color:#69798b;line-height:1.8}.route-decisions a{color:#326f9c;text-underline-offset:4px}.repair-links,.delivery-options{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-size:14px;line-height:1.8}.delivery-options a{display:flex;align-items:center;gap:7px;border:1px solid #dce6ed;border-radius:8px;padding:8px 10px;text-decoration:none}.map-note{margin-top:25px}
@media(max-width:700px){.route-track{display:none}.journey-row{height:auto;padding:0 0 28px 0}.journey-row>header,.journey-row:nth-of-type(even)>header{justify-content:flex-start;height:auto;margin-bottom:23px}.direction{display:none}.journey-row ol,.journey-row:nth-of-type(even) ol{display:flex;direction:ltr;flex-direction:column;gap:26px;margin-left:24px;padding:0 0 0 25px;border-left:3px solid var(--tone)}.journey-row li{text-align:left}.journey-row li a{position:relative;padding-left:20px;min-height:70px}.milestone{position:absolute;left:-51px;top:0;width:48px;height:48px;border-width:2px;box-shadow:0 0 0 5px white}.milestone :global(svg){width:21px;height:21px}.milestone b{font-size:10px;line-height:18px;width:22px}.journey-row li p{max-width:none;margin:0}.journey-row h3{font-size:17px}.route-decisions{grid-template-columns:1fr;gap:18px}.route-decisions section{padding:20px}.journey-row h2{font-size:19px}}
@media(prefers-reduced-motion:reduce){.milestone{transition:none}.journey-row a:hover .milestone{transform:none}}
</style>
