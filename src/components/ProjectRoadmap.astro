---
import {t,url,type Locale} from '../data/site';
const {locale}=Astro.props as {locale:Locale};
const label=(zh:string,en:string)=>t([zh,en],locale);
const groups=[
 {title:['把想法说清楚','Define the idea'],caption:['先明确要解决的问题','Start with the problem'],nodes:[
 ['idea','记录项目想法','Record the idea','明确用户、问题与预期结果','Users, problem and success criteria'],
 ['description','整理项目描述','Prepare the brief','一份可以交给 AI 的项目说明','A project brief ready for AI']]},
 {title:['准备协作空间','Prepare the workspace'],caption:['让 AI 在正确的项目里工作','Give AI the right workspace'],nodes:[
 ['tool','选择 AI 工具','Choose an AI tool','比较上手、额度、费用与能力','Compare ease, allowance, cost and capability'],
 ['folder','创建项目文件夹','Create the project folder','一个专属于本项目的存放位置','A dedicated location for the project'],
 ['open-project','在工具中打开项目','Open it in the tool','确认对话关联正确文件夹','Confirm the chat uses the correct folder']]},
 {title:['把需求变成计划','Turn needs into a plan'],caption:['先确定做什么、怎样算做好','Agree on scope and passing criteria'],nodes:[
 ['clarify','澄清需求与第一版范围','Clarify needs and scope','回答疑问，确定先做与暂不做的事','Resolve questions and bound version one'],
 ['requirements','形成需求与用户故事','Write requirements and stories','说明功能，以及用户怎样完成任务','Describe features and the user journey'],
 ['prototype','确认界面与技术方案','Agree on design and technology','关键页面、交互与实现方案','Key screens, interactions and implementation choices'],
 ['plan','制定开发计划与测试标准','Plan development and tests','可逐项执行、可检查的任务清单','Executable tasks with passing criteria']]},
 {title:['制作并验证功能','Build and verify'],caption:['每次做一小段，完成就检查','Build in small, verifiable increments'],nodes:[
 ['checkpoint','准备 Git 与项目规则','Prepare Git and project rules','可恢复的起点与 AI 工作约定','A recoverable baseline and AI instructions'],
 ['environment','检查环境并初始化项目','Check the environment and initialize','能启动的项目与再次打开的方法','A running project and restart instructions'],
 ['preview','按计划分步开发并测试','Build and test incrementally','走通核心操作，核对正常与异常结果','Verify the core flow and failure cases']]},
 {title:['验收与修复','Accept and repair'],caption:['由实际使用结果决定是否通过','Decide from real usage'],nodes:[
 ['accept','亲自测试完整使用过程','Test the full journey personally','对照最初目标，记录真实结果','Check the original goals against actual results'],
 ['delivery','选择交付方式','Choose how to deliver','自己用、网址或安装包','Personal use, a website or an installer'],
 ['release-review','评估上线与交付条件','Review release readiness','确认功能、数据、权限和恢复条件','Check functionality, data, access and recovery']]},
 {title:['交付与持续维护','Deliver and maintain'],caption:['从能运行，走到真正能使用','Verify the delivered experience'],nodes:[
 ['package','准备部署脚本或安装包','Prepare deployment or packaging','按交付方式生成产物并试运行','Prepare and trial the chosen deliverable'],
 ['live-check','交付上线，检查实际入口','Deliver and check the real entry','从用户入口完成一次真实操作','Complete a real task through the delivered entry'],
 ['maintain','记录维护与下一次迭代','Plan maintenance and the next change','留下启动、恢复与后续任务说明','Record startup, recovery and future tasks']]}
];
let offset=0;
const numbered=groups.map(g=>({...g,nodes:g.nodes.map(n=>({values:n,number:++offset}))}));
---
<div class="project-map">
<p class="map-intro">{label('按 01 → 18 看完整流程，节点内包含 31 个教学动作。点击进入操作与模板；有问题时沿修复回路返回。','Follow 18 milestones containing 31 guided actions. Open a node for instructions and templates; use the repair loops when needed.')}</p>
<div class="map-grid">{numbered.map((group,i)=><section class={`map-group tone-${i%4}`}>
<header><span class="group-number">{String(i+1).padStart(2,'0')}</span><div><h2>{t(group.title as [string,string],locale)}</h2><p>{t(group.caption as [string,string],locale)}</p></div></header>
<ol>{group.nodes.map(({values:n,number})=><li><a href={url(locale,`learn/${n[0]}`)}><span class="node-number">{String(number).padStart(2,'0')}</span><div><h3>{label(n[1],n[2])}</h3><p>{label(n[3],n[4])}</p></div><span class="node-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
{i===3&&<p class="map-note">{label('Git 和项目规则应在首次改文件前准备；环境初始化在方案与计划确认后进行。','Prepare Git and rules before the first file changes; initialize the runtime after the design and plan are agreed.')}</p>}
{i===4&&<div class="repair-loop"><strong>{label('↶ 验收或评估未通过','↶ Acceptance or readiness failed')}</strong><div><a href={url(locale,'learn/feedback')}>{label('记录反馈','Record feedback')}</a><span>→</span><a href={url(locale,'learn/repair-plan')}>{label('修复计划 + 测试标准','Repair plan + test criteria')}</a><span>→</span><a href={url(locale,'learn/repair')}>{label('修复并复测','Fix and retest')}</a></div><p>{label('验收问题回到 13；交付条件问题回到 15。通过后继续。','Return to 13 for acceptance or 15 for readiness. Continue when passed.')}</p></div>}
{i===5&&<div class="delivery-branches"><strong>{label('交付方式按项目选择','Choose the delivery path')}</strong><p>{label('本机使用 · 网站部署 · 应用安装包','Local use · Web deployment · App installer')}</p><a href={url(locale,'learn/publish')}>{label('简单静态网页：GitHub Pages 操作说明 ↗','Simple static sites: GitHub Pages instructions ↗')}</a><p>{label('实际入口有问题，返回记录反馈与修复。','If the real entry fails, return to feedback and repair.')}</p><a href={url(locale,'learn/feedback')}>{label('↶ 记录交付后的问题','↶ Report a delivery issue')}</a></div>}
</section>)}</div>
</div>
<style>
.project-map{margin:12px 0 40px}.map-intro{font-size:16px;line-height:1.8;color:#617087;margin:0 0 32px}.map-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 28px}.map-group{--tone:#df3044;min-width:0}.tone-1{--tone:#50a976}.tone-2{--tone:#4385e8}.tone-3{--tone:#ef791c}.map-group>header{display:flex;gap:14px;align-items:flex-start;margin-bottom:22px}.group-number{font-size:30px;line-height:1.2;font-weight:650;color:var(--tone)}.map-group h2{font-size:21px;line-height:1.4;margin:0;color:#19283e}.map-group header p{font-size:13px;margin:6px 0 0;color:#6c7b8e}.map-group ol{list-style:none;padding:0;margin:0}.map-group li{position:relative;margin:0 0 18px}.map-group li:not(:last-child)::after{content:'↓';position:absolute;left:23px;bottom:-19px;color:var(--tone);font-size:14px;line-height:18px}.map-group li>a{display:flex;align-items:flex-start;gap:12px;padding:18px 16px;border:1px solid color-mix(in srgb,var(--tone) 65%,white);border-radius:12px;text-decoration:none;background:white;min-height:104px;transition:transform .18s,box-shadow .18s}.map-group li>a:hover{transform:translateY(-2px);box-shadow:0 5px 16px #172a4110}.node-number{color:var(--tone);font-size:12px;font-weight:650;line-height:26px}.map-group h3{font-size:17px;line-height:1.5;margin:0 0 6px;color:#23344d}.map-group li p{font-size:14px;line-height:1.6;margin:0;color:#66768b}.node-arrow{margin-left:auto;color:var(--tone);font-size:15px;flex-shrink:0}.repair-loop,.delivery-branches{border:1px dashed var(--tone);border-radius:12px;padding:18px;margin-top:22px;font-size:14px;line-height:1.7}.repair-loop strong,.delivery-branches strong{color:#263b55;font-size:15px}.repair-loop>div{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.repair-loop a,.delivery-branches a{color:#285f9c;text-underline-offset:4px}.repair-loop p,.delivery-branches p,.map-note{color:#65768a;font-size:13px;line-height:1.8;margin:12px 0 0}.delivery-branches>a{display:block;margin-top:10px}.map-note{padding:0 8px}.project-map a:focus-visible{outline:3px solid #4385e8;outline-offset:4px}@media(max-width:1150px){.map-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.map-grid{grid-template-columns:1fr;gap:30px}.map-group li>a{min-height:0}.map-group h2{font-size:20px}}@media(prefers-reduced-motion:reduce){.map-group li>a{transition:none}.map-group li>a:hover{transform:none}}
</style>
