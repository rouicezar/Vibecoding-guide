---
import {t,url,type Locale} from '../data/site';
import {stepUrl} from '../data/nodes';
import {scenarios,makePrompt} from '../data/communication';
import ToolGuide from './ToolGuide.astro';
import PromptTemplate from './PromptTemplate.astro';
const {locale}=Astro.props as {locale:Locale};
const fields=[['你的项目现在做到哪一步了？','What stage has your project reached?'],['项目的用户群体是谁？','Who will use this project?'],['现在遇到什么问题，希望解决后变成什么样？','What is wrong now, and what do you want to happen instead?'],['有哪些文件、截图或操作记录可以提供给 AI？','Which files, screenshots or steps can you give AI?'],['这次有什么限制，哪些内容不要改？','What are the limits, and what should remain unchanged?']] as const;
---
<header class="journey-intro"><p class="eyebrow">AGENT COMMUNICATION</p><h1>{t(['和 Agent 沟通','Talking to agents'],locale)}</h1><p>{t(['Agent 是能使用工具、执行多步工作的 AI 助手。选一个当前任务，把背景和完成标准一起交给 AI。','An agent is an AI assistant that can use tools and perform multi-step tasks. Choose a task and provide its context and acceptance criteria.'],locale)}</p></header>
<details class="section"><summary>{t(['第一次使用？看准备说明和表达示例','First time? Preparation and examples'],locale)}</summary><div class="practice-links"><p>{t(['第一次开始：先准备制作工具和项目，再把想法交给 AI。已经在制作时，直接选择下方当前场景。','First time: prepare the building tool and project, then hand over the idea. For work already in progress, choose the current scenario below.'],locale)}</p><a href={url(locale,'tools')}>{t(['选工具并打开项目 →','Choose a tool and open a project →'],locale)}</a><br/><a href={url(locale,'communicate/setup')}>{t(['初始化 Git 与生成 AGENTS.md →','Set up Git and AGENTS.md →'],locale)}</a></div><div class="example-box"><h2>{t(['怎样把想法说清楚，让 AI 知道要做什么？','How can you explain your idea so AI knows what to do?'],locale)}</h2><p>{t(['比如：“改好看一点” → “预约页先显示日期，再显示余量和提交按钮；手机上不横向滚动，空日期不能提交。”','For example: “Make it look better” → “Show the date, capacity, and submit button in order. Avoid horizontal scrolling on a phone and reject empty dates.”'],locale)}</p></div></details>
<details class="section"><summary>{t(['选择或更换任务场景','Choose or change the task'],locale)}</summary><nav class="anchor-nav" aria-label={t(['任务场景','Task scenarios'],locale)}>{scenarios.map(s=><a href={`#${s.id}`}>{t(s.title,locale)}</a>)}</nav></details>
{scenarios.map((s,i)=><section class="section communication-scene" id={s.id}><h2>{t(s.title,locale)}</h2><p>{t(s.task,locale)}</p><p class="small muted">{t(['比如：','For example: '],locale)}{t(s.example,locale)}</p><p class="muted">{t(['这样说明的原因：AI 能把本次目标与已有工作分开，交付后也有明确依据检查。','Why this helps: AI can separate the current goal from existing work and provide results that can be checked.'],locale)}</p><div class="communication-grid"><form data-prompt-form data-index={i} data-locale={locale}><h3>{t(['填写实际材料','Add actual material'],locale)}</h3><p class="small">{t(['下方提供可编辑模板。先填好实际材料，再生成本次话术；材料保存在当前浏览器，不上传。未知项可填写“尚未确定”。','An editable template is provided below. Fill the fields to generate a project-specific prompt. Inputs stay in this browser and are not uploaded. Unknowns can be marked undecided.'],locale)}</p>{fields.map((f,j)=><label class="prompt-field" for={`${s.id}-${j}`}>{t(f,locale)}<textarea id={`${s.id}-${j}`} name={`field-${j}`} required rows={j===2?3:2} placeholder={j===2?t(s.example,locale):t(['填写实际情况或尚未确定','Add actual details or write undecided'],locale)}></textarea></label>)}<button class="button primary" type="submit">{t(['生成本次提示词','Generate this prompt'],locale)}</button><p role="status" data-generation-status></p></form><details class="generated-prompt"><summary>{t(['查看提示词与检查标准','View prompt and checks'],locale)}</summary><PromptTemplate id={`scene-${s.id}`} title={['通用模板 · 填写后发送','General template · fill before sending']} prompt={[makePrompt(i,'zh-cn'),makePrompt(i,'en')]} locale={locale}/><h3>{t(['收到 AI 的结果后，应该检查什么？','What should you check after AI responds?'],locale)}</h3><ul><li>{t(['是否对应本次目标，而非自行增加功能？','Does it address this goal without adding unrelated features?'],locale)}</li><li>{t(['是否给出实际证据，并把未执行的事项标清？','Does it include evidence and clearly mark unexecuted work?'],locale)}</li><li>{t(['不满足时，指出具体偏离项，要求只修正这一项再复查。','If a criterion fails, identify the deviation and request a focused correction and recheck.'],locale)}</li></ul></details></div></section>)}
<details class="section"><summary>{t(['卡住时按结果继续','Troubleshoot by observed result'],locale)}</summary>{[
[['AI 忘记要求','AI loses the requirements'],['先让 AI 复述范围。复述错误 → 补上最新确认材料再核对；复述正确但结果偏离 → 使用“只修改一个地方”模板；连续偏离 → 使用“新会话接手”整理后再继续。','Ask AI to restate the scope. Incorrect → provide the latest agreed material and recheck. Correct but implementation differs → use “Change one thing.” Repeated drift → prepare “Hand off to a new conversation.”']],
[['AI 只给建议，没有执行','AI advises but does not execute'],['核对当前工具是否可读写项目并运行命令。有能力 → 要求报告实际文件与执行结果；无能力 → 将交接材料带到具备执行能力的工具。不要把建议标成已完成。','Check whether the tool can edit project files and run commands. If yes, request actual files and execution results. If not, move the handoff material to a capable tool. Advice is not completed work.']],
[['反复修改仍未解决','Repeated changes do not solve it'],['停止扩大修改，记录每次尝试与结果。能复现 → 先排查证据再做单项修复；不能复现 → 补设备、步骤与发生时间。没有可恢复版本时先保留现状，不直接覆盖。','Stop broadening changes and record attempts and results. Reproducible → investigate evidence, then make one fix. Not reproducible → add device, steps, and time. Preserve the current state before overwriting anything.']]
].map(([question,answer])=><details class="example-box"><summary>{t(question as any,locale)}</summary><p>{t(answer as any,locale)}</p></details>)}</details>
<details class="section"><summary>{t(['还没有可用的 AI 工具？','Need an AI tool?'],locale)}</summary><ToolGuide locale={locale}/></details>
<details class="section"><summary>{t(['准备工具与材料','Prepare tools and material'],locale)}</summary><p>{t(['前期讨论可使用聊天工具；执行开发需要能访问项目文件并运行检查的助手。已有项目先说明文件位置、启动办法和最近验证结果；参考图说明借鉴哪一部分，截图中遮去真实个人资料和密钥。工具能力和费用以使用时实际界面与官方说明为准。','Chat tools can support early discussions. Development requires an assistant able to access project files and run checks. For an existing project, include file locations, start commands, and recent check results. Explain which part of a reference image matters and remove personal data and keys. Confirm capabilities and costs in the current tool and official documentation.'],locale)}</p><p>{t(['Prompt 是发给 AI 的任务说明；Context 是本次提供的背景材料；验收标准是可以实际检查的完成条件。','A prompt is the task instruction sent to AI. Context is the background material provided. Acceptance criteria are observable conditions for completion.'],locale)}</p><a href={stepUrl(locale,'requirements')}>{t(['下一步：把确认的范围整理成需求文档 →','Next: turn the agreed scope into requirements →'],locale)}</a></details>
<script>
import {projectStorage as localStorage} from '../scripts/project-storage';
import {makePrompt,scenarios} from '../data/communication';
import type {Locale} from '../data/site';
const selectScene=()=>{const requested=location.hash.slice(1);const selected=scenarios.some(s=>s.id===requested)?requested:'first';document.querySelectorAll<HTMLElement>('.communication-scene').forEach(section=>section.hidden=section.id!==selected);document.querySelectorAll<HTMLAnchorElement>('.anchor-nav a').forEach(link=>{if(link.hash==='#'+selected)link.setAttribute('aria-current','step');else link.removeAttribute('aria-current');});document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(link=>link.hash=requested&&document.getElementById(requested)?requested:selected);};
selectScene();window.addEventListener('hashchange',selectScene);
document.querySelectorAll<HTMLFormElement>('[data-prompt-form]').forEach(form=>form.addEventListener('submit',event=>{
 event.preventDefault();const fields=Array.from(form.querySelectorAll<HTMLTextAreaElement>('textarea'));
 fields.forEach(field=>field.setCustomValidity(field.value.trim()?'':form.dataset.locale==='en'?'Add a value or write undecided.':'请填写实际情况或尚未确定。'));
 if(!form.reportValidity())return;
 (form.parentElement!.querySelector('.generated-prompt') as HTMLDetailsElement).open=true;
 const index=Number(form.dataset.index);const id=`scene-${scenarios[index].id}`;const en=form.dataset.locale==='en';
 document.querySelector(`[data-template-text="${id}"]`)!.textContent=makePrompt(index,form.dataset.locale as Locale,fields.map(f=>f.value.trim()));
 (document.querySelector(`[data-copy-template="${id}"]`) as HTMLButtonElement).disabled=false;
 document.querySelector(`#prompt-title-${id}`)!.textContent=en?'Prepared prompt · review before sending':'本次提示词 · 核对后发送';
 document.querySelector(`[data-template-status="${id}"]`)!.textContent='';
 document.getElementById('template-'+id)!.dispatchEvent(new Event('template:ready'));
 form.querySelector('[data-generation-status]')!.textContent=en?'Updated. Review and copy the adjacent prompt.':'已更新，请核对旁边的完整提示词后复制。';
}));
document.querySelectorAll<HTMLTextAreaElement>('[data-prompt-form] textarea').forEach(field=>field.addEventListener('input',()=>{field.setCustomValidity('');const form=field.closest('form')!;const id=`scene-${scenarios[Number(form.dataset.index)].id}`;document.getElementById('template-'+id)!.dispatchEvent(new Event('template:dirty'));(document.querySelector(`[data-copy-template="${id}"]`) as HTMLButtonElement).disabled=true;try{localStorage.setItem('vibe-communication-'+id,JSON.stringify(Array.from(form.querySelectorAll('textarea')).map(f=>f.value)));}catch{form.querySelector('[data-generation-status]')!.textContent=form.dataset.locale==='en'?'Saving failed; keep a copy before leaving.':'保存失败，离开前请自行留底。';return;}form.querySelector('[data-generation-status]')!.textContent=form.dataset.locale==='en'?'Fields changed. Generate again to update the prompt.':'材料已修改，请重新生成以更新提示词。';}));
document.querySelectorAll<HTMLFormElement>('[data-prompt-form]').forEach(form=>{const id=`scene-${scenarios[Number(form.dataset.index)].id}`;try{const saved=JSON.parse(localStorage.getItem('vibe-communication-'+id)||'null');if(Array.isArray(saved)&&saved.length===5&&saved.every(v=>typeof v==='string')){form.querySelectorAll('textarea').forEach((field,i)=>field.value=saved[i]);(document.querySelector(`[data-copy-template="${id}"]`) as HTMLButtonElement).disabled=true;document.getElementById('template-'+id)!.dispatchEvent(new Event('template:dirty'));form.querySelector('[data-generation-status]')!.textContent=form.dataset.locale==='en'?'Draft restored. Generate to update the prompt.':'已恢复草稿，请生成本次提示词。';}}catch{}});
</script>
<style>.communication-grid{display:grid;grid-template-columns:minmax(0,1fr);max-width:740px;gap:28px}.prompt-field{display:block;font-size:14px;font-weight:600;margin:14px 0}.prompt-field textarea{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:10px;border:1px solid #9aa5b5;border-radius:6px;font:inherit;resize:vertical}.communication-scene{scroll-margin-top:90px}.communication-grid form{min-width:0}.communication-grid .prompt-template{margin-top:0}details+details{margin-top:10px}@media(max-width:850px){.communication-grid{grid-template-columns:1fr}}</style>
