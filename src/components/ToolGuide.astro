---
import {t,type Locale,type Copy} from '../data/site';
const {locale}=Astro.props as {locale:Locale};
const topics:{title:Copy;body:Copy;check:Copy}[]=[
{title:['你想在网页里操作，还是安装到电脑？','Would you rather work in a browser or install a tool?'],body:['网页工具可减少本机准备，但先确认项目导出和当前地区能否使用。电脑里的助手适合接手本地文件，但需要安装和核对运行环境。','Browser-based tools can reduce local setup, but verify export and regional availability. Local assistants suit existing files but require installation and environment checks.'],check:['不愿安装 → 排除必须本机安装的方式；必须只在本机处理 → 排除需要上传项目的方式。','No installation → exclude tools requiring local installation. Local-only processing → exclude tools requiring project upload.']},
{title:['只展示内容，还是需要保存用户填写的资料？','Will it only display content, or also save user input?'],body:['介绍页需要生成界面和内容；保存资料还需要服务连接、身份权限和真实写入读取检查。画面能生成不代表这些已接通。','An introduction page needs content and UI. A data app also needs service connections, identity rules, and real write/read checks. Generating a screen does not connect these.'],check:['用测试记录提交并刷新，再用另一个身份核对访问；不能检查真实保存的工具还需要执行环境配合。','Submit and reload a test record, then check another identity. Tools unable to test real storage need a separate execution environment.']},
{title:['已经有项目时，怎样让工具接着做？','How can the tool continue an existing project?'],body:['提供文件位置、启动办法、已确认需求与最近检查结果，让 AI 先读取并复述。先改一处文案，不立刻重建项目。','Provide files, startup steps, approved requirements, and recent checks. Ask AI to read and restate them, then change one text label before rebuilding anything.'],check:['能打开原项目、保留原功能并解释改动位置，才扩大任务；无法导入则先解决交接。','Expand the task only after opening the original project, preserving behavior, and explaining changed files. Resolve import problems first.']},
{title:['工具、AI 用量和项目运行分别要花多少钱？','What do the tool, AI usage and project running each cost?'],body:['工具订阅是使用助手的费用；AI调用费随实际计费规则变化；产品运行费是域名、托管、资料服务等持续开销。三者可能分开收取。','Tool subscriptions pay for assistant access; AI usage follows the provider’s billing rules; product operation covers domains, hosting, and data services. They may be billed separately.'],check:['查看当前账单、额度与超额规则；未核验金额写未知。先设预算再决定购买或上线。','Inspect current billing, allowances, and overage rules. Mark unverified amounts unknown and set a budget before buying or releasing.']},
{title:['换工具以后，还能拿到文件并继续使用吗？','Can you keep the files and continue after switching tools?'],body:['先确认地区可用性、文件能否导出、导出后能否独立运行、资料能否另存和迁移。不要等项目做完才检查。','Check regional availability, file export, independent execution, and data export/migration before building the full product.'],check:['实际导出一个样例，在独立目录启动；不能完成则记录受限部分，再判断是否接受依赖。','Export a sample and run it in a separate directory. Record restrictions and decide whether the dependency is acceptable.']},
{title:['先做小任务再决定','Try one small task before committing'],body:['让候选工具读取同一份小需求，制作一个日期输入和结果页面；记录花费、是否能导出、能否修复一次错误。','Give candidates the same small requirement: a date input and result page. Record cost, export ability, and whether a reported error can be fixed.'],check:['相同任务、相同完成标准进行比较；截图漂亮不是完成真实保存或长期可维护的证据。','Compare the same task and criteria. An attractive screenshot does not prove persistence or maintainability.']}
];
---
<section class="section" id="tools"><h2>{t(['选择 AI 工具，先检查这六件事','Six checks before choosing an AI tool'],locale)}</h2><p>{t(['这里比较工具类型，不推荐未经核验的品牌或价格。工具负责协助制作，产品技术栈另在技术栈板块选择。','Compare tool types here; unverified brands and prices are not recommendations. The assistant helps build; choose product technologies in the stack module.'],locale)}</p>{topics.map(topic=><details class="example-box"><summary>{t(topic.title,locale)}</summary><p>{t(topic.body,locale)}</p><p><strong>{t(['用自己的项目这样检查：','Check this with your own project: '],locale)}</strong>{t(topic.check,locale)}</p></details>)}<form id="tool-check" data-locale={locale}><fieldset><legend>{t(['先排除不满足硬条件的类型','Exclude types that conflict with hard constraints'],locale)}</legend><label>{t(['能否在电脑安装工具','Can tools be installed locally'],locale)}<select name="install"><option value="unknown">{t(['尚未确定','Undecided'],locale)}</option><option value="yes">{t(['可以','Yes'],locale)}</option><option value="no">{t(['不能','No'],locale)}</option></select></label><label>{t(['项目是否必须只在本机处理','Must project processing stay local'],locale)}<select name="local"><option value="unknown">{t(['尚未确定','Undecided'],locale)}</option><option value="yes">{t(['必须','Yes'],locale)}</option><option value="no">{t(['可接受已确认的云端处理','Approved cloud processing is acceptable'],locale)}</option></select></label><button class="button" type="submit">{t(['查看下一步检查','See the next check'],locale)}</button></fieldset><p role="status" id="tool-result"></p></form></section>
<script>
const form=document.querySelector<HTMLFormElement>('#tool-check')!;form.addEventListener('submit',e=>{e.preventDefault();const data=new FormData(form);const install=data.get('install'),local=data.get('local'),en=form.dataset.locale==='en';document.querySelector('#tool-result')!.textContent=install==='unknown'||local==='unknown'?(en?'Clarify installation and data-processing constraints before choosing a tool.':'先明确安装条件与资料处理范围，再选择工具。'):install==='no'&&local==='yes'?(en?'These constraints may conflict. Verify a browser tool that demonstrably processes locally, or revise one constraint; do not assume cloud tools qualify.':'条件可能冲突。需要核实确实仅本机处理的浏览器工具，或调整其中一项限制；不能默认云端工具满足。'):install==='no'?(en?'Consider browser-based tools. Verify export, regional access, and independent execution with one small task.':'可考察网页工具，先用一个小任务验证导出、地区可用性和独立运行。'):local==='yes'?(en?'Consider local tools, but verify the actual processing location and model connection. Installed locally does not imply local AI processing.':'可考察本机工具，但必须核对实际资料处理位置与模型连接；安装在本机不代表 AI 处理也在本机。'):(en?'Browser and local tools are both candidates. Compare the same small task, import/export, costs, and maintenance.':'网页和本机工具都可考察，用同一小任务比较导入导出、费用和维护。');});form.addEventListener('change',()=>document.querySelector('#tool-result')!.textContent='');
</script>
<style>details{margin-bottom:12px}fieldset{border:1px solid #dce1e9;padding:18px}fieldset label{display:block;margin:12px 0}fieldset select{display:block;max-width:100%;padding:8px;margin-top:6px}</style>
