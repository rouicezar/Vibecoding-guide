---
import {projects,t,url,type Locale} from '../data/site';
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
interface Props {locale:Locale;}
const {locale}=Astro.props;
---
<div class="page-intro"><div class="eyebrow">PROJECT TYPES</div><h1>{t(['想做一个什么产品？','What kind of product to build?'],locale)}</h1><p class="lead">{t(['先选择产品用在哪里，再决定怎么做。不确定的话，从一个小网站开始。','Choose where people will use the product. When unsure, start with a small website.'],locale)}</p></div>
<div class="callout"><Icon name="book"/><div><strong>{t(['项目分类 · Project Types','Project types, in plain language'],locale)}</strong><p>{t(['同一个想法，可以做成不同形式。区别在于用户在哪里打开、是否需要安装，以及使用者要准备什么。','The same idea can take different forms. The differences are where it opens, whether it needs installation, and the required preparation.'],locale)}</p></div></div>
<div class="project-grid">{projects.map(p=><article class="project-card"><a class="visual-link" href={url(locale,`projects/${p.id}`)} aria-label={t(p.title,locale)}><ProjectVisual project={p} locale={locale}/></a><div class="project-card-body"><span class:list={['badge',{blue:p.id==='web'}]}>{t(p.badge,locale)}</span><h2><Icon name={p.icon} size={22}/>{t(p.title,locale)}</h2><p>{t(p.tagline,locale)}</p><ul class="feature-list">{p.features.map(f=><li><Icon name="check" size={15}/>{t(f,locale)}</li>)}</ul><a class="text-link" href={url(locale,`projects/${p.id}`)}>{t(['查看制作路线','Explore the guide'],locale)}<Icon name="arrow" size={17}/></a></div></article>)}</div>
<section class="section"><h2>{t(['放在一起，更容易选','Compare the options'],locale)}</h2><div class="table-scroll"><table><thead><tr><th>{t(['项目','Project'],locale)}</th><th>{t(['适合谁','Who it is for'],locale)}</th><th>{t(['最后得到什么','Expected result'],locale)}</th></tr></thead><tbody>{projects.map(p=><tr><th><a href={url(locale,`projects/${p.id}`)}>{t(p.title,locale)}</a></th><td>{t(p.audience,locale)}</td><td>{t(p.result,locale)}</td></tr>)}</tbody></table></div></section>
