---
import {projects,t,url,type Locale} from '../data/site';
import ProjectFit from './ProjectFit.astro';
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
interface Props {locale:Locale;}
const {locale}=Astro.props;
---
<div class="page-intro"><div class="eyebrow">PROJECT TYPES</div><h1>{t(['想做一个什么产品？','What kind of product to build?'],locale)}</h1><p class="lead">{t(['先判断用户从哪里打开、是否需要安装、关键能力是什么，再比较四种形式。不确定时先验证关键能力。','Compare user entry, installation needs and essential capabilities. Validate uncertain requirements before choosing.'],locale)}</p></div>
<div class="callout"><Icon name="book"/><div><strong>{t(['项目分类 · Project Types','Project types, in plain language'],locale)}</strong><p>{t(['同一个想法，可以做成不同形式。区别在于用户在哪里打开、是否需要安装，以及使用者要准备什么。','The same idea can take different forms. The differences are where it opens, whether it needs installation, and the required preparation.'],locale)}</p></div></div>
<details class="selection-start"><summary>{t(['还是不知道怎么选？先回答这四个问题','Still unsure? Start with four questions'],locale)}</summary><ol><li>{t(['用户主要在手机、电脑还是某个现有平台里？','Where are the users: phone, computer or an existing platform?'],locale)}</li><li>{t(['发一个网址就能完成任务，还是安装带来不可替代的价值？','Can a link complete the task, or does installation add essential value?'],locale)}</li><li>{t(['必须使用哪些文件、设备或后台能力？先验证，不凭想象选。','Which file, device or background capabilities are essential? Validate them first.'],locale)}</li><li>{t(['是否有目标设备、账号、预算和持续维护条件？','Are target devices, accounts, budget and upkeep available?'],locale)}</li></ol><p>{t(['多个形式都能满足时，先做最容易接触真实用户、且关键能力已验证的一种。一次性文件处理也可能只需要脚本，不必强行归入四类完整应用。','If several forms fit, start with the one that reaches real users with verified essential capabilities. One-off file work may only need a script, not a full application.'],locale)}</p></details>
<div class="project-grid">{projects.map(p=><article class="project-card"><a class="visual-link" href={url(locale,`projects/${p.id}`)} aria-label={t(p.title,locale)}><ProjectVisual project={p} locale={locale}/></a><div class="project-card-body"><span class:list={['badge',{blue:p.id==='web'}]}>{t(p.badge,locale)}</span><h2><Icon name={p.icon} size={22}/>{t(p.title,locale)}</h2><p>{t(p.tagline,locale)}</p><ProjectFit id={p.id} locale={locale} compact/><a class="text-link" href={url(locale,`projects/${p.id}`)}>{t(['查看适用条件与下一步','Check fit and next steps'],locale)}<Icon name="arrow" size={17}/></a></div></article>)}</div>
<section class="section"><h2>{t(['放在一起，更容易选','Compare the options'],locale)}</h2><div class="table-scroll"><table><thead><tr><th>{t(['项目','Project'],locale)}</th><th>{t(['适合谁','Who it is for'],locale)}</th><th>{t(['最后得到什么','Expected result'],locale)}</th></tr></thead><tbody>{projects.map(p=><tr><th><a href={url(locale,`projects/${p.id}`)}>{t(p.title,locale)}</a></th><td>{t(p.audience,locale)}</td><td>{t(p.result,locale)}</td></tr>)}</tbody></table></div></section>

<style>.selection-start{margin:24px 0;border-block:1px solid #dce7eb}.selection-start summary{font-size:16px;font-weight:600;padding-left:0}.selection-start p,.selection-start li{font-size:15px;line-height:1.85;color:#53687e}</style>
